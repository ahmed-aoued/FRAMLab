    }
    private void addHOT(string HOT)
    {
        var isFirst = false;
        foreach (var ID in stateContainer.selectedMulti)
        {
            var function = stateContainer.functionList.Find(x => x.IDNr == ID);
            if (function is not null)
            {
                addHOT2(function, HOT);
            }
        }
        foreach (var fn in stateContainer.functionList.FindAll(x => !x.metadata.Exists(y => y[0] == "Function_Type")))
        {
            addHOT2(fn, "");
            isFirst = true;
        }
        if (isFirst)
        {
            var setDisplay = "Effectiveness";
            for (var i = 1; i <= 6; i++)
            {
                stateContainer.initialDisplaySetup($"colour_{i}0", "0", (i < 3));
                stateContainer.initialDisplaySetup($"colour_{i}1", "", (i < 3));
                stateContainer.initialDisplaySetup($"colour_{i}2", "0.5", (i < 3));
                stateContainer.initialDisplaySetup($"colour_{i}3", "", (i < 3));
                stateContainer.initialDisplaySetup($"colour_{i}4", "1", (i < 3));
                stateContainer.initialDisplaySetup($"tracer_{i}", setDisplay, true);
                stateContainer.initialDisplaySetup($"c_{i}0_value", "#FF8D0A", (i < 3));
                stateContainer.initialDisplaySetup($"c_{i}2_value", "#FCFF33", (i < 3));
                stateContainer.initialDisplaySetup($"c_{i}4_value", "#2A8DEA", (i < 3));
                stateContainer.checkDisplayValues(i.ToString());
                if (i == 1) { setDisplay = "Tolerability"; } else { setDisplay = ""; }
            }
        }
    }
    private void addHOT2(Function function, string HOT)
    {
        //metadata: [0]=key name, [1]=key value, [2]=active attribute, [3]=equation attribute, [4]=default value
        var getMeta = function.metadata;
        var isBG = (function.isInput == "false");
        if (getMeta is not null)
        {
            addPKeys("Function_Type", HOT);
            switch (HOT)
            {
                case "":
                    {
                        addPKeys("Effectiveness", "0.99", "", ""); 
                        addPKeys("Tolerability", "0.75", "", "");
                        addPKeys("Activate", "1", isBG ? "" : "true", isBG ? "" : "Amin_Effectiveness>=Tolerability?1:0");
                        addPKeys("Variable", "", isBG ? "" : "true", isBG ? "" : "Effectiveness<0.99?1:0");
                        break;
                    }
                case "Human":
                    {
                        addPKeys("Effectiveness", "0.99", "", "");
                        addPKeys("Tolerability", "0.75", "", "");
                        addPKeys("Activate", "1", isBG ? "" : "true", isBG ? "" : "Amin_Effectiveness>=Tolerability?1:0");
                        addPKeys("Variable", "", isBG ? "" : "true", isBG ? "" : "Effectiveness<0.99?1:0");
                        break;
                    }
                case "Organisational":
                    {
                        addPKeys("Effectiveness", "0.99", "", "");
                        addPKeys("Tolerability", "0.7", "", "");
                        addPKeys("Activate", "1", isBG ? "" : "true", isBG ? "" : "Amin_Effectiveness>=Tolerability?1:0");
                        addPKeys("Variable", "", isBG ? "" : "true", isBG ? "" : "Effectiveness<0.99?1:0");
                        break;  
                    }
                case "Technological":
                    {
                        addPKeys("Effectiveness", "0.99999", "", "");
                        addPKeys("Tolerability", "0.99", "", "");
                        addPKeys("Activate", "1", isBG ? "" : "true", isBG ? "" : "Amin_Effectiveness>=Tolerability?1:0");
                        addPKeys("Variable", "", isBG ? "" : "true", isBG ? "" : "Effectiveness<0.99?1:0");
                        break;
                    }
                case "AI":
                    {
                        addPKeys("Effectiveness", "0.9999", "", "");
                        addPKeys("Tolerability", "0.9", "", "");
                        addPKeys("Activate", "1", isBG ? "" : "true", isBG ? "" : "Amin_Effectiveness>=Tolerability?1:0");
                        addPKeys("Variable", "", isBG ? "" : "true", isBG ? "" : "Effectiveness<0.99?1:0");
