    private void bFMI_reset()
    {
        isPlaying = false;
        stateContainer.selectedFn = "-1";
        stateContainer.selectedLabel = "";
        stateContainer.cycleFMI = -1;
        stateContainer.fmiMessage = "";
        foreach (var fn in stateContainer.functionList)
        {
            fn.resetAspects();
            fn.resetVariables();
            fn.resetKvalues();
            fn.toolTip = "";
            foreach (string[] mdKey in fn.metadata) //[0]=key name, [1]=key value, [2]=active attribute, [3]=equation attribute
            {
                if (mdKey[1].Length > 0) //metadata key has a value
                {
                    mdKey[1] = mdKey[4]; //return to initial value
                    var fnMD = stateContainer.metadataDS.Tables["Metadata"]!.Select($"IDNr = {fn.IDNr} and Cycle = -1")[0];
                    if (fnMD is not null && fnMD[mdKey[0]] is not null)
                    {
                        fnMD[mdKey[0]] = mdKey[1];
                    }
                    if (mdKey[0] == "Variable" && (fn.FunctionType == "0" || fn.FunctionType == "1"))
                    {
                        if (mdKey[1] == "1" || mdKey[1] == "true")
                        {
                            fn.FunctionType = "1";
                            stateContainer.projectData_Undo[0].SelectSingleNode($"//FM/Functions/Function[IDNr={fn.IDNr}]/FunctionType")!.InnerText = "1";
                        }
                        else
                        {
                            fn.FunctionType = "0";
                            stateContainer.projectData_Undo[0].SelectSingleNode($"//FM/Functions/Function[IDNr={fn.IDNr}]/FunctionType")!.InnerText = "0";
                        }
                    }
                }
            }
        }
        foreach (var coupling in stateContainer.couplingList)
        {
            coupling.activated = false;
            coupling.wasActive = false;
            coupling.fmiHighlight = "";
        }
        if (stateContainer.metadataDS.Tables.Contains("Metadata"))
        {
            foreach (var row in stateContainer.metadataDS.Tables["Metadata"]!.Select("Cycle > -1"))
            {
                stateContainer.metadataDS.Tables["Metadata"]!.Rows.Remove(row);
            }
        }
        refreshParent.InvokeAsync();
    }
    private void bFMI_start()
    {
        if (isPlaying)
        {
            isPlaying = false;
        }
        else
        {
            isPlaying = true;
            bFMI_play();
        }
    }
    private string checkForPlay()
    {
        if (isPlaying)
        {
            return "btn btn-FMIp oi oi-media-stop";
        }
        else
        {
            return "btn btn-FMIp oi oi-media-play";
        }
    }
    private async void bFMI_play()
    {
        var checkCycle = bFMI_cycle();
        if (checkCycle == "error" || checkCycle == "End")
        {
            isPlaying = false;
            if (checkCycle == "End")
            {
                foreach (var Exitfn in stateContainer.functionList.FindAll(x => x.fmiType == "Exit" && !trackExitFunctions.Contains(x.IDNr)))
                {
                    trackExitFunctions.Add(Exitfn.IDNr);
                    Exitfn.fmiHighlight = "exit-fill";
                }
            }
        }
        await refreshParent.InvokeAsync();
        //Console.WriteLine($"cycleDelay: {stateContainer.cycleDelay}");
        await Task.Delay(stateContainer.cycleDelay + 1);
        bFMI_cycle_Couplings();
        await refreshParent.InvokeAsync();
        if (isPlaying)
        {
            await Task.Delay(stateContainer.cycleDelay + 1);
            bFMI_play();
        }
    }
    private async void bFMI_step()
    {
        if (isPlaying)
        {
            isPlaying = false;
            return;
        }
        var checkCycle = bFMI_cycle();
        bFMI_cycle_Couplings();
        await refreshParent.InvokeAsync();
        if (checkCycle == "End")
        {
            foreach (var Exitfn in stateContainer.functionList.FindAll(x => x.fmiType == "Exit" && !trackExitFunctions.Contains(x.IDNr)))
            {
                trackExitFunctions.Add(Exitfn.IDNr);
                Exitfn.fmiHighlight = "exit-fill";
            }
        }
    }
    private void bFMI_cycle_Couplings()
    {
        foreach (var coupling in activeAspectsArray)
        {
            coupling.activated = true;
            coupling.fmiHighlight = "entry-fill";
            coupling.wasActive = true;
            var nextFn = stateContainer.functionList.Find(x => x.IDNr == coupling.toFn);
            if (nextFn is not null)
            {
                switch (coupling.toType)
                {
                    case "I": if (!nextFn.activeI.Contains(coupling.Name)) nextFn.activeI.Add(coupling.Name); break;
                    case "P": if (!nextFn.activeP.Contains(coupling.Name)) nextFn.activeP.Add(coupling.Name); break;
                    case "R": if (!nextFn.activeR.Contains(coupling.Name)) nextFn.activeR.Add(coupling.Name); break;
                    case "C": if (!nextFn.activeC.Contains(coupling.Name)) nextFn.activeC.Add(coupling.Name); break;
                    case "T": if (!nextFn.activeT.Contains(coupling.Name)) nextFn.activeT.Add(coupling.Name); break;
                }
                var outputFn = stateContainer.functionList.Find(x => x.IDNr == coupling.outputFn);
                if (outputFn is not null)
                {
                    foreach (var meta in outputFn.metadata)
                    {
                        nextFn.newVariable($"{coupling.toType}{coupling.outputFn}_{meta[0]}", new string[] { meta[1], meta[1] });
                    }
                }
            }
        }
    }
    private string bFMI_cycle() //private async Task<string> bFMI_cycle()
    {
        stateContainer.cycleFMI += 1;
        var returnString = "error";
        var check1 = 0;
        var fmiError = false;
        trackHighlights = 0;
        toActivateAspectsArray = new List<Coupling>();
        foreach (var pCoupling in stateContainer.couplingList) //.FindAll(x => x.activated == true))
        {
            pCoupling.activated = false;
            if (stateContainer.cycleFMI == 0)
            {
                pCoupling.wasActive = false;
                pCoupling.fmiHighlight = "";
                if (pCoupling.outputFn != pCoupling.toFn)
                {
                    var getFn = stateContainer.functionList.Find(x => x.IDNr == pCoupling.toFn);
                    if (getFn is not null)
                    {
                        switch (pCoupling.toType)
                        {
                            case "I": getFn.totalI.Add(pCoupling.Name); break;
                            case "P": getFn.totalP.Add(pCoupling.Name); break;
                            case "R": getFn.totalR.Add(pCoupling.Name); break;
                            case "C": getFn.totalC.Add(pCoupling.Name); break;
                            case "T": getFn.totalT.Add(pCoupling.Name); break;
                        }
                    }
                }
            }
        }
        if (stateContainer.cycleFMI == 0)
        {
            stateContainer.fmiMessage = $"FRAM Model Interpreter - FMI Basic  -----  (c) Erik Hollnagel, 2020\nFMI session log: {DateTime.Now.ToString()}\n\n";
            activeAspectsArray = new List<Coupling>();
            trackExitFunctions = new List<string>();
            //This loop checks for Orphans and then for functions that have Aspects but not an Input or Output
            //(Can't be a Background Function if it has other Aspects)
            foreach (var fnO in stateContainer.functionList)
            {
                if (fnO.orphans > 0)
                {
                    stateContainer.fmiMessage += $"WARNING: <{fnO.IDName}> has an orphan\n";
                    fnO.fmiHighlight = "exit-fill";
                    fmiError = true;
                }
                //number of other Aspects (not Input or Output)
                check1 = stateContainer.aspectsList.FindAll(x => x.FunctionIDNr == fnO.IDNr && x.Type != "Input").Count;
                if (check1 > 0)
                {
                    if (stateContainer.aspectsList.FindAll(x => x.FunctionIDNr == fnO.IDNr && x.Type == "Input").Count == 0)
                    {
                        stateContainer.fmiMessage += $"WARNING: <{fnO.IDName}> does not have any Inputs\n";
                        fnO.fmiHighlight = "exit-fill";
                        fmiError = true;
                    }
                    if (stateContainer.outputsList.FindAll(x => x.FunctionIDNr == fnO.IDNr && x.Type == "Output").Count == 0)
                    {
                        stateContainer.fmiMessage += $"WARNING: <{fnO.IDName}> does not have any Outputs\n";
                        fnO.fmiHighlight = "exit-fill";
                        fmiError = true;
                    }
                }
            }
            if (fmiError)
            {
                stateContainer.showFMIPopup = true;
                return returnString;
            }
            //If the previous loop passes, then this loop starts the initialisation
            var IProfile = "";
            var IProfileExit = "";
            var ICycle0 = "BEGIN CYCLE 0\n";
            foreach (var fnBG in stateContainer.functionList)
            {
                fnBG.wasActive = false;
                fnBG.fmiHighlight = "";
                check1 = 0; //number of other Aspects (not Input or Output)
                check1 = stateContainer.aspectsList.FindAll(x => x.FunctionIDNr == fnBG.IDNr && x.Type != "Input").Count;
                var check2 = 0; //total number of outputs
                var check3 = 0; //total number of Inputs
                var checkOtoI = 0; //number of Outputs going to other function Inputs
                var checkOtoA = 0; //number of Outputs going to other function Aspects (other than Input)
                foreach (var hasOutput in stateContainer.outputsList.FindAll(x => x.FunctionIDNr == fnBG.IDNr && x.Type == "Output"))
                {
                    check2 += 1;
                    checkOtoI += stateContainer.aspectsList.FindAll(x => x.IDName == hasOutput.IDName && x.Type == "Input").Count;
                    checkOtoA += stateContainer.aspectsList.FindAll(x => x.IDName == hasOutput.IDName && x.Type != "Input").Count;
                }
                check3 = stateContainer.aspectsList.FindAll(x => x.FunctionIDNr == fnBG.IDNr && x.Type == "Input").Count;
                if (check1 == 0)
                { //has only inputs or outputs (no other Aspects)
                    if (check3 == 0 && checkOtoI > 0) //is Entry function (has no Input and has at least 1 Output going to other function Input)
                    {
                        fnBG.fmiType = "Entry";
                        //if (fnBG.profileFn == "") fnBG.profileFn = "0"; // changed, blank FMI Profile is ok, will default
                        stateContainer.fmiMessage += $"Entry function <{fnBG.IDName}>\n";
                        ICycle0 += $"Entry function <{fnBG.IDName}> has been activated\n";
                        // if (enableTheLab)
                        evaluate(fnBG);
                        activateFunction(fnBG);
                        IProfile = $"Function <{fnBG.IDName}>:\n    Output: {(fnBG.profileFn == "" ? "0" : fnBG.profileFn)}\n{IProfile}";
                    }
                    else if (check2 == 0 && check3 > 0) //is Exit function
                    {
                        fnBG.fmiType = "Exit";
                        stateContainer.fmiMessage += $"Exit function <{fnBG.IDName}>\n";
                        fnBG.fmiHighlight = "exit-fill";
                        trackHighlights += 1;
                        trackExitFunctions.Add(fnBG.IDNr);
                        IProfileExit += $"Function <{fnBG.IDName}>:\n    Input: {(fnBG.profileI == "" ? "All" : fnBG.profileI)}{"        ".Substring(0, 8 - 3)}\n";
                    }
                    else if (check2 == 0 || check3 == 0)
                    { //other Background functions (not Entry or Exit)
                        fnBG.fmiType = "Background";
                        ICycle0 += $"Background function <{fnBG.IDName}> has been activated\n";
                        //if (enableTheLab)
                        evaluate(fnBG);
                        activateFunction(fnBG);
                    }
                    else
                    { //else Passthrough function (Input and Output but no other Aspects)
                        fnBG.fmiType = "Passthrough";
                        IProfile += $"Function <{fnBG.IDName}>:";
                        IProfile += $"\n    Input: {(fnBG.profileI == "" ? "All" : fnBG.profileI)}{"        ".Substring(0, 8 - 3)}";
                        IProfile += $"Precondition: {(fnBG.profileP == "" ? "All" : fnBG.profileP)}{"        ".Substring(0, 8 - (fnBG.profileP.Length == 0 ? 3 : fnBG.profileP.Length))}";
                        IProfile += $"Resource: {(fnBG.profileR == "" ? "All" : fnBG.profileR)}{"        ".Substring(0, 8 - (fnBG.profileR.Length == 0 ? 3 : fnBG.profileR.Length))}";
                        IProfile += $"Control: {(fnBG.profileC == "" ? "All" : fnBG.profileC)}{"        ".Substring(0, 8 - (fnBG.profileC.Length == 0 ? 3 : fnBG.profileC.Length))}";
                        IProfile += $"Time: {(fnBG.profileT == "" ? "All" : fnBG.profileT)}{"        ".Substring(0, 8 - (fnBG.profileT.Length == 0 ? 3 : fnBG.profileT.Length))}\n";
                    }
                }
                else
                {
                    fnBG.fmiType = "Foreground";
                    IProfile += $"Function <{fnBG.IDName}>:";
                    IProfile += $"\n    Input: {(fnBG.profileI == "" ? "All" : fnBG.profileI)}{"        ".Substring(0, 8 - 3)}";
                    IProfile += $"Precondition: {(fnBG.profileP == "" ? "All" : fnBG.profileP)}{"        ".Substring(0, 8 - (fnBG.profileP.Length == 0 ? 3 : fnBG.profileP.Length))}";
                    IProfile += $"Resource: {(fnBG.profileR == "" ? "All" : fnBG.profileR)}{"        ".Substring(0, 8 - (fnBG.profileR.Length == 0 ? 3 : fnBG.profileR.Length))}";
                    IProfile += $"Control: {(fnBG.profileC == "" ? "All" : fnBG.profileC)}{"        ".Substring(0, 8 - (fnBG.profileC.Length == 0 ? 3 : fnBG.profileC.Length))}";
                    IProfile += $"Time: {(fnBG.profileT == "" ? "All" : fnBG.profileT)}{"        ".Substring(0, 8 - (fnBG.profileT.Length == 0 ? 3 : fnBG.profileT.Length))}\n";
                }
            }
            stateContainer.fmiMessage += $"\nInterpretation Profile\n{IProfile}{IProfileExit}\nSummary of FMIlog\nBegin initialisation\n";
            stateContainer.fmiMessage += "---  MODEL INITIALISATION COMPLETED.\n";
            stateContainer.fmiMessage += ICycle0;
            returnString = "0";
        }
        else if (stateContainer.cycleFMI > 0)
        {
            stateContainer.fmiMessage += $"BEGIN CYCLE {stateContainer.cycleFMI.ToString()}\n";
            foreach (var fnBG2 in stateContainer.functionList.FindAll(x => x.fmiType != "Background"))
            {
                if (fnBG2.fmiType == "Entry")
                {
                    //CYCLE TEST
                    double checkProfileFn = 0;
                    double.TryParse(fnBG2.profileFn, CultureInfo.InvariantCulture, out checkProfileFn);
                    if (checkProfileFn > 0)
                    {
                        var cycleFn = false;
                        if (checkProfileFn >= 1)
                        {
                            double checkCycle = (double)stateContainer.cycleFMI / checkProfileFn;
                            if (checkCycle == (int)checkCycle)
                            {
                                cycleFn = true;
                            }
                        }
                        else
                        {
                            if (rnd.NextDouble() < checkProfileFn)
                            {
                                cycleFn = true;
                            }
                        }
                        if (cycleFn)
                        {
                            //if (enableTheLab)
                            evaluate(fnBG2);
                            if (activateFunction(fnBG2))
                            {
                                stateContainer.fmiMessage += $"Entry Function <{fnBG2.IDName}> has been activated\n";
                            }
                            foreach (var fnBGb in stateContainer.functionList.FindAll(x => x.fmiType == "Background"))
                            {
                                evaluate(fnBGb);
                                activateFunction(fnBGb);
                            }
                        }
                        else
                        {
                            fnBG2.fmiHighlight = "";
                        }
                    }
                    else
                    {
                        fnBG2.fmiHighlight = "";
                    }
                    //CYCLE TEST
                }
                else //all other Functions that are not Entry and not Background (Exit not excluded)
                {
                    if (fnBG2.isActive())
                    {
                        //if (enableTheLab)
                        evaluate(fnBG2);
                        var canActivate2 = true;
                        var activateAll2 = true;
                        var activateOnly = "";
                        var fnMD2 = fnBG2.metadata.Find(x => x[0] == "Activate");
                        if (fnMD2 is not null)
                        {
                            if (fnMD2[1] == "0" || fnMD2[1] == "false")
                            {
                                canActivate2 = false;
                            }
                            if (fnMD2[1] != "1" && fnMD2[1] != "true")
                            {
                                activateAll2 = false;
                                activateOnly = fnMD2[1];
                            }
                        }
                        var fnMDv2 = fnBG2.metadata.Find(x => x[0] == "Variable");
                        if (fnMDv2 is not null && fnBG2.FunctionType != "2")
                        {
                            stateContainer.updateUndo();
                            if (fnMDv2[1] == "1" || fnMDv2[1] == "true")
                            {
                                fnBG2.FunctionType = "1";
                                stateContainer.projectData_Undo[0].SelectSingleNode($"//FM/Functions/Function[IDNr={fnBG2.IDNr}]/FunctionType")!.InnerText = "1";
                            }
                            else
                            {
                                fnBG2.FunctionType = "0";
                                stateContainer.projectData_Undo[0].SelectSingleNode($"//FM/Functions/Function[IDNr={fnBG2.IDNr}]/FunctionType")!.InnerText = "0";
                            }
                        }
                        if (canActivate2)
                        {
                            fnBG2.wasActive = true;
                            //check group
                            if (fnBG2.fmiType != "Exit")
                            {
                                fnBG2.fmiHighlight = "entry-fill";
                                trackHighlights += 1;
                                stateContainer.fmiMessage += $"Function <{fnBG2.IDName}> has been activated\n";
                            }
                            else
                            {
                                fnBG2.fmiHighlight = "exit-fill";
                                trackHighlights += 1;
                                trackExitFunctions.Remove(fnBG2.IDNr);
                                stateContainer.fmiMessage += $"Exit function <{fnBG2.IDName}> has been activated\n";
                            }
                            foreach (var coupling in stateContainer.couplingList.FindAll(x => x.toFn == fnBG2.IDNr && !x.activated))
                            {//This is about clearing the Aspects that were consumed, but not if also part of repeating cycle
                                if (stateContainer.functionList.Find(x => x.IDNr == coupling.outputFn)?.fmiType != "Background")
                                {
                                    switch (coupling.toType)
                                    {
                                        case "I": fnBG2.activeI.Remove(coupling.Name); break;
                                        case "P": fnBG2.activeP.Remove(coupling.Name); break;
                                        case "R": fnBG2.activeR.Remove(coupling.Name); break;
                                        case "C": fnBG2.activeC.Remove(coupling.Name); break;
                                        case "T": fnBG2.activeT.Remove(coupling.Name); break;
                                    }
                                    activeAspectsArray.Remove(coupling);
                                    //Console.WriteLine("=====================");
                                    //Console.WriteLine($"Coupling: {coupling.Name}, {coupling.toType}{coupling.outputFn}_");
                                    //Console.WriteLine($"Function: {fnBG2.IDNr}, {fnBG2.IDName}");
                                    //Console.WriteLine("=====================");
                                    fnBG2.removeVariable($"{coupling.toType}{coupling.outputFn}_");
                                }
                                coupling.fmiHighlight = "";
                            }
                            foreach (var coupling in stateContainer.couplingList.FindAll(x => x.outputFn == fnBG2.IDNr && x.outputFn != x.toFn && (activateAll2 || activateOnly.Contains(x.label))))
                            { //This activates the Outputs of the current Function
                                if (!toActivateAspectsArray.Contains(coupling))
                                {
                                    toActivateAspectsArray.Add(coupling);
                                }
                            }
                        }
                        else
                        {
                            fnBG2.fmiHighlight = "hold-fill";
                        }
                    }
                    else
                    {
                        //if (fnBG2.fmiType != "Exit" || trackExitFunctions.Count > 0)
                        //{
                        //check for group?
                        fnBG2.fmiHighlight = "";
                        //}
                    }
                }
            }
            returnString = stateContainer.cycleFMI.ToString();
            if (stepTOTAL == null)
            {
                if (trackExitFunctions.Count == 0)
                {
                    //bFMI.enabled = false;
                    //stateContainer.fmiMessage += "\nEnd";
                    returnString = "End";
                }
            }
            else if (stepTOTAL.HasValue && stepTOTAL != 0 && stepTOTAL <= stateContainer.cycleFMI)
            {
                //bFMI.enabled = false;
                //stateContainer.fmiMessage += "\nEnd";
                returnString = "End";
            }
        }
        activeAspectsArray.AddRange(toActivateAspectsArray);
        if (trackHighlights == 0)
        {
            stateContainer.fmiMessage += "No functions were activated during this cycle.\n";
            if (!stepTOTAL.HasValue)
            {
                //bFMI.enabled = false;
                //stateContainer.fmiMessage += "\nEnd";
                returnString = "End";
            }
        }
        return returnString;
    }
    private bool activateFunction(Function fnBG)
    {
        var canActivate = true;
        var activateAll = true;
        var fnMD = fnBG.metadata.Find(x => x[0] == "Activate");
        if (fnMD is not null)
        {
            if (fnMD[1] == "0" || fnMD[1] == "false")
            {
                canActivate = false;
            }
            if (fnMD[1] != "1" && fnMD[1] != "true")
            {
                activateAll = false;
            }
        }
        if (canActivate)
        {
            fnBG.wasActive = true;
            trackHighlights += 1;
            fnBG.fmiHighlight = $"{fnBG.fmiType.ToLower()}-fill";
            if (fnBG.fmiType == "Entry")
            {
                foreach (var coupling in stateContainer.couplingList.FindAll(x => x.outputFn == fnBG.IDNr && (activateAll || fnMD![1].Contains(x.label))))
                {
                    if (!toActivateAspectsArray.Contains(coupling))
                    {
                        toActivateAspectsArray.Add(coupling);
                    }
                }
            }
            else if (fnBG.fmiType == "Background") // && stateContainer.cycleFMI == 0)
            {
                foreach (var coupling in stateContainer.couplingList.FindAll(x => x.outputFn == fnBG.IDNr && (activateAll || fnMD![1].Contains(x.label))))
                {
                    coupling.wasActive = true;
                    coupling.activated = true;
                    coupling.fmiHighlight = "background-fill";
                    var nextFn = stateContainer.functionList.Find(x => x.IDNr == coupling.toFn);
                    if (nextFn is not null)
                    {
                        switch (coupling.toType)
                        {
                            case "I": nextFn.activeI.Add(coupling.Name); break;
                            case "P": nextFn.activeP.Add(coupling.Name); break;
                            case "R": nextFn.activeR.Add(coupling.Name); break;
                            case "C": nextFn.activeC.Add(coupling.Name); break;
                            case "T": nextFn.activeT.Add(coupling.Name); break;
                        }
                        var outputFn = stateContainer.functionList.Find(x => x.IDNr == coupling.outputFn);
                        if (outputFn is not null)
                        {
                            foreach (var meta in outputFn.metadata)
                            {
                                nextFn.newVariable($"{coupling.toType}{coupling.outputFn}_{meta[0]}", new string[] { meta[1], meta[1] });
                            }
                        }
                    }
                }
            }
        }
        else
        {
            fnBG.fmiHighlight = "hold-fill";
        }
        return canActivate;
    }
    private void evaluate(Function iBG) //private async Task evaluate(Function iBG)
    {
        var showVariability = false;
        calcVariables(iBG); //calculate the new variable values for the given function
        if (iBG.metadata is not null)
        {
            foreach (string[] md3Key in iBG.metadata) //[0]=key name, [1]=key value, [2]=active attribute, [3]=equation attribute
            {
                if (md3Key[1].Length > 0 || md3Key[3].Length > 0) //metadata key has a value or has an equation
                {
                    if (md3Key[2] == "true") //it has an equation
                    {
                        if (md3Key[0].StartsWith("Global_"))
                        {
                            iBG.newVariable(md3Key[0], new string[] { stateContainer.metaDataKeys[md3Key[0]], stateContainer.metaDataKeys[md3Key[0]] });
                        }
                        else
                        {
                            iBG.newVariable(md3Key[0], new string[] { md3Key[1], md3Key[1] }); //if equation, update variable before, and again after, the eval
                            stateContainer.metaDataKeys[md3Key[0]] = md3Key[1];
                        }
                        //=======================================
                        //This is an option to run custom code on a Function. The code is written in the Function.cs component. An example is 'returnTrue'
                        if (md3Key[3].StartsWith("execute("))
                        {
                            var codeName = md3Key[3].Replace("execute(", "").Replace(")", "");
                            var method = iBG.GetType().GetMethod(codeName);
                            if (method is not null)
                            {
                                md3Key[1] = method.Invoke(iBG, new object[] { md3Key[0] })?.ToString() ?? "STOP";
                            }
                        }
                        //=======================================
                        //This is an option to call an external API
                        // if (md3Key[3].StartsWith("api(")) //check for api use here, otherwise pass to equation eval function
                        // {
                        //     var apiExpression = md3Key[3].Replace("api(", "").Replace(")", "").Replace("\"", "").Split(",", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                        //     var jsonContent = "";
                        //     var varCount = apiExpression.Length;
                        //     var varParameters = $"?fnName={iBG.IDName}&keyName={md3Key[0]}";
                        //     if (varCount > 1) //if more than one parameter in api() call, then build a query string, otherwise add all variables and data to the body content
                        //     {
                        //         for (var i = 1; i < varCount; i++)
                        //         {
                        //             varParameters += $"&{apiExpression[i]}={iBG.getVariable(apiExpression[i])?[0]??""}";
                        //         }
                        //         jsonContent = "";
                        //     }
                        //     else
                        //     {
                        //         jsonContent = JsonSerializer.Serialize(iBG.getVariables());
                        //     }
                        //     //Console.WriteLine(apiExpression[0]);
                        //     var requestUrl = new Uri($"{apiExpression[0]}{varParameters}");
                        //     var requestMessage = new HttpRequestMessage(HttpMethod.Post, requestUrl);
                        //     requestMessage.Content = new StringContent(jsonContent);

                        //     var reply = await Http.SendAsync(requestMessage);
                        //     if (reply.StatusCode == HttpStatusCode.OK)
                        //     {
                        //         md3Key[1] = await reply.Content.ReadAsStringAsync();
                        //     } else
                        //     {
                        //         md3Key[1] = reply?.ReasonPhrase??"NaN";
                        //     }
                        //     //Console.WriteLine(reply);
                        //     //Console.WriteLine(md3Key[1]);
                        // }
                        //=======================================
                        else
                        {
                            md3Key[1] = eval(md3Key[3], iBG.getVariables());
                        }
                    }
                    iBG.newVariable(md3Key[0], new string[] { md3Key[1], md3Key[1] });
                    stateContainer.metaDataKeys[md3Key[0]] = md3Key[1];

                    var fnMD = stateContainer.metadataDS.Tables["Metadata"]!.Select($"IDNr = {iBG.IDNr} and Cycle = -1")[0];
                    if (fnMD is not null && fnMD[md3Key[0]] is not null)
                    {
                        fnMD[md3Key[0]] = md3Key[1];
                    }
                    for (var i = 1; i <= 6; i++)
                    {
                        if (stateContainer.displaySetup.ContainsKey($"tracer_{i}") && md3Key[0] == stateContainer.displaySetup[$"tracer_{i}"])
                        {
                            stateContainer.updateKvalue(iBG, $"K{i}", md3Key[1]);
                            showVariability = true;
                        }
                    }
                }
            }
        }
        //showVariability = true;
        if (showVariability && (iBG.FunctionType != "2" || iBG.fmiType == "Exit")) //ignore Background but do include Exit functions
        {
            checkVariability_DrawResults(iBG);
        }
        stateContainer.addMetadataResults(iBG); //this adds a new row to the Metadata table for the results of the evaluated Function (for the current Cycle)
    }
    private void checkVariability_DrawResults(Function iBG)
    {
        iBG.toolTip = "";
        iBG.Cvalues = new Dictionary<string, string>();
        for (var i = 1; i <= 6; i++)
        {
            if (stateContainer.displaySetup[$"tracer_{i}"].Length > 0 && iBG.Kvalues.ContainsKey($"K{i}"))
            {
                iBG.toolTip += $"{stateContainer.displaySetup[$"tracer_{i}"]} = {iBG.Kvalues[$"K{i}"]}\n";
                double d_t0 = stateContainer.displayValue[$"colour_{i}0"];
                double d_t1 = stateContainer.displayValue[$"colour_{i}1"];
                double d_t2 = stateContainer.displayValue[$"colour_{i}2"];
                double d_t3 = stateContainer.displayValue[$"colour_{i}3"];
                double d_t4 = stateContainer.displayValue[$"colour_{i}4"];
                // Console.WriteLine($"d_t0: {d_t0}");
                // Console.WriteLine($"d_t1: {d_t1}");
                // Console.WriteLine($"d_t2: {d_t2}");
                // Console.WriteLine($"d_t3: {d_t3}");
                // Console.WriteLine($"d_t4: {d_t4}");
                // Console.WriteLine($"K{i}: {iBG.Kvalues[$"K{i}"]}");
                if (d_t1 is not double.NaN && iBG.Kvalues[$"K{i}"] <= d_t1)
                {
                    //var d_t0 = stateContainer.displayValue[$"colour_{i}0"];
                    iBG.Cvalues[$"{i}C_stroke"] = stateContainer.displaySetup[$"c_{i}0_value"];
                    iBG.Cvalues[$"{i}C_opacity"] = (0.75 - (iBG.Kvalues[$"K{i}"] - d_t0) * 0.25 / (d_t1 - d_t0)).ToString("0.##", CultureInfo.InvariantCulture);
                    iBG.Cvalues[$"{i}Y_stroke"] = stateContainer.displaySetup[$"c_{i}2_value"];
                    iBG.Cvalues[$"{i}Y_opacity"] = ((iBG.Kvalues[$"K{i}"] - d_t0) * 0.5 / (d_t1 - d_t0)).ToString("0.##", CultureInfo.InvariantCulture);
                }
                else if (d_t2 is not double.NaN && iBG.Kvalues[$"K{i}"] <= d_t2)
                {
                    iBG.Cvalues[$"{i}C_stroke"] = stateContainer.displaySetup[$"c_{i}0_value"];
                    iBG.Cvalues[$"{i}C_opacity"] = (0.5 - (iBG.Kvalues[$"K{i}"] - d_t1) * 0.5 / (d_t2 - d_t1)).ToString("0.##", CultureInfo.InvariantCulture);
                    iBG.Cvalues[$"{i}Y_stroke"] = stateContainer.displaySetup[$"c_{i}2_value"];
                    iBG.Cvalues[$"{i}Y_opacity"] = (0.5 + (iBG.Kvalues[$"K{i}"] - d_t1) * 0.25 / (d_t2 - d_t1)).ToString("0.##", CultureInfo.InvariantCulture);
                }
                else if (d_t3 is not double.NaN && iBG.Kvalues[$"K{i}"] <= d_t3)
                {
                    iBG.Cvalues[$"{i}Y_stroke"] = stateContainer.displaySetup[$"c_{i}2_value"];
                    iBG.Cvalues[$"{i}Y_opacity"] = (0.75 - (iBG.Kvalues[$"K{i}"] - d_t2) * 0.25 / (d_t3 - d_t2)).ToString("0.##", CultureInfo.InvariantCulture);
                    iBG.Cvalues[$"{i}M_stroke"] = stateContainer.displaySetup[$"c_{i}4_value"];
                    iBG.Cvalues[$"{i}M_opacity"] = ((iBG.Kvalues[$"K{i}"] - d_t2) * 0.5 / (d_t3 - d_t2)).ToString("0.##", CultureInfo.InvariantCulture);
                }
                else if (d_t4 is not double.NaN && iBG.Kvalues[$"K{i}"] <= d_t4)
                {
                    iBG.Cvalues[$"{i}Y_stroke"] = stateContainer.displaySetup[$"c_{i}2_value"];
                    iBG.Cvalues[$"{i}Y_opacity"] = (0.5 - (iBG.Kvalues[$"K{i}"] - d_t3) * 0.5 / (d_t4 - d_t3)).ToString("0.##", CultureInfo.InvariantCulture);
                    iBG.Cvalues[$"{i}M_stroke"] = stateContainer.displaySetup[$"c_{i}4_value"];
                    iBG.Cvalues[$"{i}M_opacity"] = (0.5 + (iBG.Kvalues[$"K{i}"] - d_t3) * 0.25 / (d_t4 - d_t3)).ToString("0.##", CultureInfo.InvariantCulture);
                }
                else
                {
                    iBG.Cvalues[$"{i}M_stroke"] = stateContainer.displaySetup[$"c_{i}4_value"];
                    iBG.Cvalues[$"{i}M_opacity"] = "0.75";
                }
            }
        }
