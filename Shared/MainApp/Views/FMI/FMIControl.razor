    private void setLastKey(FocusEventArgs e, string key)
    {
        stateContainer.lastKey = key;
    }
    private void bKey_MoveUp()
    {
        var getMeta = stateContainer.selectedFunction?.metadata;
        if (getMeta is not null && !String.IsNullOrEmpty(stateContainer.lastKey))
        {
            var indexA = getMeta.FindIndex(x => x[0] == stateContainer.lastKey);
            if (indexA > 0)
            {
                string[] tmp = getMeta[indexA];
                getMeta[indexA] = getMeta[indexA - 1];
                getMeta[indexA - 1] = tmp;
                stateContainer.metaIsDirty = true;
            }
            gotoKey = true;
        }
    }
    private void bKey_MoveDown()
    {
        var getMeta = stateContainer.selectedFunction?.metadata;
        if (getMeta is not null && !String.IsNullOrEmpty(stateContainer.lastKey))
        {
            var indexA = getMeta.FindIndex(x => x[0] == stateContainer.lastKey);
            if (indexA > -1 && indexA < getMeta.Count - 1)
            {
                string[] tmp = getMeta[indexA];
                getMeta[indexA] = getMeta[indexA + 1];
                getMeta[indexA + 1] = tmp;
                stateContainer.metaIsDirty = true;
            }
            gotoKey = true;
        }
    }
    private void eqCheckChange(ChangeEventArgs e, string keyName)
    {
        var getMeta = stateContainer.selectedFunction?.metadata;
        if (getMeta is not null)
        {
            var getKeyMeta = getMeta.Find(x => x[0] == keyName);
            if (getKeyMeta is not null)
            {
                getKeyMeta[2] = e.Value?.ToString()?.ToLower() ?? "";
                stateContainer.showVariables = "";
                stateContainer.metaIsDirty = true;
                var fnMD = stateContainer.metadataDS.Tables["Metadata"]!.Select($"IDNr = {stateContainer.selectedFn} and Cycle = -1")[0];
                if (fnMD is not null && fnMD[$"{keyName}-equation"] is not null)
                {
                    fnMD[$"{keyName}-equation"] = getKeyMeta[2];
                }
            }
        }
    }
