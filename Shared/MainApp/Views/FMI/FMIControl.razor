    private void bFMI_reset()
    {
        isPlaying = false;
        stateContainer.selectedFn = "-1";
        stateContainer.selectedLabel = "";
        stateContainer.cycleFMI = -1;
        stateContainer.fmiReset();
        stateContainer.Scripting?.Reset(); //clear Static + Global script stores for a fresh FMI run
        stateContainer.clearFmiLog();
        stateContainer.fmiUnknownVariables.Clear();
        Engine.Reset();
        foreach (var fn in stateContainer.functionList)
        {
            fn.resetAspects();
            fn.resetVariables();
            fn.resetKvalues(); 
            fn.toolTip = "";
            foreach (string[] mdKey in fn.metadata) //[0]=key name, [1]=key value, [2]=active attribute, [3]=equation attribute
            {
                if (mdKey[1].Length > 0) //metadata key has a value
                {
                    mdKey[1] = mdKey[4]; //return to initial value
                    var fnMD = stateContainer.metadataDS.Tables["Metadata"]!.Select($"IDNr = {fn.IDNr} and Cycle = -1")[0];
                    if (fnMD is not null && fnMD[mdKey[0]] is not null)
                    {
                        fnMD[mdKey[0]] = mdKey[1];
                    }
                    if (mdKey[0] == "Variable" && (fn.FunctionType == "0" || fn.FunctionType == "1"))
                    {
                        if (mdKey[1] == "1" || mdKey[1] == "true")
                        {
                            fn.FunctionType = "1";
                            stateContainer.setFunctionType(fn.IDNr, "1", fn);
                        }
                        else
                        {
                            fn.FunctionType = "0";
                            stateContainer.setFunctionType(fn.IDNr, "0", fn);
                        }
                    }
                }
            }
        }
        foreach (var coupling in stateContainer.couplingList)
        {
            coupling.activated = false;
            coupling.wasActive = false;
            coupling.fmiHighlight = "";
        }
        if (stateContainer.metadataDS.Tables.Contains("Metadata"))
        {
            foreach (var row in stateContainer.metadataDS.Tables["Metadata"]!.Select("Cycle > -1"))
            {
                stateContainer.metadataDS.Tables["Metadata"]!.Rows.Remove(row);
            }
        }
        refreshParent.InvokeAsync();
    }
    private void bFMI_start()
    {
        if (isPlaying)
        {
            isPlaying = false;
        }
        else
        {
            isPlaying = true;
            bFMI_play();
        }
    }
    private async void bFMI_play()
    {
        var checkCycle = await Engine.RunCycleAsync();
        if (checkCycle is FmiRunEngine.ResultError or FmiRunEngine.ResultEnd or FmiRunEngine.ResultBlocked)
        {
            isPlaying = false;
            HandleCycleResult(checkCycle);
        }
        await refreshParent.InvokeAsync();
        await Task.Delay(stateContainer.cycleDelay + 1);
        Engine.PropagateCouplings();
        await refreshParent.InvokeAsync();
        if (isPlaying)
        {
            await Task.Delay(stateContainer.cycleDelay + 1);
            bFMI_play();
        }
    }
    private async void bFMI_step()
    {
        if (isPlaying)
        {
            isPlaying = false;
            return;
        }
        var checkCycle = await Engine.RunCycleAsync();
        Engine.PropagateCouplings();
        HandleCycleResult(checkCycle);
        await refreshParent.InvokeAsync();
    }
    /// <summary>End of run: mark unreached Exit functions. Unknown variables: stop and ask the user.</summary>
    private void HandleCycleResult(string checkCycle)
    {
        if (checkCycle == FmiRunEngine.ResultEnd)
        {
            Engine.MarkPendingExits();
        }
        else if (checkCycle == FmiRunEngine.ResultBlocked)
        {
            stateContainer.fmiUnknownVariables = Engine.UnknownVariables.ToList();
            stateContainer.showFMIUnknownVariables = true;
        }
    }
