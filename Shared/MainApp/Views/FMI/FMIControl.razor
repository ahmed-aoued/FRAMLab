                                        fnBG2.activeI.Remove(coupling.Name);
                                        activeAspectsArray.Remove(coupling);
                                        fnBG2.removeVariable($"{coupling.toType}{coupling.outputFn}_");
                                        coupling.fmiHighlight = "";
                                    }
                                }
                            }
