@using MudBlazor
@using Microsoft.Extensions.Logging
@using FRAMLab.Shared.MainApp.Services.Logging
@inject IJSRuntime JSRuntime
@inject StateContainer stateContainer
@inject IStringLocalizer<Localization.SharedResource> Loc
@inject ILogger<FMIControl> Logger

@{ var usage = stateContainer.fmiUsage(); }
@if (Part == "run")
{
    @* Compact run controls for the app bar *@
    <div class="fmi-run-bar">
        <button type="button" class="fmi-icon-btn fmi-reset" title=@Loc["FMI_RESET"] @onclick=bFMI_reset><MudIcon Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Small" /></button>
        <button type="button" class="fmi-icon-btn" title=@Loc["FMI_STEP"] @onclick=bFMI_step><MudIcon Icon="@Icons.Material.Filled.SkipNext" Size="Size.Small" /></button>
        <button type="button" class="fmi-icon-btn fmi-icon-btn-primary" title=@(isPlaying ? L("FMI_STOP", "Stop") : Loc["FMI_PLAY"]) @onclick=bFMI_start>
            <MudIcon Icon="@(isPlaying ? Icons.Material.Filled.Stop : Icons.Material.Filled.PlayArrow)" Size="Size.Small" />
        </button>
        <label class="fmi-speed fmi-speed-compact" title=@Loc["FMI_DELAY"]>
            <MudIcon Icon="@Icons.Material.Outlined.Timer" Size="Size.Small" />
            <input id="fmiCycleDelay" name="fmiCycleDelay" type="range" @bind="stateContainer.cycleDelay" @bind:event="oninput" min="0" max="1500" step="250" />
            <span class="fmi-speed-value">@(((double)stateContainer.cycleDelay / 1000).ToString("0.0#s", CultureInfo.InvariantCulture))</span>
        </label>
        <span class="fmi-cycle-badge @(stateContainer.cycleFMI > -1 ? "" : "idle")" title="@L("CURRENT_CYCLE", "Current cycle")">@L("CYCLE", "Cycle") @(stateContainer.cycleFMI > -1 ? stateContainer.cycleFMI.ToString() : "–")</span>
        <span class="fmi-tool-sep"></span>
        <button type="button" class="fmi-icon-btn fmi-hl" title=@Loc["FMI_SHOW_ACTIVATED"] @onclick=bFMI_wasActive><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" /></button>
        <button type="button" class="fmi-icon-btn fmi-hl" title=@Loc["FMI_NOT_ACTIVATED"] @onclick=bFMI_notActive><MudIcon Icon="@Icons.Material.Outlined.Cancel" Size="Size.Small" /></button>
    </div>
}
else
{
<div class="fmi-panel">
    @if (Part == "all")
    {
    <div class="fmi-head">
        <span class="sb-title">@L("SIMULATION", "Simulation")</span>
        @if (stateContainer.cycleFMI > -1)
        {
            <span class="fmi-cycle-badge" title="@L("CURRENT_CYCLE", "Current cycle")">@L("CYCLE", "Cycle") @stateContainer.cycleFMI</span>
        }
    </div>
    <div class="fmi-run-row">
        <button type="button" class="fmi-icon-btn" title=@Loc["FMI_RESET"] tabindex="26" @onclick=bFMI_reset><MudIcon Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Small" /></button>
        <button type="button" class="fmi-icon-btn" title=@Loc["FMI_STEP"] tabindex="26" @onclick=bFMI_step><MudIcon Icon="@Icons.Material.Filled.SkipNext" Size="Size.Small" /></button>
        <button type="button" class="fmi-icon-btn fmi-icon-btn-primary" title=@(isPlaying ? L("FMI_STOP", "Stop") : Loc["FMI_PLAY"]) tabindex="26" @onclick=bFMI_start>
            <MudIcon Icon="@(isPlaying ? Icons.Material.Filled.Stop : Icons.Material.Filled.PlayArrow)" Size="Size.Small" />
        </button>
        <label class="fmi-speed" title=@Loc["FMI_DELAY"]>
            <MudIcon Icon="@Icons.Material.Outlined.Timer" Size="Size.Small" />
            <input id="fmiCycleDelay" name="fmiCycleDelay" type="range" tabindex="26" @bind="stateContainer.cycleDelay" @bind:event="oninput" min="0" max="1500" step="250" />
            <span class="fmi-speed-value">@(((double)stateContainer.cycleDelay / 1000).ToString("0.0#s", CultureInfo.InvariantCulture))</span>
        </label>
    </div>
    }
    @if (Part == "all" || Part == "model")
    {
    @* what the model uses besides plain equations; click to open FMI Setup *@
    <div class="fmi-chip-row">
        <button type="button" class="fmi-chip @(usage.UsesScripts ? "fmi-chip-st" : "")" title="Functions with an ST script" @onclick=bFMI_setup>ST @usage.ScriptFunctions.Count</button>
        <button type="button" class="fmi-chip @(usage.UsesMacros ? "fmi-chip-macro" : "")" title="Macros defined / functions calling them" @onclick=bFMI_setup>ƒ @usage.MacroCount/@usage.MacroCalls.Count</button>
        <button type="button" class="fmi-chip" title="Typed FMI variables" @onclick=bFMI_setup>Var @usage.DeclaredVariableCount</button>
        <button type="button" class="fmi-chip @(usage.DataSourceCount > 0 ? "fmi-chip-api" : "")" title="Live data sources / functions reading them" @onclick=bFMI_setup>API @usage.DataSourceCount/@usage.ApiCalls.Count</button>
        <label class="fmi-check" title="Equations may read last cycle's value of a key as Prev_Key">
            <input type="checkbox" checked="@stateContainer.fmiPrevVariables" @onchange="@((e) => stateContainer.fmiPrevVariables = (bool)(e.Value ?? false))" /> Prev_*
        </label>
    </div>
    }
    @if (Part == "model")
    {
    <div class="fmi-run-row">
        <label class="fmi-speed" title=@Loc["FMI_DELAY"]>
            <MudIcon Icon="@Icons.Material.Outlined.Timer" Size="Size.Small" />
            <input id="fmiCycleDelayModel" name="fmiCycleDelayModel" type="range" @bind="stateContainer.cycleDelay" @bind:event="oninput" min="0" max="1500" step="250" />
            <span class="fmi-speed-value">@(((double)stateContainer.cycleDelay / 1000).ToString("0.0#s", CultureInfo.InvariantCulture))</span>
        </label>
        <button type="button" class="fmi-icon-btn" title=@Loc["FMI_SHOW_ACTIVATED"] @onclick=bFMI_wasActive><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" /></button>
        <button type="button" class="fmi-icon-btn" title=@Loc["FMI_NOT_ACTIVATED"] @onclick=bFMI_notActive><MudIcon Icon="@Icons.Material.Outlined.Cancel" Size="Size.Small" /></button>
    </div>
    <div class="fmi-model-actions">
        <button type="button" class="sb-btn sb-btn-tonal" title="FMI Setup: variables, macros and data sources" @onclick=bFMI_setup><MudIcon Icon="@Icons.Material.Outlined.Build" Size="Size.Small" />FMI Setup</button>
        <button type="button" class="sb-btn sb-btn-tonal" title="Tracer colours and values shown on the canvas" @onclick=bFMI_results><MudIcon Icon="@Icons.Material.Outlined.Speed" Size="Size.Small" />@L("DISPLAY_SETUP", "Display")</button>
        <button type="button" class="sb-btn sb-btn-tonal" title=@Loc["FMI_SHOW_LOG"] @onclick=bFMI_showlog><MudIcon Icon="@Icons.Material.Outlined.Article" Size="Size.Small" />@Loc["FMI_SHOW_LOG"]</button>
        <span class="sb-btn sb-btn-tonal fmi-file-btn" title="Link a CSV file for lookup() and xref()">
            <InputFile id="fmiDataImportBtn" OnChange="bFMI_dataImport" single accept=".csv" />
            <MudIcon Icon="@Icons.Material.Outlined.TableView" Size="Size.Small" />@L("LINK_CSV", "Link CSV")
        </span>
    </div>
    }
    @if (Part == "all")
    {
    <div class="fmi-tool-row">
        <button type="button" class="fmi-icon-btn" title=@Loc["FMI_SHOW_ACTIVATED"] tabindex="26" @onclick=bFMI_wasActive><MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" /></button>
        <button type="button" class="fmi-icon-btn" title=@Loc["FMI_NOT_ACTIVATED"] tabindex="26" @onclick=bFMI_notActive><MudIcon Icon="@Icons.Material.Outlined.Cancel" Size="Size.Small" /></button>
        <span class="fmi-tool-sep"></span>
        <button type="button" class="fmi-icon-btn" title=@Loc["FMI_SHOW_LOG"] tabindex="26" @onclick=bFMI_showlog><MudIcon Icon="@Icons.Material.Outlined.Article" Size="Size.Small" /></button>
        <button type="button" class="fmi-icon-btn" title="Display results setup" tabindex="26" @onclick=bFMI_results><MudIcon Icon="@Icons.Material.Outlined.Speed" Size="Size.Small" /></button>
        <button type="button" class="fmi-icon-btn" title="FMI Setup: variables, macros and data sources" tabindex="26" @onclick=bFMI_setup><MudIcon Icon="@Icons.Material.Outlined.Build" Size="Size.Small" /></button>
        <span class="fmi-icon-btn fmi-file-btn" title="Link a CSV file for lookup() and xref()" tabindex="26">
            <InputFile id="fmiDataImportBtn" OnChange="bFMI_dataImport" single accept=".csv" />
            <MudIcon Icon="@Icons.Material.Outlined.TableView" Size="Size.Small" />
        </span>
    </div>
    <button type="button" class="fmi-keys-toggle @(stateContainer.showKeys != "" ? "open" : "")" title="Metadata" tabindex="26" @onclick=bFMI_MD>
        <MudIcon Icon="@Icons.Material.Outlined.DataObject" Size="Size.Small" />
        <span>@L("KEYS_EQUATIONS", "Keys & equations")</span>
        <MudIcon Icon="@(stateContainer.showKeys != "" ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ExpandLess)" Size="Size.Small" Class="ml-auto" />
    </button>
    }
@if (Part == "keys" || (Part == "all" && stateContainer.showKeys != ""))
{
    <div class="fmi-keys-tools">
        <label class="fmi-stop-after" title=@cycleTooltip()>
            @L("STOP_AFTER", "Stop after")
            <input id="fmiStepTotal" name="fmiStepTotal" type="number" min="0" class="fmi-cycle" tabindex="26" @bind=stepTOTAL placeholder="∞" />
            @L("CYCLES", "cycles")
        </label>
        <span class="ml-auto"></span>
        <button type="button" class="fmi-icon-btn" title="Move the selected key up" tabindex="26" @onclick=bKey_MoveUp><MudIcon Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" /></button>
        <button type="button" class="fmi-icon-btn" title="Move the selected key down" tabindex="26" @onclick=bKey_MoveDown><MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" /></button>
    </div>
    @if (ShowExperimentalModes)
    {
        <div class="fmi-keys-tools">
            <div class="fmi-mode-wrap" title="Active FMI preset model">
                <span class="fmi-mode-label">Mode</span>
                <select id="fmiModeSelect" name="fmiModeSelect" class="fmi-mode-badge" value="@normalizedMode()" @onchange="changeActiveMode">
                    <option value="BASIC">Basic</option>
                    <option value="BBN">BBN</option>
                    <option value="LOPA">LOPA</option>
                    <option value="NEURON">Neuron</option>
                </select>
            </div>
        </div>
    }
    @if (stateContainer.selectedFn == "-1")
    {
        <p class="sb-hint">@L("KEYS_MODEL_HINT", "Keys used in this model. Select a function to edit its values and equations.")</p>
        <div class="fmi-keylist">
            @foreach (var key in stateContainer.metaDataKeys.Keys)
            {
                <input name=@($"metaKey-{key}") class="fmi-keychip" type="text" value="@key" size="@Math.Max(4, key.Length)" @onfocus=@((e) => highlightKey(e, key)) readonly />
            }
        </div>
    }
    else
    {
        if (stateContainer.selectedFunction?.metadata is not null)
        {
            @if (IsVariantMode)
            {
                <div class="fmi-keys-tools">
                    <span class="fmi-text">@Mode</span>
                    <button type="button" class="fmi-icon-btn" title="Human" @onclick=@(() => ApplyModePreset("Human"))>H</button>
                    <button type="button" class="fmi-icon-btn" title="Organisational" @onclick=@(() => ApplyModePreset("Organisational"))>O</button>
                    <button type="button" class="fmi-icon-btn" title="Technological" @onclick=@(() => ApplyModePreset("Technological"))>T</button>
                    <button type="button" class="fmi-icon-btn" title="Default" @onclick=@(() => ApplyModePreset("Default"))>@DefaultPresetButtonText()</button>
                </div>
            }
            foreach (var keyValue in stateContainer.selectedFunction.metadata) //À-˿Ͱ-ӿ^0-9×÷;
            {
                <div class="fmi-keyrow">
                    <input id=@($"Key_{keyValue[0]}") class="fmi-key" type="text" title="Key" pattern="[A-Z][A-Za-z0-9_]*" @onchange=@((e) => keyCheckChange(e, keyValue[0])) @oninput=@((e) => checkValidKey(e, $"Key_{keyValue[0]}")) @onfocusout=@((e) => setLastKey(e, $"{keyValue[0]}")) value="@keyValue[0]" spellcheck="false" />
                    <input name=@($"metaValue-{keyValue[0]}") class="fmi-value" type="text" title="Value" value="@keyValue[1]" disabled="@equationCheck(keyValue[2])" @onchange=@((e) => valueCheckChange(e, keyValue)) spellcheck="false" />
                    <label class="fmi-eq-toggle" title="Calculate this key with an equation">
                        <input id=@($"eqCheck_{keyValue[0]}") type="checkbox" checked="@equationCheck(keyValue[2])" @onchange=@((e) => eqCheckChange(e, keyValue[0])) /><i>f(x)</i>
                    </label>
                    @if (equationCheck(keyValue[2]))
                    {
                        <textarea name=@($"metaEquation-{keyValue[0]}") class="fmi-equation" value="@keyValue[3]" @onchange=@((e) => equationCheckChange(e, keyValue)) spellcheck="false" placeholder="= equation"
                                  @onfocusin=@((e) => variablesUpdateShow(e, keyValue[0])) />
                    }
                </div>
                @if (stateContainer.showVariables == keyValue[0])
                {
                    <FMIVariables></FMIVariables>
                }
            }
        }
        <div class="fmi-keyrow fmi-keyrow-new">
            <input id="New_Key" class="fmi-key" type="text" title="Key names must start with a capital letter and only contain letters, numbers, _ or |" pattern="[A-Z][A-Za-z0-9_]*" @onchange=addNewMetadata @oninput=@((e) => checkValidKey(e, "New_Key")) spellcheck="false" placeholder="+ New_Key" />
        </div>
    }
}
</div>
}

@code {
    [Parameter]
    public EventCallback refreshParent { get; set; }
    [Parameter]
    public string Mode { get; set; } = "Basic";
    /// <summary>Which part to render: "all" (the whole panel), "run" (compact run controls),
    /// "model" (feature chips and model-wide tools) or "keys" (keys and equations).</summary>
    [Parameter]
    public string Part { get; set; } = "all";

    /// <summary>The run loop lives in FmiRunEngine (testable without the UI); this component drives it.</summary>
    // Localization helper: falls back to a default English string if the resx key is missing.
    private string L(string key, string fallback)
    {
        var value = Loc[key];
        return value.ResourceNotFound ? fallback : value.Value;
    }
    private FmiRunEngine Engine => stateContainer.fmiRun ??= new FmiRunEngine(new StateContainerFmiRunHost(stateContainer, Logger));
    private int? stepTOTAL
    {
        get => Engine.StepTotal;
        set => Engine.StepTotal = value;
    }
    private bool isPlaying = false;
    private bool gotoKey = false;
    private string normalizedMode()
    {
        return (Mode ?? "Basic").Trim().ToUpperInvariant();
    }
    /// <summary>BBN, LOPA and NEURON presets are kept out of the UI until their calculations exist
    /// (the BBN preset's Execute(PBBN) has no implementation yet).</summary>
    private static bool ShowExperimentalModes => false;
    private bool IsVariantMode => ShowExperimentalModes && normalizedMode() != "BASIC";
    private string DefaultPresetButtonText()
    {
        return normalizedMode() switch
        {
            "LOPA" => "AI",
            "NEURON" => "AI",
            _ => "X"
        };
    }
    private void changeActiveMode(ChangeEventArgs e)
    {
        var selectedMode = e.Value?.ToString()?.Trim().ToUpperInvariant() ?? "BASIC";
        stateContainer.activeMode = selectedMode switch
        {
            "BBN" => "BBN",
            "LOPA" => "LOPA",
            "NEURON" => "NEURON",
            _ => "Basic"
        };
        refreshParent.InvokeAsync();
    }
    private void ApplyModePreset(string profile)
    {
        if (stateContainer.selectedFunction is null)
        {
            return;
        }

        var selectedFunction = stateContainer.selectedFunction;
        stateContainer.updateUndo();

        var isBackground = selectedFunction.FunctionType == "2";
        var normalizedProfile = profile;
        if (normalizedProfile == "Default")
        {
            normalizedProfile = normalizedMode() == "LOPA" || normalizedMode() == "NEURON" ? "AI" : "";
        }

        ensureMeta(selectedFunction, "Function_Type", normalizedProfile, "", "");

        switch (normalizedMode())
        {
            case "BBN":
                applyBbnPreset(selectedFunction, normalizedProfile, isBackground);
                break;
            case "LOPA":
                applyLopaPreset(selectedFunction, normalizedProfile, isBackground);
                break;
            case "NEURON":
                applyNeuronPreset(selectedFunction, normalizedProfile, isBackground);
                break;
            default:
                return;
        }

        stateContainer.metaIsDirty = true;
        refreshParent.InvokeAsync();
    }
    private void applyBbnPreset(Function selectedFunction, string profile, bool isBackground)
    {
        switch (profile)
        {
            case "Human":
                ensureMeta(selectedFunction, "CP_CtRt_On_Time", "0.95", "", "");
                ensureMeta(selectedFunction, "CP_CtRf_On_Time", "0.5", "", "");
                ensureMeta(selectedFunction, "CP_CfRt_On_Time", "0.75", "", "");
                ensureMeta(selectedFunction, "CP_CfRf_On_Time", "0.25", "", "");
                ensureMeta(selectedFunction, "CP_CtRt_Precise", "0.95", "", "");
                ensureMeta(selectedFunction, "CP_CtRf_Precise", "0.5", "", "");
                ensureMeta(selectedFunction, "CP_CfRt_Precise", "0.5", "", "");
                ensureMeta(selectedFunction, "CP_CfRf_Precise", "0.05", "", "");
                ensureMeta(selectedFunction, "On_Time", "0.75", isBackground ? "" : "true", isBackground ? "" : "Execute(PBBN)");
                ensureMeta(selectedFunction, "Precise", "0.5", isBackground ? "" : "true", isBackground ? "" : "Execute(PBBN)");
                break;
            case "Organisational":
                ensureMeta(selectedFunction, "CP_CtRt_On_Time", "0.95", "", "");
                ensureMeta(selectedFunction, "CP_CtRf_On_Time", "0.5", "", "");
                ensureMeta(selectedFunction, "CP_CfRt_On_Time", "0.5", "", "");
                ensureMeta(selectedFunction, "CP_CfRf_On_Time", "0.05", "", "");
                ensureMeta(selectedFunction, "CP_CtRt_Precise", "0.75", "", "");
                ensureMeta(selectedFunction, "CP_CtRf_Precise", "0.25", "", "");
                ensureMeta(selectedFunction, "CP_CfRt_Precise", "0.25", "", "");
                ensureMeta(selectedFunction, "CP_CfRf_Precise", "0.05", "", "");
                ensureMeta(selectedFunction, "On_Time", "0.75", isBackground ? "" : "true", isBackground ? "" : "Execute(PBBN)");
                ensureMeta(selectedFunction, "Precise", "0.25", isBackground ? "" : "true", isBackground ? "" : "Execute(PBBN)");
                break;
            case "Technological":
                ensureMeta(selectedFunction, "CP_CtRt_On_Time", "0.95", "", "");
                ensureMeta(selectedFunction, "CP_CtRf_On_Time", "0.05", "", "");
                ensureMeta(selectedFunction, "CP_CfRt_On_Time", "0.25", "", "");
                ensureMeta(selectedFunction, "CP_CfRf_On_Time", "0.05", "", "");
                ensureMeta(selectedFunction, "CP_CtRt_Precise", "0.95", "", "");
                ensureMeta(selectedFunction, "CP_CtRf_Precise", "0.05", "", "");
                ensureMeta(selectedFunction, "CP_CfRt_Precise", "0.25", "", "");
                ensureMeta(selectedFunction, "CP_CfRf_Precise", "0.05", "", "");
                ensureMeta(selectedFunction, "On_Time", "0.95", isBackground ? "" : "true", isBackground ? "" : "Execute(PBBN)");
                ensureMeta(selectedFunction, "Precise", "0.95", isBackground ? "" : "true", isBackground ? "" : "Execute(PBBN)");
                break;
            default:
                ensureMeta(selectedFunction, "CP_CtRt_On_Time", "1", "", "");
                ensureMeta(selectedFunction, "CP_CtRf_On_Time", "0", "", "");
                ensureMeta(selectedFunction, "CP_CfRt_On_Time", "0", "", "");
                ensureMeta(selectedFunction, "CP_CfRf_On_Time", "0", "", "");
                ensureMeta(selectedFunction, "CP_CtRt_Precise", "1", "", "");
                ensureMeta(selectedFunction, "CP_CtRf_Precise", "0", "", "");
                ensureMeta(selectedFunction, "CP_CfRt_Precise", "0", "", "");
                ensureMeta(selectedFunction, "CP_CfRf_Precise", "0", "", "");
                ensureMeta(selectedFunction, "On_Time", "1", isBackground ? "" : "true", isBackground ? "" : "Execute(PBBN)");
                ensureMeta(selectedFunction, "Precise", "1", isBackground ? "" : "true", isBackground ? "" : "Execute(PBBN)");
                break;
        }

        ensureMeta(selectedFunction, "Variable", "", isBackground ? "" : "true", isBackground ? "" : "(On_Time<=0.5 || Precise<=0.5)?1:0");
    }
    private void applyLopaPreset(Function selectedFunction, string profile, bool isBackground)
    {
        var pfd = profile switch
        {
            "Human" => "0.01",
            "Organisational" => "0.003",
            "Technological" => "0.0001",
            "AI" => "0.001",
            _ => "0"
        };

        ensureMeta(selectedFunction, "PFD", pfd, "", "");
        ensureMeta(selectedFunction, "Psd", "", "true", "1-PFD");
        ensureMeta(selectedFunction, "Pso", "", "true", isBackground ? "1*Psd" : "Aprd_Pso*Psd");
        ensureMeta(selectedFunction, "Pfd2", "", "true", "1-Pso");
    }
    private void applyNeuronPreset(Function selectedFunction, string profile, bool isBackground)
    {
        var effectiveness = profile switch
        {
            "Human" => "0.99",
            "Organisational" => "0.99",
            "Technological" => "0.99999",
            "AI" => "0.9999",
            _ => "0.99"
        };

        var tolerability = profile switch
        {
            "Human" => "0.75",
            "Organisational" => "0.75",
            "Technological" => "0.99",
            "AI" => "0.9",
            _ => "0.75"
        };

        ensureMeta(selectedFunction, "Effectiveness", effectiveness, "", "");
        ensureMeta(selectedFunction, "Tolerability", tolerability, "", "");
        ensureMeta(selectedFunction, "Activate", "1", isBackground ? "" : "true", isBackground ? "" : "Amin_Effectiveness>=Tolerability?1:0");
        ensureMeta(selectedFunction, "Variable", "", isBackground ? "" : "true", isBackground ? "" : "Effectiveness<0.99?1:0");
    }
    private void ensureMeta(Function fn, string key, string value, string active, string equation)
    {
        var getMeta = fn.metadata;
        var existing = getMeta.Find(x => x[0] == key);
        if (existing is null)
        {
            existing = new string[] { key, value, active, equation, value };
            getMeta.Add(existing);
        }
        else
        {
            existing[1] = value;
            existing[2] = active;
            existing[3] = equation;
            existing[4] = value;
        }

        if (!stateContainer.metaDataKeys.ContainsKey(key))
        {
            stateContainer.metaDataKeys.Add(key, "");
        }
        stateContainer.metaDataKeys[key] = value;
        ensureMetadataColumns(key);
        updateMetadataRow(fn, key, value, active, equation);
    }
    private void ensureMetadataColumns(string key)
    {
        if (!stateContainer.metadataDS.Tables.Contains("Metadata"))
        {
            return;
        }

        var cols = stateContainer.metadataDS.Tables["Metadata"]!.Columns;
        if (!cols.Contains(key))
        {
            cols.Add(new DataColumn(key, typeof(string)));
        }
        if (!cols.Contains($"{key}-active"))
        {
            cols.Add(new DataColumn($"{key}-active", typeof(string)));
        }
        if (!cols.Contains($"{key}-equation"))
        {
            cols.Add(new DataColumn($"{key}-equation", typeof(string)));
        }
    }
    private void updateMetadataRow(Function fn, string key, string value, string active, string equation)
    {
        if (!stateContainer.metadataDS.Tables.Contains("Metadata"))
        {
            return;
        }

        var table = stateContainer.metadataDS.Tables["Metadata"]!;
        var row = table.Select($"IDNr = {fn.IDNr} and Cycle = -1").FirstOrDefault();
        if (row is null)
        {
            return;
        }

        row[key] = value;
        row[$"{key}-active"] = active;
        row[$"{key}-equation"] = equation;
    }
    private async void checkValidKey(ChangeEventArgs e, string keyName)
    {
        string checkKey = e.Value?.ToString() ?? "";
        var matchKey = Regex.Match(checkKey, "^[A-Z][A-Za-z0-9_]*$");
        if ((!matchKey.Success || matchKey.Value.Length != checkKey.Length) && checkKey.Length > 0)
        {
            var oldKey = checkKey.Substring(0, checkKey.Length - 1);
            await JSRuntime.InvokeVoidAsync("setInput", keyName, oldKey);
            //await JSRuntime.InvokeVoidAsync("alert", $"Key names must start with a capital letter and only contain letters, numbers, _ or |");
        }
    }
