                                    //Console.WriteLine("=====================");
                                    //Console.WriteLine($"Coupling: {coupling.Name}, {coupling.toType}{coupling.outputFn}_");
                                    //Console.WriteLine($"Function: {fnBG2.IDNr}, {fnBG2.IDName}");
                                    //Console.WriteLine("=====================");
                                    fnBG2.removeVariable($"{coupling.toType}{coupling.outputFn}_");
                                }
                                coupling.fmiHighlight = "";
                            }
                            foreach (var coupling in stateContainer.couplingList.FindAll(x => x.outputFn == fnBG2.IDNr && x.outputFn != x.toFn && (activateAll2 || activateOnly.Contains(x.label))))
                            { //This activates the Outputs of the current Function
                                if (!toActivateAspectsArray.Contains(coupling))
                                {
                                    toActivateAspectsArray.Add(coupling);
                                }
                            }
                        }
                        else
                        {
                            fnBG2.fmiHighlight = "hold-fill";
                        }
                        */
                    }
                    else
                    {
                        //check for group?
                        fnBG2.fmiHighlight = "";
                    }
                }
            }
            returnString = stateContainer.cycleFMI.ToString();
            if (stepTOTAL == null)
            {
                if (trackExitFunctions.Count == 0)
                {
                    //bFMI.enabled = false;
                    //stateContainer.fmiMessage += "\nEnd";
                    returnString = "End";
                }
            }
            else if (stepTOTAL.HasValue && stepTOTAL != 0 && stepTOTAL <= stateContainer.cycleFMI)
            {
                //bFMI.enabled = false;
                //stateContainer.fmiMessage += "\nEnd";
                returnString = "End";
            }
        }
        //activeAspectsArray.AddRange(toActivateAspectsArray);
        foreach (var item in toActivateAspectsArray)
        {
            if (!activeAspectsArray.Contains(item))
            {
                activeAspectsArray.Add(item);
            }
        }
        if (trackHighlights == 0)
        {
            stateContainer.fmiMessage += "No functions were activated during this cycle.\n"; 
            if (!stepTOTAL.HasValue)
            {
                //bFMI.enabled = false;
                //stateContainer.fmiMessage += "\nEnd";
                returnString = "End";
            }
        }
        return returnString;
    }
    private bool activateFunction(Function fnBG)
    {
        var canActivate = true;
        var activateAll = true;
        var activateOnly = "";
        var fnMD = fnBG.metadata.Find(x => x[0] == "Activate");
        if (fnMD is not null)
        {
            if (fnMD[1] == "0" || fnMD[1] == "false")
            {
                canActivate = false;
            }
            if (fnMD[1] != "1" && fnMD[1] != "true")
            {
                activateAll = false;
                activateOnly = fnMD[1];
            }
        }
        var fnMDv2 = fnBG.metadata.Find(x => x[0] == "Variable");
        if (fnMDv2 is not null && fnBG.FunctionType != "2")
        {
            stateContainer.updateUndo();
            if (fnMDv2[1] == "1" || fnMDv2[1] == "true")
            {
                fnBG.FunctionType = "1";
                stateContainer.projectData_Undo[0].SelectSingleNode($"//FM/Functions/Function[IDNr={fnBG.IDNr}]/FunctionType")!.InnerText = "1";
            }
            else
            {
                fnBG.FunctionType = "0";
                stateContainer.projectData_Undo[0].SelectSingleNode($"//FM/Functions/Function[IDNr={fnBG.IDNr}]/FunctionType")!.InnerText = "0";
            }
        }
        if (canActivate)
        {
            fnBG.wasActive = true;
            trackHighlights += 1;
            fnBG.fmiHighlight = $"{fnBG.fmiType.ToLower()}-fill";
            if (fnBG.fmiType == "Entry")
            {
                stateContainer.fmiMessage += $"Entry Function <{fnBG.IDName}> has been activated\n";
                foreach (var coupling in stateContainer.couplingList.FindAll(x => x.outputFn == fnBG.IDNr && (activateAll || fnMD![1].Contains(x.label))))
                {
                    if (!toActivateAspectsArray.Contains(coupling))
                    {
                        toActivateAspectsArray.Add(coupling);
                    }
                }
            }
            else if (fnBG.fmiType == "Background") // && stateContainer.cycleFMI == 0)
            {
                foreach (var coupling in stateContainer.couplingList.FindAll(x => x.outputFn == fnBG.IDNr && (activateAll || fnMD![1].Contains(x.label))))
                {
                    coupling.wasActive = true;
                    coupling.activated = true;
                    coupling.fmiHighlight = "background-fill";
                    var nextFn = stateContainer.functionList.Find(x => x.IDNr == coupling.toFn);
                    if (nextFn is not null)
                    {
                        switch (coupling.toType)
                        {
                            case "I": nextFn.activeI.Add(coupling.Name); break;
                            case "P": nextFn.activeP.Add(coupling.Name); break;
                            case "R": nextFn.activeR.Add(coupling.Name); break;
                            case "C": nextFn.activeC.Add(coupling.Name); break;
                            case "T": nextFn.activeT.Add(coupling.Name); break;
                        }
                        var outputFn = stateContainer.functionList.Find(x => x.IDNr == coupling.outputFn);
                        if (outputFn is not null)
                        {
                            foreach (var meta in outputFn.metadata)
                            {
                                nextFn.newVariable($"{coupling.toType}{coupling.outputFn}_{meta[0]}", new string[] { meta[1], meta[1] });
                            }
                        }
                    }
                }
            }
            else
            {
                var holdAll = false;
                var holdOnly = "";
                var fnMDH = fnBG.metadata.Find(x => x[0] == "Hold");
                if (fnMDH is not null)
                {
                    holdAll = true;
                    if (fnMDH[1] == "0" || fnMDH[1] == "false")
                    {
                        holdAll = false;
                    }
                    if (fnMDH[1] != "1" && fnMDH[1] != "true")
                    {
                        holdAll = false;
                        holdOnly = fnMDH[1];
                    }
                }
                if (fnBG.fmiType != "Exit")
                {
                    fnBG.fmiHighlight = "entry-fill";
                    stateContainer.fmiMessage += $"Function <{fnBG.IDName}> has been activated\n";
                }
                else
                {
                    trackExitFunctions.Remove(fnBG.IDNr);
                    stateContainer.fmiMessage += $"Exit function <{fnBG.IDName}> has been activated\n";
                }
                foreach (var coupling in stateContainer.couplingList.FindAll(x => x.toFn == fnBG.IDNr && !x.activated && !holdAll && !holdOnly.Contains(x.label)))
                {//This is about clearing the Aspects that were consumed, but not if also part of repeating cycle, and not if explicitly on Hold
                    if (stateContainer.functionList.Find(x => x.IDNr == coupling.outputFn)?.fmiType != "Background")
                    {
                        switch (coupling.toType)
                        {
                            case "I": fnBG.activeI.Remove(coupling.Name); break;
                            case "P": fnBG.activeP.Remove(coupling.Name); break;
                            case "R": fnBG.activeR.Remove(coupling.Name); break;
                            case "C": fnBG.activeC.Remove(coupling.Name); break;
                            case "T": fnBG.activeT.Remove(coupling.Name); break;
                        }
                        activeAspectsArray.Remove(coupling);
                        //Console.WriteLine("=====================");
                        //Console.WriteLine($"Coupling: {coupling.Name}, {coupling.toType}{coupling.outputFn}_");
                        //Console.WriteLine($"Function: {fnBG2.IDNr}, {fnBG2.IDName}");
                        //Console.WriteLine("=====================");
                        fnBG.removeVariable($"{coupling.toType}{coupling.outputFn}_");
                    }
                    coupling.fmiHighlight = "";
                }
                foreach (var coupling in stateContainer.couplingList.FindAll(x => x.outputFn == fnBG.IDNr && x.outputFn != x.toFn && (activateAll || activateOnly.Contains(x.label))))
                { //This activates the Outputs of the current Function, unless selectively not included in Activate
                    if (!toActivateAspectsArray.Contains(coupling))
                    {
                        toActivateAspectsArray.Add(coupling);
                    }
                }
            }
        }
        else
        {
            fnBG.fmiHighlight = "hold-fill";
        }
        return canActivate;
    }
    private void evaluate(Function iBG) //private async Task evaluate(Function iBG)
    {
        var showVariability = false;
        stateContainer.calcVariables(iBG); //calculate the new variable values for the given function
        if (iBG.metadata is not null)
        {
            foreach (string[] md3Key in iBG.metadata) //[0]=key name, [1]=key value, [2]=active attribute, [3]=equation attribute
            {
                if (md3Key[1].Length > 0 || md3Key[3].Length > 0) //metadata key has a value or has an equation
                {
                    if (md3Key[2] == "true") //it has an equation
                    {
                        if (md3Key[0].StartsWith("Global_"))
                        {
                            iBG.newVariable(md3Key[0], new string[] { stateContainer.metaDataKeys[md3Key[0]], stateContainer.metaDataKeys[md3Key[0]] });
                        }
                        else
                        {
                            iBG.newVariable(md3Key[0], new string[] { md3Key[1], md3Key[1] }); //if equation, update variable before, and again after, the eval
                            stateContainer.metaDataKeys[md3Key[0]] = md3Key[1];
                        }
                        //=======================================
                        //This is an option to run custom code on a Function. The code is written in the Function.cs component. An example is 'returnTrue'
                        if (md3Key[3].StartsWith("execute("))
                        {
                            var contentText = md3Key[3].Replace("execute(", "").Replace(")", "");
                            var contentArray = contentText.Split(",");
                            var codeName = contentArray[0];
                            var method = iBG.GetType().GetMethod(codeName);
                            if (method is not null)
                            {
                                contentArray[0] = md3Key[0];
                                md3Key[1] = method.Invoke(iBG, new object[] { contentArray } )?.ToString() ?? "STOP";
                            }
                        }
                        else if (md3Key[3].StartsWith("array("))
                        {
                            var content = $"{md3Key[0]},{md3Key[3].Replace("array(", "").Replace(")", "")}".Split(",");
                            //var method = iBG.GetType().GetMethod("array");
                            //if (method is not null)
                            //{
                            md3Key[1] = iBG.array(content);
                            //}
                        }
                        //=======================================
                        //This is an option to call an external API
                        // if (md3Key[3].StartsWith("api(")) //check for api use here, otherwise pass to equation eval function
                        // {
                        //     var apiExpression = md3Key[3].Replace("api(", "").Replace(")", "").Replace("\"", "").Split(",", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                        //     var jsonContent = "";
                        //     var varCount = apiExpression.Length;
                        //     var varParameters = $"?fnName={iBG.IDName}&keyName={md3Key[0]}";
                        //     if (varCount > 1) //if more than one parameter in api() call, then build a query string, otherwise add all variables and data to the body content
                        //     {
                        //         for (var i = 1; i < varCount; i++)
                        //         {
                        //             varParameters += $"&{apiExpression[i]}={iBG.getVariable(apiExpression[i])?[0]??""}";
                        //         }
                        //         jsonContent = "";
                        //     }
                        //     else
                        //     {
                        //         jsonContent = JsonSerializer.Serialize(iBG.getVariables());
                        //     }
                        //     //Console.WriteLine(apiExpression[0]);
                        //     var requestUrl = new Uri($"{apiExpression[0]}{varParameters}");
                        //     var requestMessage = new HttpRequestMessage(HttpMethod.Post, requestUrl);
                        //     requestMessage.Content = new StringContent(jsonContent);

                        //     var reply = await Http.SendAsync(requestMessage);
                        //     if (reply.StatusCode == HttpStatusCode.OK)
                        //     {
                        //         md3Key[1] = await reply.Content.ReadAsStringAsync();
                        //     } else
                        //     {
                        //         md3Key[1] = reply?.ReasonPhrase??"NaN";
                        //     }
                        //     //Console.WriteLine(reply);
                        //     //Console.WriteLine(md3Key[1]);
                        // }
                        //=======================================
                        else
                        {
                            md3Key[1] = stateContainer.eval(md3Key[3], iBG.getVariables());
                        }
                    }
                    iBG.newVariable(md3Key[0], new string[] { md3Key[1], md3Key[1] });
                    stateContainer.metaDataKeys[md3Key[0]] = md3Key[1];

                    var fnMD = stateContainer.metadataDS.Tables["Metadata"]!.Select($"IDNr = {iBG.IDNr} and Cycle = -1")[0];
                    if (fnMD is not null && fnMD[md3Key[0]] is not null)
                    {
                        fnMD[md3Key[0]] = md3Key[1];
                    }
                    for (var i = 1; i <= 6; i++)
                    {
                        if (stateContainer.displaySetup.ContainsKey($"tracer_{i}") && md3Key[0] == stateContainer.displaySetup[$"tracer_{i}"])
                        {
                            stateContainer.updateKvalue(iBG, $"K{i}", md3Key[1]);
                            showVariability = true;
                        }
                    }
                }
            }
        }
        //showVariability = true;
        if (showVariability && (iBG.FunctionType != "2" || iBG.fmiType == "Exit")) //ignore Background but do include Exit functions
        {
            checkVariability_DrawResults(iBG);
        }
        stateContainer.addMetadataResults(iBG); //this adds a new row to the Metadata table for the results of the evaluated Function (for the current Cycle)
    }
    private void checkVariability_DrawResults(Function iBG)
    {
        iBG.toolTip = "";
        iBG.Cvalues = new Dictionary<string, string>();
        for (var i = 1; i <= 6; i++)
        {
            if (stateContainer.displaySetup[$"tracer_{i}"].Length > 0 && iBG.Kvalues.ContainsKey($"K{i}"))
            {
                iBG.toolTip += $"{stateContainer.displaySetup[$"tracer_{i}"]} = {iBG.Kvalues[$"K{i}"]}\n";
                double d_t0 = stateContainer.displayValue[$"colour_{i}0"];
                double d_t1 = stateContainer.displayValue[$"colour_{i}1"];
                double d_t2 = stateContainer.displayValue[$"colour_{i}2"];
                double d_t3 = stateContainer.displayValue[$"colour_{i}3"];
                double d_t4 = stateContainer.displayValue[$"colour_{i}4"];
                // Console.WriteLine($"d_t0: {d_t0}");
                // Console.WriteLine($"d_t1: {d_t1}");
                // Console.WriteLine($"d_t2: {d_t2}");
                // Console.WriteLine($"d_t3: {d_t3}");
                // Console.WriteLine($"d_t4: {d_t4}");
                // Console.WriteLine($"K{i}: {iBG.Kvalues[$"K{i}"]}");
                if (d_t1 is not double.NaN && iBG.Kvalues[$"K{i}"] <= d_t1)
                {
                    //var d_t0 = stateContainer.displayValue[$"colour_{i}0"];
                    iBG.Cvalues[$"{i}C_stroke"] = stateContainer.displaySetup[$"c_{i}0_value"];
                    iBG.Cvalues[$"{i}C_opacity"] = (0.75 - (iBG.Kvalues[$"K{i}"] - d_t0) * 0.25 / (d_t1 - d_t0)).ToString("0.##", CultureInfo.InvariantCulture);
                    iBG.Cvalues[$"{i}Y_stroke"] = stateContainer.displaySetup[$"c_{i}2_value"];
                    iBG.Cvalues[$"{i}Y_opacity"] = ((iBG.Kvalues[$"K{i}"] - d_t0) * 0.5 / (d_t1 - d_t0)).ToString("0.##", CultureInfo.InvariantCulture);
                }
                else if (d_t2 is not double.NaN && iBG.Kvalues[$"K{i}"] <= d_t2)
                {
                    iBG.Cvalues[$"{i}C_stroke"] = stateContainer.displaySetup[$"c_{i}0_value"];
                    iBG.Cvalues[$"{i}C_opacity"] = (0.5 - (iBG.Kvalues[$"K{i}"] - d_t1) * 0.5 / (d_t2 - d_t1)).ToString("0.##", CultureInfo.InvariantCulture);
                    iBG.Cvalues[$"{i}Y_stroke"] = stateContainer.displaySetup[$"c_{i}2_value"];
                    iBG.Cvalues[$"{i}Y_opacity"] = (0.5 + (iBG.Kvalues[$"K{i}"] - d_t1) * 0.25 / (d_t2 - d_t1)).ToString("0.##", CultureInfo.InvariantCulture);
                }
                else if (d_t3 is not double.NaN && iBG.Kvalues[$"K{i}"] <= d_t3)
                {
                    iBG.Cvalues[$"{i}Y_stroke"] = stateContainer.displaySetup[$"c_{i}2_value"];
                    iBG.Cvalues[$"{i}Y_opacity"] = (0.75 - (iBG.Kvalues[$"K{i}"] - d_t2) * 0.25 / (d_t3 - d_t2)).ToString("0.##", CultureInfo.InvariantCulture);
                    iBG.Cvalues[$"{i}M_stroke"] = stateContainer.displaySetup[$"c_{i}4_value"];
                    iBG.Cvalues[$"{i}M_opacity"] = ((iBG.Kvalues[$"K{i}"] - d_t2) * 0.5 / (d_t3 - d_t2)).ToString("0.##", CultureInfo.InvariantCulture);
