@inject IJSRuntime JSRuntime
@inject StateContainer stateContainer
@inject IStringLocalizer<Localization.SharedResource> Loc

<div class="navbar p-0 pt-2">
    <div>
        <button type="button" class="btn btn-FMI oi oi-reload" style="transform:scale(-1,1)" title=@Loc["FMI_RESET"] tabindex="26" @onclick=bFMI_reset></button>
        <button type="button" class="btn btn-FMI oi oi-media-step-forward" title=@Loc["FMI_STEP"] tabindex="26" @onclick=bFMI_step></button>
        <button type="button" class=@checkForPlay() title=@Loc["FMI_PLAY"] tabindex="26" @onclick=bFMI_start></button>
    </div>
    <div class="float-right">
        <button type="button" class="btn btn-FMI oi oi-circle-check" title=@Loc["FMI_SHOW_ACTIVATED"] tabindex="26" @onclick=bFMI_wasActive></button>
        <button type="button" class="btn btn-FMI oi oi-circle-x" title=@Loc["FMI_NOT_ACTIVATED"] tabindex="26" @onclick=bFMI_notActive></button>
        <button type="button" class="btn btn-FMI oi oi-code" title="Metadata" tabindex="26" @onclick=bFMI_MD></button>
    </div>
</div>
<div class="navbar p-0">
    <div class="d-flex align-items-center w-100 text-FMI" title=@Loc["FMI_DELAY"] tabindex="26"><span class="btn-FMIs oi oi-timer unselectable"></span><input id="fmiCycleDelay" name="fmiCycleDelay" class="w-100" type="range" @bind="stateContainer.cycleDelay" @bind:event="oninput" min="0" max="1500" step="250" /><span class="unselectable">&nbsp;@(((double)stateContainer.cycleDelay / 1000).ToString("0.0#s"))</span></div>
</div>
@if (stateContainer.showKeys != "")
{
    <div class="navbar p-0 pt-2 pb-2">
        <div>
            <input id="fmiStepTotal" name="fmiStepTotal" type="number" min="0" class="fmi-cycle oi" title=@cycleTooltip() tabindex="26" @bind=stepTOTAL />
            <button type="button" class="btn btn-FMI oi oi-arrow-circle-top" title="Move up" tabindex="26" @onclick=bKey_MoveUp></button>
            <button type="button" class="btn btn-FMI oi oi-arrow-circle-bottom" title="Move down" tabindex="26" @onclick=bKey_MoveDown></button>
        </div>
        <div class="float-right">
            <div class="btn btn-FMI file-input-zone oi oi-external-link" tabindex="26">
                <InputFile id="openFileBtn" OnChange="bFMI_dataImport" single accept=".csv" title="Link to external data" />
            </div>
            <button type="button" class="btn btn-FMI oi oi-file" title=@Loc["FMI_SHOW_LOG"] tabindex="26" @onclick=bFMI_showlog></button>
            <button type="button" class="btn btn-FMI oi oi-dashboard" title="Display results setup" tabindex="26" @onclick=bFMI_results></button>
        </div>
    </div>
    <div class="navbar p-0">
        <div></div>
        <div class="float-right">
            <div class="fmi-mode-wrap" title="Active FMI preset model">
                <span class="fmi-mode-label">Mode</span>
                <select id="fmiModeSelect" name="fmiModeSelect" class="fmi-mode-badge" value="@normalizedMode()" @onchange="changeActiveMode">
                    <option value="BASIC">Basic</option>
                    <option value="BBN">BBN</option>
                    <option value="LOPA">LOPA</option>
                    <option value="NEURON">Neuron</option>
                </select>
            </div>
            <div class=@showExtension()>
                @foreach (var option in @listTypes())
                {
                    <div class="fmi-text unselectable" @onclick=@((e) => SelectExtension(e, option.Name))>@option.Name</div>
                }
            </div>
            <button class="btn btn-menu oi oi-briefcase" title="switch sandbox" @onclick=changetypeFMIControl />
        </div>
    </div>
    @if (stateContainer.selectedFn == "-1")
    {
        foreach (var key in stateContainer.metaDataKeys.Keys)
        {
            <div class="navbar p-0">
                <input name=@($"metaKey-{key}") class="fmi-key" type="text" value="@key" @onfocus=@((e) => highlightKey(e, key)) readonly />
            </div>
        }
    } 
    else
    {
        if (stateContainer.selectedFunction?.metadata is not null)
        {
            @if (IsVariantMode)
            {
                <div class="navbar p-0 pb-1">
                    <div class="d-flex w-100 align-items-center">
                        <span class="fmi-text pr-2">@Mode</span>
                        <button type="button" class="btn btn-menu btn-textp" title="Human" @onclick=@(() => ApplyModePreset("Human"))>H</button>
                        <button type="button" class="btn btn-menu btn-textp" title="Organisational" @onclick=@(() => ApplyModePreset("Organisational"))>O</button>
                        <button type="button" class="btn btn-menu btn-textp" title="Technological" @onclick=@(() => ApplyModePreset("Technological"))>T</button>
                        <button type="button" class="btn btn-menu btn-textp" title="Default" @onclick=@(() => ApplyModePreset("Default"))>@DefaultPresetButtonText()</button>
                    </div>
                </div>
            }
            foreach (var keyValue in stateContainer.selectedFunction.metadata) //\u00C0-\u02FF\u0370-\u04FF^0-9\u00D7\u00F7\u037E
            {
                <div class="navbar p-0">
                    <div class="d-flex">
                        <input id=@($"Key_{keyValue[0]}") class="fmi-key" type="text" pattern="[A-Z][A-Za-z0-9_]*" @onchange=@((e) => keyCheckChange(e, keyValue[0])) @oninput=@((e) => checkValidKey(e, $"Key_{keyValue[0]}")) @onfocusout=@((e) => setLastKey(e, $"{keyValue[0]}")) value="@keyValue[0]" spellcheck="false" />
                        <input name=@($"metaValue-{keyValue[0]}") class="w-50" type="text" value="@keyValue[1]" disabled="@equationCheck(keyValue[2])" @onchange=@((e) => valueCheckChange(e, keyValue)) spellcheck="false" />
                    </div>
                    <div class="d-flex">
                        <input id=@($"eqCheck_{keyValue[0]}") class="m-0 ml-2" type="checkbox" checked="@equationCheck(keyValue[2])" @onchange=@((e) => eqCheckChange(e, keyValue[0])) />
                        <label for=@($"eqCheck_{keyValue[0]}") class="btn p-1"><i>f(x)=</i></label>
                        <textarea name=@($"metaEquation-{keyValue[0]}") class="fmi-equation" value="@keyValue[3]" disabled="@(!equationCheck(keyValue[2]))" @onchange=@((e) => equationCheckChange(e, keyValue)) spellcheck="false"
                        @onfocusin=@((e) => variablesUpdateShow(e, keyValue[0])) />
                    </div>
                </div>
                @if (stateContainer.showVariables == keyValue[0])
                {
                    <FMIVariables></FMIVariables>
                }
            }
        }
        <div class="navbar p-0 pb-2">
            <div class="d-flex">
                <input id="New_Key" class="fmi-key" type="text" title="Key names must start with a capital letter and only contain letters, numbers, _ or |" pattern="[A-Z][A-Za-z0-9_]*" @onchange=addNewMetadata @oninput=@((e) => checkValidKey(e, "New_Key")) spellcheck="false" placeholder="New_Key0" />
                <input name="newMetaValue" class="w-50" type="text" value="" disabled />
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public EventCallback refreshParent { get; set; }
    [Parameter]
    public string Mode { get; set; } = "Basic";

    private List<Coupling> activeAspectsArray = new List<Coupling>();
    private List<Coupling> toActivateAspectsArray = new List<Coupling>();
    private List<string> trackExitFunctions = new List<string>();
    //private List<string[]> dataRows = new List<string[]>();
    //private Dictionary<string, string> dataKeys = new Dictionary<string, string>();
    private int? stepTOTAL = null;
    private bool isPlaying = false;
    private Random rnd = new Random();
    private bool gotoKey = false;
    private int trackHighlights = 0;
    private string showSelect = "";
    private string normalizedMode()
    {
        return (Mode ?? "Basic").Trim().ToUpperInvariant();
    }
    private bool IsVariantMode => normalizedMode() != "BASIC";
    private string DefaultPresetButtonText()
    {
        return normalizedMode() switch
        {
            "LOPA" => "AI",
            "NEURON" => "AI",
            _ => "X"
        };
    }
    private List<Type> listTypes()
    {
        var tempAssembly = AppDomain.CurrentDomain.GetAssemblies().First(x => x.FullName?.StartsWith("FMV_OG,") == true); // Type.GetType("FMV_OG.Shared"); //.GetMembers();
        var tempTypes = tempAssembly.GetTypes().Where(x => x.Name.StartsWith("FMIControl_"));
        return tempTypes.ToList();
    } 
    private string showExtension()
    {
        return $"fmi-select{showSelect}";
    }
    private void SelectExtension(MouseEventArgs e, string option)
    {
        stateContainer.showKeysSetting = listTypes().FirstOrDefault(x => x.Name == option);
        refreshParent.InvokeAsync();
    }
    private void changeActiveMode(ChangeEventArgs e)
    {
        var selectedMode = e.Value?.ToString()?.Trim().ToUpperInvariant() ?? "BASIC";
        Type? targetType = selectedMode switch
        {
            "BBN" => listTypes().FirstOrDefault(x => x.Name == nameof(FMIControl_BBN)),
            "LOPA" => listTypes().FirstOrDefault(x => x.Name == nameof(FMIControl_LOPA)),
            "NEURON" => listTypes().FirstOrDefault(x => x.Name == nameof(FMIControl_Neuron)),
            _ => typeof(FMIControl)
        };

        if (targetType is null)
        {
            targetType = typeof(FMIControl);
        }

        stateContainer.showKeysSetting = targetType;
        refreshParent.InvokeAsync();
    }
    private void changetypeFMIControl()
    {
        showSelect = showSelect == "" ? " show" : "";
    }
    private void ApplyModePreset(string profile)
    {
        if (stateContainer.selectedFunction is null)
        {
            return;
        }

        var selectedFunction = stateContainer.selectedFunction;
        stateContainer.updateUndo();

        var isBackground = selectedFunction.FunctionType == "2";
        var normalizedProfile = profile;
        if (normalizedProfile == "Default")
        {
            normalizedProfile = normalizedMode() == "LOPA" || normalizedMode() == "NEURON" ? "AI" : "";
        }

        ensureMeta(selectedFunction, "Function_Type", normalizedProfile, "", "");

        switch (normalizedMode())
        {
            case "BBN":
                applyBbnPreset(selectedFunction, normalizedProfile, isBackground);
                break;
            case "LOPA":
                applyLopaPreset(selectedFunction, normalizedProfile, isBackground);
                break;
            case "NEURON":
                applyNeuronPreset(selectedFunction, normalizedProfile, isBackground);
                break;
            default:
                return;
        }

        stateContainer.metaIsDirty = true;
        refreshParent.InvokeAsync();
    }
    private void applyBbnPreset(Function selectedFunction, string profile, bool isBackground)
    {
        switch (profile)
        {
            case "Human":
                ensureMeta(selectedFunction, "CP_CtRt_On_Time", "0.95", "", "");
                ensureMeta(selectedFunction, "CP_CtRf_On_Time", "0.5", "", "");
                ensureMeta(selectedFunction, "CP_CfRt_On_Time", "0.75", "", "");
                ensureMeta(selectedFunction, "CP_CfRf_On_Time", "0.25", "", "");
                ensureMeta(selectedFunction, "CP_CtRt_Precise", "0.95", "", "");
                ensureMeta(selectedFunction, "CP_CtRf_Precise", "0.5", "", "");
                ensureMeta(selectedFunction, "CP_CfRt_Precise", "0.5", "", "");
                ensureMeta(selectedFunction, "CP_CfRf_Precise", "0.05", "", "");
                ensureMeta(selectedFunction, "On_Time", "0.75", isBackground ? "" : "true", isBackground ? "" : "Execute(PBBN)");
                ensureMeta(selectedFunction, "Precise", "0.5", isBackground ? "" : "true", isBackground ? "" : "Execute(PBBN)");
                break;
            case "Organisational":
                ensureMeta(selectedFunction, "CP_CtRt_On_Time", "0.95", "", "");
                ensureMeta(selectedFunction, "CP_CtRf_On_Time", "0.5", "", "");
                ensureMeta(selectedFunction, "CP_CfRt_On_Time", "0.5", "", "");
                ensureMeta(selectedFunction, "CP_CfRf_On_Time", "0.05", "", "");
                ensureMeta(selectedFunction, "CP_CtRt_Precise", "0.75", "", "");
                ensureMeta(selectedFunction, "CP_CtRf_Precise", "0.25", "", "");
                ensureMeta(selectedFunction, "CP_CfRt_Precise", "0.25", "", "");
                ensureMeta(selectedFunction, "CP_CfRf_Precise", "0.05", "", "");
                ensureMeta(selectedFunction, "On_Time", "0.75", isBackground ? "" : "true", isBackground ? "" : "Execute(PBBN)");
                ensureMeta(selectedFunction, "Precise", "0.25", isBackground ? "" : "true", isBackground ? "" : "Execute(PBBN)");
                break;
            case "Technological":
                ensureMeta(selectedFunction, "CP_CtRt_On_Time", "0.95", "", "");
                ensureMeta(selectedFunction, "CP_CtRf_On_Time", "0.05", "", "");
                ensureMeta(selectedFunction, "CP_CfRt_On_Time", "0.25", "", "");
                ensureMeta(selectedFunction, "CP_CfRf_On_Time", "0.05", "", "");
                ensureMeta(selectedFunction, "CP_CtRt_Precise", "0.95", "", "");
                ensureMeta(selectedFunction, "CP_CtRf_Precise", "0.05", "", "");
                ensureMeta(selectedFunction, "CP_CfRt_Precise", "0.25", "", "");
                ensureMeta(selectedFunction, "CP_CfRf_Precise", "0.05", "", "");
                ensureMeta(selectedFunction, "On_Time", "0.95", isBackground ? "" : "true", isBackground ? "" : "Execute(PBBN)");
                ensureMeta(selectedFunction, "Precise", "0.95", isBackground ? "" : "true", isBackground ? "" : "Execute(PBBN)");
                break;
            default:
                ensureMeta(selectedFunction, "CP_CtRt_On_Time", "1", "", "");
                ensureMeta(selectedFunction, "CP_CtRf_On_Time", "0", "", "");
                ensureMeta(selectedFunction, "CP_CfRt_On_Time", "0", "", "");
                ensureMeta(selectedFunction, "CP_CfRf_On_Time", "0", "", "");
                ensureMeta(selectedFunction, "CP_CtRt_Precise", "1", "", "");
                ensureMeta(selectedFunction, "CP_CtRf_Precise", "0", "", "");
                ensureMeta(selectedFunction, "CP_CfRt_Precise", "0", "", "");
                ensureMeta(selectedFunction, "CP_CfRf_Precise", "0", "", "");
                ensureMeta(selectedFunction, "On_Time", "1", isBackground ? "" : "true", isBackground ? "" : "Execute(PBBN)");
                ensureMeta(selectedFunction, "Precise", "1", isBackground ? "" : "true", isBackground ? "" : "Execute(PBBN)");
                break;
        }

        ensureMeta(selectedFunction, "Variable", "", isBackground ? "" : "true", isBackground ? "" : "(On_Time<=0.5 || Precise<=0.5)?1:0");
    }
    private void applyLopaPreset(Function selectedFunction, string profile, bool isBackground)
    {
        var pfd = profile switch
        {
            "Human" => "0.01",
            "Organisational" => "0.003",
            "Technological" => "0.0001",
            "AI" => "0.001",
            _ => "0"
        };

        ensureMeta(selectedFunction, "PFD", pfd, "", "");
        ensureMeta(selectedFunction, "Psd", "", "true", "1-PFD");
        ensureMeta(selectedFunction, "Pso", "", "true", isBackground ? "1*Psd" : "Aprd_Pso*Psd");
        ensureMeta(selectedFunction, "Pfd2", "", "true", "1-Pso");
    }
    private void applyNeuronPreset(Function selectedFunction, string profile, bool isBackground)
    {
        var effectiveness = profile switch
        {
            "Human" => "0.99",
            "Organisational" => "0.99",
            "Technological" => "0.99999",
            "AI" => "0.9999",
            _ => "0.99"
        };

        var tolerability = profile switch
        {
            "Human" => "0.75",
            "Organisational" => "0.75",
            "Technological" => "0.99",
            "AI" => "0.9",
            _ => "0.75"
        };

        ensureMeta(selectedFunction, "Effectiveness", effectiveness, "", "");
        ensureMeta(selectedFunction, "Tolerability", tolerability, "", "");
        ensureMeta(selectedFunction, "Activate", "1", isBackground ? "" : "true", isBackground ? "" : "Amin_Effectiveness>=Tolerability?1:0");
        ensureMeta(selectedFunction, "Variable", "", isBackground ? "" : "true", isBackground ? "" : "Effectiveness<0.99?1:0");
    }
    private void ensureMeta(Function fn, string key, string value, string active, string equation)
    {
        var getMeta = fn.metadata;
        var existing = getMeta.Find(x => x[0] == key);
        if (existing is null)
        {
            existing = new string[] { key, value, active, equation, value };
            getMeta.Add(existing);
        }
        else
        {
            existing[1] = value;
            existing[2] = active;
            existing[3] = equation;
            existing[4] = value;
        }

        if (!stateContainer.metaDataKeys.ContainsKey(key))
        {
            stateContainer.metaDataKeys.Add(key, "");
        }
        stateContainer.metaDataKeys[key] = value;
        ensureMetadataColumns(key);
        updateMetadataRow(fn, key, value, active, equation);
    }
    private void ensureMetadataColumns(string key)
    {
        if (!stateContainer.metadataDS.Tables.Contains("Metadata"))
        {
            return;
        }

        var cols = stateContainer.metadataDS.Tables["Metadata"]!.Columns;
        if (!cols.Contains(key))
        {
            cols.Add(new DataColumn(key, typeof(string)));
        }
        if (!cols.Contains($"{key}-active"))
        {
            cols.Add(new DataColumn($"{key}-active", typeof(string)));
        }
        if (!cols.Contains($"{key}-equation"))
        {
            cols.Add(new DataColumn($"{key}-equation", typeof(string)));
        }
    }
    private void updateMetadataRow(Function fn, string key, string value, string active, string equation)
    {
        if (!stateContainer.metadataDS.Tables.Contains("Metadata"))
        {
            return;
        }

        var table = stateContainer.metadataDS.Tables["Metadata"]!;
        var row = table.Select($"IDNr = {fn.IDNr} and Cycle = -1").FirstOrDefault();
        if (row is null)
        {
            return;
        }

        row[key] = value;
        row[$"{key}-active"] = active;
        row[$"{key}-equation"] = equation;
    }
    private async void checkValidKey(ChangeEventArgs e, string keyName)
    {
        string checkKey = e.Value?.ToString() ?? "";
        var matchKey = Regex.Match(checkKey, "^[A-Z][A-Za-z0-9_]*$");
        if ((!matchKey.Success || matchKey.Value.Length != checkKey.Length) && checkKey.Length > 0)
        {
            var oldKey = checkKey.Substring(0, checkKey.Length - 1);
            await JSRuntime.InvokeVoidAsync("setInput", keyName, oldKey);
            //await JSRuntime.InvokeVoidAsync("alert", $"Key names must start with a capital letter and only contain letters, numbers, _ or |");
        }
    }
    private string cycleTooltip()
    {
        return $"Cycle limit {System.Environment.NewLine}0 = ∞ {System.Environment.NewLine}n = Cycle number{System.Environment.NewLine}[blank] = default";
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (!String.IsNullOrEmpty(stateContainer.lastKey) && gotoKey)
            {
                await JSRuntime.InvokeVoidAsync("focusInput", $"Key_{stateContainer.lastKey}");
                stateContainer.lastKey = "";
                gotoKey = false;
            }
        }
    }
    private async Task bFMI_dataImport(InputFileChangeEventArgs e)
    {
        var buffer = new byte[e.File.Size];
        await e.File.OpenReadStream(1050000).ReadAsync(buffer);
        stateContainer.dataRows = new List<string[]>();
        stateContainer.dataKeys = new Dictionary<string, string>();
        int i = 0;
        int j = 0;
        using (StringReader sr = new StringReader(Encoding.UTF8.GetString(buffer)))
        {
            string? line = null;
            while ((line = sr.ReadLine()) is not null)
            {
                stateContainer.dataRows.Add(line.Split(","));
                //previous for the lookup function, next loop for the xref function
                var colsN = stateContainer.dataRows[i].Length;
                for (j = 0; j < colsN; j++)
                {
                    stateContainer.dataKeys[$"{stateContainer.dataRows[i][0]},{stateContainer.dataRows[0][j]}"] = stateContainer.dataRows[i][j];
                    //Console.WriteLine($"{dataRows[i][0]},{dataRows[0][j]} = {dataKeys[dataRows[i][0] + "," + dataRows[0][j]]}");
                }
                i++;
            }
        }

    }
    private void variablesUpdateShow(FocusEventArgs e, string key)
    {
        stateContainer.showVariables = key;
        if (stateContainer.selectedFunction is not null)
        {
            //if (stateContainer.selectedFunction.getVariables().Count == 0)
            //{
            //Console.WriteLine($"-selectedFunction: {stateContainer.selectedFunction.IDName}");
            foreach (var coupling in stateContainer.couplingList.FindAll(x => x.toFn == stateContainer.selectedFn))
            {
                //Console.WriteLine($"--coupling: {coupling.Name}");
                var outputFn = stateContainer.functionList.Find(x => x.IDNr == coupling.outputFn);
                if (outputFn is not null)
                //Console.WriteLine($"---outputFn: {outputFn.IDName}");
                {
                    foreach (var meta in outputFn!.metadata)
                    {
                        //Console.WriteLine($"----metadata: Value of {meta[0]} On {coupling.toType} [{coupling.label}] From Function <{outputFn.IDName}>");
                        outputFn.newVariable(meta[0], new string[] { meta[1], $"Value of {meta[0]}" });
                        stateContainer.selectedFunction.newVariable($"{coupling.toType}{coupling.outputFn}_{meta[0]}", new string[] { meta[1], $"Value of {meta[0]}\nOn {coupling.toType} [{coupling.label}]\nFrom Function <{outputFn.IDName}>" });
                    }
                }
            }
            stateContainer.calcVariables(stateContainer.selectedFunction);
            //}
            // foreach (var Key in stateContainer.selectedFunction.getVariables().Keys)
            // {
            //     Console.WriteLine(Key);
            // }
            // Console.WriteLine($"\"{stateContainer.showVariables}\" == \"{key}\" = {stateContainer.showVariables == key}");
        }
    }
    private void highlightKey(FocusEventArgs e, string key)
    {
        bool refresh = false;
        foreach (var fn in stateContainer.functionList.FindAll(fn => fn.metadata.Count > 0))
        {
            if (fn.metadata.FindAll(x => x[0] == key).Count > 0)
            {
                fn.fmiHighlight = "hold-fill";
            }
            else
            {
                fn.fmiHighlight = "";
            }
            refresh = true;
        }
        if (refresh)
            refreshParent.InvokeAsync();
    }
    private async void addNewMetadata(ChangeEventArgs e)
    {
        var checkChar = e.Value?.ToString() ?? "";
        var matchChar = Regex.Match(checkChar, "^[A-Z][A-Za-z0-9_]*$");
        if (matchChar.Success && matchChar.Value.Length == checkChar.Length)
        {
            var getMeta = stateContainer.selectedFunction?.metadata;
            if (getMeta is not null)
            {
                var newKey = e.Value?.ToString() ?? $"New_{getMeta.Count}";
                getMeta.Add(new string[] { newKey, "", "", "", "" });
                stateContainer.metaIsDirty = true;
                if (!stateContainer.metaDataKeys.ContainsKey(newKey)) // FindIndex(x => x == newKey) == -1)
                {
                    stateContainer.metaDataKeys.Add(newKey,"");
                }
                var cols = stateContainer.metadataDS.Tables["Metadata"]?.Columns;
                if (cols is not null && !cols.Contains(newKey))
                {
                    cols.Add(new DataColumn(newKey, typeof(string)));
                    cols.Add(new DataColumn($"{newKey}-active", typeof(string)));
                    cols.Add(new DataColumn($"{newKey}-equation", typeof(string)));
                }
            }
            await JSRuntime.InvokeVoidAsync("clearInput", "New_Key");
        } 
        else
        {
            await JSRuntime.InvokeVoidAsync("clearInput", "New_Key");
        }
    }
    private async void keyCheckChange(ChangeEventArgs e, string oldKey)
    {
        var getMeta = stateContainer.selectedFunction?.metadata;
        if (getMeta is not null)
        {
            var getKeyMeta = getMeta.Find(x => x[0] == oldKey);
            if (getKeyMeta is not null)
            {
                var newKey = e.Value?.ToString();
                if (String.IsNullOrEmpty(newKey))
                {
                    if (String.IsNullOrEmpty($"{getKeyMeta[1]}{getKeyMeta[3]}")) //if new key name is empty (deleted) AND there is no value nor equation, then delete key from Function
                    {
                        getMeta.Remove(getKeyMeta);
                        stateContainer.metaIsDirty = true;
                    }
                    else //if there is a value or an equation then undo the edit and return the key name to the old value
                    {
                        await JSRuntime.InvokeVoidAsync("setInput", $"Key_{oldKey}", oldKey);
                    }
                }
                else //if new key name is not empty then update the key to the new name
                {
                    getKeyMeta[0] = newKey;
                    stateContainer.metaIsDirty = true;
                    if (!stateContainer.metaDataKeys.ContainsKey(newKey)) //.FindIndex(x => x == newKey) == -1)
                    {
                        stateContainer.metaDataKeys.Add(newKey,"");
                    }
                    var cols = stateContainer.metadataDS.Tables["Metadata"]?.Columns;
                    if (cols is not null && !cols.Contains(newKey))
                    {
                        cols.Add(new DataColumn(newKey, typeof(string)));
                        cols.Add(new DataColumn($"{newKey}-active", typeof(string)));
                        cols.Add(new DataColumn($"{newKey}-equation", typeof(string)));
                    }
                    //we are not going to search all functions to check if the old key can be removed from the Metadata Table, the columns will remain but not update, until the file is reopened and the Table is rebuilt
                }
            }
        }
    }
