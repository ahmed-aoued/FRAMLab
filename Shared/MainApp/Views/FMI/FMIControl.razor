    private async void addNewMetadata(ChangeEventArgs e)
    {
        var checkChar = e.Value?.ToString() ?? "";
        var matchChar = Regex.Match(checkChar, "^[A-Z][A-Za-z0-9_]*$");
        if (matchChar.Success && matchChar.Value.Length == checkChar.Length)
        {
            var getMeta = stateContainer.selectedFunction?.metadata;
            if (getMeta is not null)
            {
                var newKey = e.Value?.ToString() ?? $"New_{getMeta.Count}";
                getMeta.Add(new string[] { newKey, "", "", "", "" });
                stateContainer.metaIsDirty = true;
                if (!stateContainer.metaDataKeys.ContainsKey(newKey)) // FindIndex(x => x == newKey) == -1)
                {
                    stateContainer.metaDataKeys.Add(newKey,"");
                }
                var cols = stateContainer.metadataDS.Tables["Metadata"]?.Columns;
                if (cols is not null && !cols.Contains(newKey))
                {
                    cols.Add(new DataColumn(newKey, typeof(string)));
                    cols.Add(new DataColumn($"{newKey}-active", typeof(string)));
                    cols.Add(new DataColumn($"{newKey}-equation", typeof(string)));
                }
            }
            await JSRuntime.InvokeVoidAsync("clearInput", "New_Key");
        } 
        else
        {
            await JSRuntime.InvokeVoidAsync("clearInput", "New_Key");
        }
    }
    private async void keyCheckChange(ChangeEventArgs e, string oldKey)
    {
        var getMeta = stateContainer.selectedFunction?.metadata;
        if (getMeta is not null)
        {
            var getKeyMeta = getMeta.Find(x => x[0] == oldKey);
            if (getKeyMeta is not null)
            {
                var newKey = e.Value?.ToString();
                if (String.IsNullOrEmpty(newKey))
                {
                    if (String.IsNullOrEmpty($"{getKeyMeta[1]}{getKeyMeta[3]}")) //if new key name is empty (deleted) AND there is no value nor equation, then delete key from Function
                    {
                        getMeta.Remove(getKeyMeta);
                        stateContainer.metaIsDirty = true;
                    }
                    else //if there is a value or an equation then undo the edit and return the key name to the old value
                    {
                        await JSRuntime.InvokeVoidAsync("setInput", $"Key_{oldKey}", oldKey);
                    }
                }
                else //if new key name is not empty then update the key to the new name
                {
                    getKeyMeta[0] = newKey;
                    stateContainer.metaIsDirty = true;
                    if (!stateContainer.metaDataKeys.ContainsKey(newKey)) //.FindIndex(x => x == newKey) == -1)
                    {
                        stateContainer.metaDataKeys.Add(newKey,"");
                    }
                    var cols = stateContainer.metadataDS.Tables["Metadata"]?.Columns;
                    if (cols is not null && !cols.Contains(newKey))
                    {
                        cols.Add(new DataColumn(newKey, typeof(string)));
                        cols.Add(new DataColumn($"{newKey}-active", typeof(string)));
                        cols.Add(new DataColumn($"{newKey}-equation", typeof(string)));
                    }
                    //we are not going to search all functions to check if the old key can be removed from the Metadata Table, the columns will remain but not update, until the file is reopened and the Table is rebuilt
                }
            }
        }
    }
