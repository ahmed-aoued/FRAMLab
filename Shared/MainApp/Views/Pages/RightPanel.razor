@using MudBlazor
@inject StateContainer stateContainer
@inject IStringLocalizer<Localization.SharedResource> Loc

<div class="right-sidebar">
    <div class="v-panel rp-body">
        <div class="rp-head">
            <span class="rp-title">@PanelTitle()</span>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default"
                           title="@L("CLOSE", "Close")" OnClick=Close aria-label="@L("CLOSE", "Close")" />
        </div>

        @if (stateContainer.rightPanel == "agents-levels")
        {
            <div class="sb-title rp-section">@L("AGENTS", "Agents")</div>
            @if (stateContainer.agentList.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="d-block mt-1 mb-2" Style="color:var(--muted)">@L("NO_AGENTS", "No agents created.")</MudText>
            }
            @foreach (var agent in stateContainer.agentList)
            {
                <div class="right-sidebar-row">
                    <input type="color"
                           class="entity-color-input"
                           title="@L("AGENT_COLOR", "Agent color")"
                           value="@ColorValue(agent.Color)"
                           @onchange="@((e) => ChangeAgentColor(agent, e))" />
                    <div class="right-sidebar-row-text">
                        <span class="text-truncate">@agent.Name</span>
                        @if (!string.IsNullOrWhiteSpace(agent.AgentType))
                        {
                            <small class="text-muted">@agent.AgentType</small>
                        }
                    </div>
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Class="rp-delete"
                                   title="@L("DELETE_AGENT", "Delete agent")" OnClick="@(() => DeleteAgent(agent))" aria-label="@L("DELETE_AGENT", "Delete agent")" />
                </div>
            }
            <MudTextField T="string" @bind-Value="newAgentName" Label="@L("AGENT_NAME", "Agent name")"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" Immediate="true" />
            <MudTextField T="string" @bind-Value="newAgentType" Label="@L("AGENT_TYPE", "Type (optional)")"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-1" Immediate="true" />
            <label class="rp-color">@L("NEW_AGENT_COLOR", "Colour")<input type="color" class="entity-color-input" @bind="newAgentColor" /></label>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true" Class="mt-2" DropShadow="false"
                       Disabled="@(string.IsNullOrWhiteSpace(newAgentName))" OnClick=AddAgent>@L("ADD_AGENT", "Add agent")</MudButton>

            
            <div class="sb-title rp-section">@L("LEVELS", "Levels")</div>
            @if (stateContainer.levelList.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="d-block mt-1 mb-2" Style="color:var(--muted)">@L("NO_LEVELS", "No levels created.")</MudText>
            }
            @foreach (var level in stateContainer.levelList.OrderBy(l => l.Hierarchy).ThenBy(l => l.Name))
            {
                <div class="right-sidebar-row">
                    <input type="color"
                           class="entity-color-input"
                           title="@L("LEVEL_COLOR", "Level color")"
                           value="@ColorValue(level.Color)"
                           @onchange="@((e) => ChangeLevelColor(level, e))" />
                    <div class="right-sidebar-row-text">
                        <span class="text-truncate">@level.Name</span>
                        <small class="text-muted">@L("HIERARCHY", "Hierarchy") @level.Hierarchy</small>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Class="rp-delete"
                                   title="@L("DELETE_LEVEL", "Delete level")" OnClick="@(() => DeleteLevel(level))" aria-label="@L("DELETE_LEVEL", "Delete level")" />
                </div>
            }
            <MudTextField T="string" @bind-Value="newLevelName" Label="@L("LEVEL_NAME", "Level name")"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" Immediate="true" />
            <MudNumericField T="int" @bind-Value="newLevelHierarchy" Label="@L("HIERARCHY", "Hierarchy")" HelperText="@L("HIERARCHY_HINT", "0 = top row")"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-1" Immediate="true" />
            <label class="rp-color">@L("NEW_LEVEL_COLOR", "Colour")<input type="color" class="entity-color-input" @bind="newLevelColor" /></label>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true" Class="mt-2" DropShadow="false"
                       Disabled="@(string.IsNullOrWhiteSpace(newLevelName))" OnClick=AddLevel>@L("ADD_LEVEL", "Add level")</MudButton>
        }
    </div>
</div>

@code {
    [Parameter]
    public EventCallback refreshParent { get; set; }

    private string L(string key, string fallback)
    {
        var value = Loc[key];
        return value.ResourceNotFound ? fallback : value.Value;
    }

    private string newAgentName = "";
    private string newAgentType = "";
    private string newAgentColor = "#F3F3F3";
    private string newLevelName = "";
    private int newLevelHierarchy = 0;
    private string newLevelColor = "#F3F3F3";

    private string PanelTitle() => stateContainer.rightPanel switch
    {
        "agents-levels" => "Agents & Levels",
        _ => ""
    };

    private void OpenPanel(string panel)
    {
        stateContainer.rightPanel = panel;
        refreshParent.InvokeAsync();
    }

    private void Close()
    {
        stateContainer.rightPanel = "";
        refreshParent.InvokeAsync();
    }

    private void AddAgent()
    {
        if (string.IsNullOrWhiteSpace(newAgentName)) return;
        stateContainer.CreateAgent(newAgentName.Trim(), newAgentType.Trim(), newAgentColor);
        newAgentName = "";
        newAgentType = "";
        newAgentColor = "#F3F3F3";
        refreshParent.InvokeAsync();
    }

    private void DeleteAgent(Agent agent)
    {
        stateContainer.RemoveAgent(agent.IDNr);
        refreshParent.InvokeAsync();
    }

    private void AddLevel()
    {
        if (string.IsNullOrWhiteSpace(newLevelName)) return;
        stateContainer.CreateLevel(newLevelName.Trim(), newLevelHierarchy, newLevelColor);
        newLevelName = "";
        newLevelHierarchy = 0;
        newLevelColor = "#F3F3F3";
        refreshParent.InvokeAsync();
    }

    private void DeleteLevel(Level level)
    {
        stateContainer.RemoveLevel(level.IDNr);
        refreshParent.InvokeAsync();
    }

    private void ChangeAgentColor(Agent agent, ChangeEventArgs e)
    {
        stateContainer.UpdateAgentColor(agent, ColorValue(e.Value?.ToString()));
        refreshParent.InvokeAsync();
    }

    private void ChangeLevelColor(Level level, ChangeEventArgs e)
    {
        stateContainer.UpdateLevelColor(level, ColorValue(e.Value?.ToString()));
        refreshParent.InvokeAsync();
    }

    private static string ColorValue(string? color)
    {
        if (!string.IsNullOrWhiteSpace(color) &&
            color.StartsWith("#") &&
            color.Length == 7)
        {
            return color;
        }
        return "#F3F3F3";
    }
}
