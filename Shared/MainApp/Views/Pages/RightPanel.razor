@inject StateContainer stateContainer

<div class="right-sidebar">
    <div class="v-panel pr-2">
        <div class="d-flex align-items-center justify-content-between pb-2">
            <strong>@PanelTitle()</strong>
            <button class="btn btn-menu oi oi-x" title="Close" @onclick=Close></button>
        </div>

        <div class="right-menu-tabs mb-2">
            <button class="btn btn-half @(stateContainer.rightPanel == "agents-levels" ? "active" : "")"
                    title="Agents & Levels"
                    @onclick="@(() => OpenPanel("agents-levels"))">
                AL
            </button>
        </div>

        @if (stateContainer.rightPanel == "agents-levels")
        {
            <hr class="mt-0 mb-2" />
            <strong>Agents</strong>
            @if (stateContainer.agentList.Count == 0)
            {
                <small class="text-muted d-block mt-1 mb-2">No agents created.</small>
            }
            @foreach (var agent in stateContainer.agentList)
            {
                <div class="right-sidebar-row">
                    <input type="color"
                           class="entity-color-input"
                           title="Agent color"
                           value="@ColorValue(agent.Color)"
                           @onchange="@((e) => ChangeAgentColor(agent, e))" />
                    <div class="right-sidebar-row-text">
                        <span class="text-truncate">@agent.Name</span>
                        @if (!string.IsNullOrWhiteSpace(agent.AgentType))
                        {
                            <small class="text-muted">@agent.AgentType</small>
                        }
                    </div>
                    <button class="btn btn-link text-danger p-0" title="Delete agent"
                            @onclick="@(() => DeleteAgent(agent))">
                        <span class="oi oi-trash"></span>
                    </button>
                </div>
            }
            <input type="text" class="form-control form-control-sm mt-2" placeholder="Agent name" @bind="newAgentName" />
            <input type="text" class="form-control form-control-sm mt-1" placeholder="Type (optional)" @bind="newAgentType" />
            <input type="color" class="form-control form-control-sm mt-1 entity-color-input-wide" title="New agent color" @bind="newAgentColor" />
            <button class="btn btn-sm btn-outline-secondary mt-1 w-100" disabled="@(string.IsNullOrWhiteSpace(newAgentName))" @onclick=AddAgent>Add agent</button>

            <hr class="mt-3 mb-2" />
            <strong>Levels</strong>
            @if (stateContainer.levelList.Count == 0)
            {
                <small class="text-muted d-block mt-1 mb-2">No levels created.</small>
            }
            @foreach (var level in stateContainer.levelList.OrderBy(l => l.Hierarchy).ThenBy(l => l.Name))
            {
                <div class="right-sidebar-row">
                    <input type="color"
                           class="entity-color-input"
                           title="Level color"
                           value="@ColorValue(level.Color)"
                           @onchange="@((e) => ChangeLevelColor(level, e))" />
                    <div class="right-sidebar-row-text">
                        <span class="text-truncate">@level.Name</span>
                        <small class="text-muted">Hierarchy @level.Hierarchy</small>
                    </div>
                    <button class="btn btn-link text-danger p-0" title="Delete level"
                            @onclick="@(() => DeleteLevel(level))">
                        <span class="oi oi-trash"></span>
                    </button>
                </div>
            }
            <input type="text" class="form-control form-control-sm mt-2" placeholder="Level name" @bind="newLevelName" />
            <input type="number" class="form-control form-control-sm mt-1" placeholder="Hierarchy" @bind="newLevelHierarchy" />
            <input type="color" class="form-control form-control-sm mt-1 entity-color-input-wide" title="New level color" @bind="newLevelColor" />
            <button class="btn btn-sm btn-outline-secondary mt-1 w-100" disabled="@(string.IsNullOrWhiteSpace(newLevelName))" @onclick=AddLevel>Add level</button>
        }
    </div>
</div>

@code {
    [Parameter]
    public EventCallback refreshParent { get; set; }

    private string newAgentName = "";
    private string newAgentType = "";
    private string newAgentColor = "#F3F3F3";
    private string newLevelName = "";
    private int newLevelHierarchy = 0;
    private string newLevelColor = "#F3F3F3";

    private string PanelTitle() => stateContainer.rightPanel switch
    {
        "agents-levels" => "Agents & Levels",
        _ => ""
    };

    private void OpenPanel(string panel)
    {
        stateContainer.rightPanel = panel;
        refreshParent.InvokeAsync();
    }

    private void Close()
    {
        stateContainer.rightPanel = "";
        refreshParent.InvokeAsync();
    }

    private void AddAgent()
    {
        if (string.IsNullOrWhiteSpace(newAgentName)) return;
        stateContainer.CreateAgent(newAgentName.Trim(), newAgentType.Trim(), newAgentColor);
        newAgentName = "";
        newAgentType = "";
        newAgentColor = "#F3F3F3";
        refreshParent.InvokeAsync();
    }

    private void DeleteAgent(Agent agent)
    {
        stateContainer.RemoveAgent(agent.IDNr);
        refreshParent.InvokeAsync();
    }

    private void AddLevel()
    {
        if (string.IsNullOrWhiteSpace(newLevelName)) return;
        stateContainer.CreateLevel(newLevelName.Trim(), newLevelHierarchy, newLevelColor);
        newLevelName = "";
        newLevelHierarchy = 0;
        newLevelColor = "#F3F3F3";
        refreshParent.InvokeAsync();
    }

    private void DeleteLevel(Level level)
    {
        stateContainer.RemoveLevel(level.IDNr);
        refreshParent.InvokeAsync();
    }

    private void ChangeAgentColor(Agent agent, ChangeEventArgs e)
    {
        stateContainer.UpdateAgentColor(agent, ColorValue(e.Value?.ToString()));
        refreshParent.InvokeAsync();
    }

    private void ChangeLevelColor(Level level, ChangeEventArgs e)
    {
        stateContainer.UpdateLevelColor(level, ColorValue(e.Value?.ToString()));
        refreshParent.InvokeAsync();
    }

    private static string ColorValue(string? color)
    {
        if (!string.IsNullOrWhiteSpace(color) &&
            color.StartsWith("#") &&
            color.Length == 7)
        {
            return color;
        }
        return "#F3F3F3";
    }
}
