    private void NextFn(KeyboardEventArgs e)
    {
        if (!e.Repeat && !e.MetaKey && !e.AltKey && !e.CtrlKey)
        {
            if (e.Key == "Escape")
            {
                if (focusCheck == "zoomF") { stateContainer.tempZoomF = 1; refreshParent.InvokeAsync(); }
                else if (focusCheck == "zoomA") { stateContainer.tempZoomA = 1; refreshParent.InvokeAsync(); }
                else { FocusElement("newFnButton"); }
            }
            else { nextFn.InvokeAsync(e); }
        }
    }
    public async void FocusElement(string elementName) => await JSRuntime.InvokeVoidAsync("focusInput", elementName);
