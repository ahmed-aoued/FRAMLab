@using MudBlazor
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject StateContainer stateContainer
@inject IConfiguration render
@inject IStringLocalizer<Localization.SharedResource> Loc
@using System.Linq
@using System.Globalization

<div class="sidebar">
    <div class="v-panel pr-2">
        @if (stateContainer.showKeys != "")
        {
            <hr class="mt-0 mb-0" />
            <FMIControl Mode="@stateContainer.activeMode" refreshParent="@(EventCallback.Factory.Create(this, updateAll))" />
            <hr class="mt-2 mb-2" />
        }
        <div class="d-flex pt-2 pb-0 align-start">
            <div class="d-flex flex-column sidebar-btn-col">
                <MudIconButton id="newFnButton" Icon="@Icons.Material.Filled.Add" Color="Color.Primary" Size="Size.Medium"
                               title="@Loc["NEW_TOOLTIP"]" tabindex="3" OnClick=newFunction
                               @onfocusin=@(() => stateContainer.isDisabled = false) @onkeyup=NextFn
                               aria-label="@Loc["NEW_TOOLTIP"]" Class="sidebar-new-fn" />
                <div class="d-flex">
                    <button class="btn btn-half btn-half-s" title=@Loc["FN_FONT_DECREASE"] tabindex="1" @onclick=zoomFs @onfocusin=zoomFin @onfocusout=zoomFout @onkeyup=NextFn>A</button>
                    <button class="btn btn-half btn-half-l" title=@Loc["FN_FONT_INCREASE"] tabindex="2" @onclick=zoomFl @onfocusin=zoomFin @onfocusout=zoomFout @onkeyup=NextFn>A</button>
                </div>
            </div>
            <div class="flex-grow-1">
                <MudTextField @key="@("fnname-" + stateContainer.selectedFn)" T="string"
                              Value="@stateContainer.fnName" ValueChanged="OnFnNameChanged"
                              Label="@Loc["NAME_FN"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Disabled="@stateContainer.isDisabled" tabindex="4"
                              Immediate="false" Class="sidebar-fn-name" />
            </div>
        </div>
        <div class="d-flex pt-1 align-start">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Default"
                           title="@Loc["FN_DESCRIPTION"]" OnClick=expandDesc aria-label="@Loc["FN_DESCRIPTION"]" Class="sidebar-desc-toggle" />
            <div class="flex-grow-1">
                <MudTextField @key="@("fndesc-" + stateContainer.selectedFn)" T="string"
                              Value="@(stateContainer.selectedFunction?.Description ?? "")" ValueChanged="OnFnDescChanged"
                              Label="@Loc["FN_DESCRIPTION"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Disabled="@stateContainer.isDisabled" tabindex="5"
                              Lines="@(descriptionClass == "fmi-descE" ? 5 : 2)" Class="sidebar-fn-desc" />
            </div>
        </div>
        <div class="d-flex pt-2">
            <div class="d-flex flex-column align-items-center">
                <button id="newOButton" class="btn btn-menu btn-textp" title=@Loc["OUTPUT"] tabindex="5" @onclick="@((e) => NewAspect(e, "Output"))" @onkeyup=NextFn>O</button>
                <input type="text" name="fnProfileInput" class="btn btn-menu btn-menu-s" title=@profileFnTooltip() tabindex="27" value=@showFnProfile() disabled=@disableFnProfile() @onchange="@((e) => changeFnProfile(e, "Fn"))">
            </div>
            @if (stateContainer.selectedFn != "-1")
            {
                GetNodesO = stateContainer.outputsList.FindAll(x => x.Type == "Output" && x.FunctionIDNr == stateContainer.selectedFn);
                if (GetNodesO.Count > 0)
                {
                    var aspect = GetNodesO[0];
                    <div class="autocomplete-wrapper">
                        <input class="aspect-input @(aspect.Orphan=="true"?"aspect-orphan":"")"
                               type="text" name="@($"output-{aspect.IDNr}")"
                               @ref="aspect.elementReference"
                               tabindex="6"
                               value="@aspect.IDName"
                               @oninput="@(e => HandleAspectInput(e, "Output", aspect.IDNr))"
                               @onkeydown="@(e => HandleAspectKeyDown(e, "Output", aspect.IDNr))"
                               @onfocus="@(e => OpenDropdown("Output", aspect.IDNr))"
                               @onblur="@(async () => await HandleBlur("Output", aspect.IDNr))"
                               @onchange="@(e => CommitAspect(e, "Output", aspect.IDNr))" />
                        <button class="dropdown-btn" tabindex="-1"
                                @onclick="@(async () => await ButtonClick("Output", aspect.IDNr, aspect.elementReference))"
                                @onmousedown:preventDefault @onmousedown:stopPropagation
                                type="button">▼</button>
                        @if (IsDropdownOpen("Output", aspect.IDNr))
                        {
                            <ul class="suggestion-list" @onkeydown="@(e => SuggestionKeyDown(e, "Output", aspect.IDNr))">
                                @foreach (var item in GetFilteredExisting("Output", aspectFilterText))
                                {
                                    int idx = suggestionsActiveList.IndexOf(item);
                                    <li class="suggestion-item @(suggestionsActiveIndex == idx ? "active" : "")"
                                        @onclick="@(() => SelectSuggestion("Output", aspect.IDNr, item))"
                                        @onmouseover="@(() => suggestionsActiveIndex = idx)">@item</li>
                                }
                            </ul>
                        }
                    </div>
                }
            }
            else
            {
                GetNodesO = null;
            }
        </div>
        @if (GetNodesO is not null && GetNodesO.Count > 1)
        {
            int ListCount = 0;
            @foreach (var aspect in GetNodesO)
