                }
            </div>
        </div>
        <!-- Zoom and color buttons -->
        <div class="d-flex pt-2 align-center">
            <button class="btn btn-half btn-half-s" title=@Loc["ASPECT_FONT_DECREASE"] tabindex="23" @onclick=zoomAs @onfocusin=zoomAin @onfocusout=zoomAout @onkeyup=NextFn>A</button>
            <button class="btn btn-half btn-half-l" title=@Loc["ASPECT_FONT_INCREASE"] tabindex="24" @onclick=zoomAl @onfocusin=zoomAin @onfocusout=zoomAout @onkeyup=NextFn>A</button>
            <MudIconButton Icon="@Icons.Material.Filled.Palette" Color="Color.Primary" Size="Size.Medium"
                           title="@Loc["FN_COLOUR"]" tabindex="25" OnClick="ModalColor" @onkeyup="ModalKey"
                           aria-label="@Loc["FN_COLOUR"]" Class="ml-1" />
        </div>
        <div class="d-flex pt-2 align-center">
            @if (stateContainer.selectedFn != "-1")
            {
                @* Stash the model on pointer-down, then open the IDE. The click handler is explicit
                   so that browsers/embedded views that suppress window.open (target="_blank") still
                   navigate to the IDE in the current tab instead of silently doing nothing. *@
                <a class="btn btn-menu oi oi-puzzle-piece ml-1" title="Script (ST)" tabindex="27"
                   href="@ScriptEditorUrl"
                   @onpointerdown="PrepareScriptIDE"
                   @onclick="OpenScriptIDE"
                   @onclick:preventDefault></a>
            }
            else
            {
                <button class="btn btn-menu oi oi-puzzle-piece ml-1" title="Script (ST) - select a function first" tabindex="27" disabled></button>
            }
        </div>
        @if (stateContainer.showKeys == "")
        {
            <hr class="mt-2 mb-0" />
            <FMIControl Mode="@stateContainer.activeMode" refreshParent="@(EventCallback.Factory.Create(this, updateAll))" />
