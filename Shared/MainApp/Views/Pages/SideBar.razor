                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary"
                                           Variant="Variant.Outlined" title="Add level to function"
                                           OnClick=AssignLevel Disabled="@(string.IsNullOrEmpty(selectedLevelId))" aria-label="Add level to function" />
