    </div>
</div>

@code {
    [Parameter]
    public EventCallback refreshParent { get; set; }
    [Parameter]
    public EventCallback newFunction { get; set; }
    [Parameter]
    public EventCallback<KeyboardEventArgs> nextFn { get; set; }

    private List<Aspect>? GetNodesI;
    private List<Aspect>? GetNodesO;
    private List<Aspect>? GetNodesT;
    private List<Aspect>? GetNodesC;
    private List<Aspect>? GetNodesP;
    private List<Aspect>? GetNodesR;
    private string setFocus = "";
    private string focusCheck = "";
    private string oldZoomText = "";
    private string descriptionClass = "fmi-descS";

    // Agent / Level assignment state
    private bool showAgentPanel = true;
    private bool showLevelPanel = true;
    private string selectedAgentId = "";
    private string selectedLevelId = "";
    private string newAgentName = "";
    private string newLevelName = "";

    private string ScriptEditorUrl => $"scripteditor/{stateContainer.selectedFn}";

    // Runs on pointer-down (before the IDE opens), stashing the current model in
    // localStorage for the IDE page to load.
    private async Task PrepareScriptIDE()
    {
        if (stateContainer.selectedFn == "-1"
            || stateContainer.projectData_Undo is not { Length: > 0 }
            || stateContainer.projectData_Undo[0] is null)
        {
            return;
        }
        await JSRuntime.InvokeVoidAsync("ScriptSync.prepare",
            stateContainer.projectData_Undo[0].OuterXml, stateContainer.selectedFn, stateContainer.fileName);
    }

    // Opens the Script IDE. Prefers a new tab, but if the environment blocks popups
    // (VS Code's embedded browser, PWAs, strict popup blockers) it navigates in place
    // so the button always has a visible effect.
    private async Task OpenScriptIDE()
    {
        if (stateContainer.selectedFn == "-1")
        {
            return;
        }
        await PrepareScriptIDE();

        var opened = false;
        try
        {
            opened = await JSRuntime.InvokeAsync<bool>("ScriptSync.open", ScriptEditorUrl);
        }
        catch (Exception)
        {
            // JS interop unavailable - fall through to in-place navigation.
        }

        if (!opened)
        {
            Nav.NavigateTo(ScriptEditorUrl);
        }
    }

    // Autocomplete state
    private string openDropdownType = "";
    private string openDropdownId = "";
    private string aspectFilterText = "";
    private List<string> suggestionsActiveList = new();
    private int suggestionsActiveIndex = -1;

    // Blur-Schutz für den Dreiecksknopf
    private readonly HashSet<string> pendingBlurIgnore = new();
    // Schutz vor Löschung eines leeren Aspekts, solange eine Neuanlage im Gange ist
    private readonly Dictionary<string, bool> pendingAspectCreation = new();

    private IEnumerable<string> GetExistingAspectNames(string type)
    {
        if (type == "Output")
            return stateContainer.outputsList
                .Where(o => !string.IsNullOrEmpty(o.IDName))
                .Select(o => o.IDName)
                .Distinct();
        else
            return stateContainer.aspectsList
                .Where(a => a.Type == type && !string.IsNullOrEmpty(a.IDName))
                .Select(a => a.IDName)
                .Distinct();
    }

    private List<string> GetFilteredExisting(string type, string filter)
    {
        var all = GetExistingAspectNames(type).ToList();
        if (string.IsNullOrWhiteSpace(filter))
            return all.OrderBy(s => s).ToList();
        return all.Where(s => s.StartsWith(filter, StringComparison.OrdinalIgnoreCase))
            .OrderBy(s => s).ToList();
    }

    private bool IsDropdownOpen(string type, string id) =>
        openDropdownType == type && openDropdownId == id;

    private void OpenDropdown(string type, string id)
    {
        openDropdownType = type;
        openDropdownId = id;
        UpdateSuggestions(type, id);
    }

    private void CloseDropdownDelayed()
    {
        _ = CloseAfterDelay();
    }

    private async Task CloseAfterDelay()
    {
        await Task.Delay(150);
        if (openDropdownType != "")
        {
            openDropdownType = "";
            openDropdownId = "";
            suggestionsActiveList.Clear();
            suggestionsActiveIndex = -1;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleDropdown(string type, string id)
    {
        if (IsDropdownOpen(type, id))
            openDropdownType = "";
        else
            OpenDropdown(type, id);
    }

    private void HandleAspectInput(ChangeEventArgs e, string type, string id)
    {
        aspectFilterText = e.Value?.ToString() ?? "";
        OpenDropdown(type, id);
        UpdateSuggestions(type, id);
    }

    private void HandleAspectKeyDown(KeyboardEventArgs e, string type, string id)
    {
        if (!IsDropdownOpen(type, id)) return;

        switch (e.Key)
        {
            case "ArrowDown":
                if (suggestionsActiveList.Count == 0) return;
                suggestionsActiveIndex = Math.Min(suggestionsActiveIndex + 1, suggestionsActiveList.Count - 1);
                break;
            case "ArrowUp":
                if (suggestionsActiveList.Count == 0) return;
                suggestionsActiveIndex = Math.Max(suggestionsActiveIndex - 1, 0);
                break;
            case "Enter":
                if (suggestionsActiveIndex >= 0 && suggestionsActiveIndex < suggestionsActiveList.Count)
                {
                    SelectSuggestionInternal(type, id, suggestionsActiveList[suggestionsActiveIndex]);
                }
                else if (suggestionsActiveList.Count == 1)
                {
                    SelectSuggestionInternal(type, id, suggestionsActiveList[0]);
                }
                else if (!string.IsNullOrWhiteSpace(aspectFilterText))
                {
                    AspectChangeCommitt(aspectFilterText, id, type);
                    openDropdownType = "";
                    openDropdownId = "";
                    suggestionsActiveList.Clear();
                    suggestionsActiveIndex = -1;
                    checkForBackground();
                    refreshParent.InvokeAsync();
                }
                break;
            case "Escape":
                openDropdownType = "";
                openDropdownId = "";
                suggestionsActiveList.Clear();
                suggestionsActiveIndex = -1;
                break;
        }
    }

    private void SuggestionKeyDown(KeyboardEventArgs e, string type, string id)
    {
        HandleAspectKeyDown(e, type, id);
    }

    private void SelectSuggestion(string type, string id, string item)
    {
        SelectSuggestionInternal(type, id, item);
    }

    private void SelectSuggestionInternal(string type, string id, string item)
    {
        aspectFilterText = item;
        AspectChangeCommitt(item, id, type);
        openDropdownType = "";
        openDropdownId = "";
        suggestionsActiveList.Clear();
        suggestionsActiveIndex = -1;
        refreshParent.InvokeAsync();
    }

    private void UpdateSuggestions(string type, string id)
    {
        suggestionsActiveList = GetFilteredExisting(type, aspectFilterText);
        suggestionsActiveIndex = suggestionsActiveList.Count > 0 ? 0 : -1;
        StateHasChanged();
    }

    private void CommitAspect(ChangeEventArgs e, string type, string id)
    {
        stateContainer.updateUndo();
        var value = e.Value?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(value))
        {
            AspectChangeCommitt(value, id, type);
        }
        else
        {
            DeleteAspect(type, id);
        }
        checkForBackground();
        refreshParent.InvokeAsync();
    }

    private async Task ButtonClick(string type, string id, ElementReference inputRef)
    {
        pendingBlurIgnore.Add($"{type}|{id}");
        await inputRef.FocusAsync();
        if (IsDropdownOpen(type, id))
        {
            openDropdownType = "";
            openDropdownId = "";
        }
        else
        {
            OpenDropdown(type, id);
        }
        _ = Task.Run(async () =>
        {
            await Task.Delay(200);
            pendingBlurIgnore.Remove($"{type}|{id}");
            await InvokeAsync(StateHasChanged);
        });
        StateHasChanged();
    }

    private async Task HandleBlur(string type, string id)
    {
        if (pendingBlurIgnore.Contains($"{type}|{id}") || pendingAspectCreation.TryGetValue(type, out var val) && val)
        {
            return;
        }
        AspectBlank(type, id);
        CloseDropdownDelayed();
    }

    private void ToggleAgentPanel() => showAgentPanel = !showAgentPanel;
    private void ToggleLevelPanel() => showLevelPanel = !showLevelPanel;

    private void AssignAgent()
    {
        if (stateContainer.selectedFunction is null || string.IsNullOrEmpty(selectedAgentId)) return;
        stateContainer.AssignAgentToFunction(stateContainer.selectedFunction, selectedAgentId);
        selectedAgentId = "";
        refreshParent.InvokeAsync();
    }
    private void ClearAgent()
    {
        if (stateContainer.selectedFunction is null) return;
        stateContainer.ClearAgentFromFunction(stateContainer.selectedFunction);
        refreshParent.InvokeAsync();
    }
    private void CreateAndAssignAgent()
    {
        if (stateContainer.selectedFunction is null || string.IsNullOrWhiteSpace(newAgentName)) return;
        var agent = stateContainer.CreateAgent(newAgentName.Trim());
        stateContainer.AssignAgentToFunction(stateContainer.selectedFunction, agent.IDNr);
        newAgentName = "";
        refreshParent.InvokeAsync();
    }

    private void AssignLevel()
    {
        if (stateContainer.selectedFunction is null || string.IsNullOrEmpty(selectedLevelId)) return;
        stateContainer.AssignLevelToFunction(stateContainer.selectedFunction, selectedLevelId);
        selectedLevelId = "";
        refreshParent.InvokeAsync();
    }
    private void ClearLevel()
    {
        if (stateContainer.selectedFunction is null) return;
        stateContainer.ClearLevelFromFunction(stateContainer.selectedFunction);
        refreshParent.InvokeAsync();
    }
    private void CreateAndAssignLevel()
    {
        if (stateContainer.selectedFunction is null || string.IsNullOrWhiteSpace(newLevelName)) return;
        var level = stateContainer.CreateLevel(newLevelName.Trim());
        stateContainer.AssignLevelToFunction(stateContainer.selectedFunction, level.IDNr);
        newLevelName = "";
        refreshParent.InvokeAsync();
    }

    protected void updateAll()
    {
        refreshParent.InvokeAsync();
    } 
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (setFocus != "")
            {
                try
                {
                    if (setFocus == "Output")
                    {
                        await stateContainer.outputsList.FindLast(x => x.Type == setFocus && x.FunctionIDNr == stateContainer.selectedFn)!.elementReference.FocusAsync();
                    }
                    else
                    {
                        await stateContainer.aspectsList.FindLast(x => x.Type == setFocus && x.FunctionIDNr == stateContainer.selectedFn)!.elementReference.FocusAsync();
                    }
                }
                catch { }
                setFocus = "";
            }
        }
    }
    private void changeFnProfile(ChangeEventArgs e, string type)
    {
        if (stateContainer.selectedFunction is not null)
        {
            stateContainer.updateUndo();
            var tempFnProfile = e.Value?.ToString() ?? "";
            stateContainer.selectedFunction.profileFn = tempFnProfile;
            stateContainer.projectData_Undo[0].SelectSingleNode($"//FM/Functions/Function[IDNr={stateContainer.selectedFn}]/@profileFn")!.InnerText = tempFnProfile;
        }
    }
    private void changeProfile(string type)
    {
        if (stateContainer.selectedFunction is not null)
        {
            stateContainer.updateUndo();
            // T button stays rendered but does nothing
            if (type == "T") return;
            var getProfile = "";
            switch (type)
            {
                case "Fn": getProfile = stateContainer.selectedFunction.profileFn; break;
                case "I": getProfile = Function.ProfileToString(stateContainer.selectedFunction.PrInputs); break;
                case "P": getProfile = Function.ProfileToString(stateContainer.selectedFunction.PrPreconditions); break;
                case "R": getProfile = Function.ProfileToString(stateContainer.selectedFunction.PrResources); break;
                case "C": getProfile = Function.ProfileToString(stateContainer.selectedFunction.PrControls); break;
                default: getProfile = ""; break;
            }
            switch (getProfile)
            {
                case "All": getProfile = "Any"; break;
                case "Any": if (type == "I") { getProfile = ""; } else { getProfile = "None"; } break;
                case "None": getProfile = ""; break;
                case "": getProfile = "All"; break;
                default: getProfile = ""; break;
            }
            stateContainer.projectData_Undo[0].SelectSingleNode($"//FM/Functions/Function[IDNr=\"{stateContainer.selectedFn}\"]/@profile{type}")!.InnerText = getProfile;
            switch (type)
            {
                case "Fn": stateContainer.selectedFunction.profileFn = getProfile; break;
                case "I": stateContainer.selectedFunction.PrInputs = Function.ParseProfile(getProfile); break;
                case "P": stateContainer.selectedFunction.PrPreconditions = Function.ParseProfile(getProfile); break;
                case "R": stateContainer.selectedFunction.PrResources = Function.ParseProfile(getProfile); break;
                case "C": stateContainer.selectedFunction.PrControls = Function.ParseProfile(getProfile); break;
            }
        }
    }
    private string profileTooltip()
    {
        return Loc["FMI_PROFILE_SHORT"] + System.Environment.NewLine + Loc["FMI_ALL"] + System.Environment.NewLine + Loc["FMI_ANY"] + System.Environment.NewLine + Loc["FMI_NONE"];
    }
    private string profileITooltip()
    {
        return Loc["FMI_PROFILE_SHORT"] + System.Environment.NewLine + Loc["FMI_ALL"] + System.Environment.NewLine + Loc["FMI_ANY"];
    }
    private string profileFnTooltip()
    {
        return Loc["FMI_PROFILE_SHORT"] + System.Environment.NewLine + Loc["FMI_INITIAL_ONLY"] + System.Environment.NewLine + Loc["FMI_EVERY_NTH"] + System.Environment.NewLine + Loc["FMI_RANDOM"];
    }
    private bool disableFnProfile()
    {
        var returnFnDisabled = true;
        if (stateContainer.selectedFn != "-1" && stateContainer.selectedFunction is not null)
        {
            if (stateContainer.selectedFunction.fmiType == "Entry") returnFnDisabled = false;
        }
        return returnFnDisabled;
    }
    private bool disableAspectProfile()
    {
        var returnAspectDisabled = true;
        if (stateContainer.selectedFn != "-1" && stateContainer.selectedFunction is not null)
        {
            var checkType = stateContainer.selectedFunction.fmiType;
            if (checkType == "Exit" || checkType == "Passthrough" || checkType == "Foreground") returnAspectDisabled = false;
        }
        return returnAspectDisabled;
    }
    private string showFnProfile()
    {
        if (stateContainer.selectedFn != "-1" && stateContainer.selectedFunction is not null)
        {
            if (!string.IsNullOrEmpty(stateContainer.selectedFunction.profileFn))
                return stateContainer.selectedFunction.profileFn;
        }
        return "";
    }
    RenderFragment showProfile(string type)
    {
        if (stateContainer.selectedFunction is not null)
        {
            // T button renders but has no associated enum property
            if (type == "T") return @<a></a>;
            var getProfile = "";
            switch (type)
            {
                case "I": getProfile = Function.ProfileToString(stateContainer.selectedFunction.PrInputs); break;
                case "P": getProfile = Function.ProfileToString(stateContainer.selectedFunction.PrPreconditions); break;
                case "R": getProfile = Function.ProfileToString(stateContainer.selectedFunction.PrResources); break;
                case "C": getProfile = Function.ProfileToString(stateContainer.selectedFunction.PrControls); break;
                default: getProfile = ""; break;
            }
            switch (getProfile)
            {
                case "All": return @<a>&forall;</a>;
                case "Any": return @<a>&exist;</a>;
                case "None": return @<a>&empty;</a>;
                case "": return @<a></a>;
                default: return @<a></a>;
            }
        }
        else
        {
            return @<a></a>;
        }
    }
    private void ModalColor()
    {
