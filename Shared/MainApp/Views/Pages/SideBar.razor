@using MudBlazor
@inject IJSRuntime JSRuntime
@inject NavigationManager Nav
@inject StateContainer stateContainer
@inject IConfiguration render
@inject IStringLocalizer<Localization.SharedResource> Loc
@using System.Linq
@using System.Globalization

<aside class="inspector @(stateContainer.phonePanelOpen ? "inspector-phone-open" : "")" aria-label="@L("INSPECTOR", "Inspector")">
    <div class="insp-tabs" role="tablist">
        @foreach (var (tab, label, icon) in Tabs)
        {
            <button type="button" role="tab" aria-selected="@(stateContainer.inspectorTab == tab)" class="insp-tab @(stateContainer.inspectorTab == tab ? "active" : "")"
                    @onclick="@(() => SetTab(tab))">
                <MudIcon Icon="@icon" Size="Size.Small" />@label
            </button>
        }
    </div>
    <div class="insp-body">
        @if (stateContainer.inspectorTab == "function")
        {
            @if (!HasSelection)
            {
                <div class="insp-empty">
                    <svg class="insp-empty-mark" viewBox="0 0 100 100" aria-hidden="true"><path d="M 8 50 L 29 13.6 L 71 13.6 L 92 50 L 71 86.4 L 29 86.4 Z" /></svg>
                    <p>@L("SELECT_FN_HINT", "Select a function on the canvas, or create a new one, to edit its aspects.")</p>
                    @if (stateContainer.selectedMulti.Count > 1)
                    {
                        <p><strong>@stateContainer.selectedMulti.Count</strong> @L("FUNCTIONS_SELECTED", "functions selected.")</p>
                        <button type="button" class="sb-btn sb-btn-tonal" @onclick="ModalColor"><MudIcon Icon="@Icons.Material.Filled.Palette" Size="Size.Small" />@L("COLOUR_BUTTON", "Colour")</button>
                    }
                </div>
            }
            else
            {
                <MudTextField @key="@("fnname-" + stateContainer.selectedFn)" T="string" InputId="fnNameText"
                              Value="@stateContainer.fnName" ValueChanged="OnFnNameChanged"
                              Label="@Loc["NAME_FN"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Disabled="@stateContainer.isDisabled" tabindex="4"
                              Immediate="false" Class="sb-field" />
                <MudTextField @key="@("fndesc-" + stateContainer.selectedFn)" T="string"
                              Value="@(stateContainer.selectedFunction?.Description ?? "")" ValueChanged="OnFnDescChanged"
                              Label="@Loc["FN_DESCRIPTION"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Disabled="@stateContainer.isDisabled" tabindex="5"
                              Lines="2" MaxLines="6" Sizing="InputSizing.Auto" Class="sb-field sb-field-desc" />

                <div class="sb-head">
                    <span class="sb-title">@L("ASPECTS", "Aspects")</span>
                </div>
                @foreach (var type in AspectTypes)
                {
                    @AspectGroup(type)
                }

                <div class="sb-head">
                    <span class="sb-title">@L("ORGANISATION", "Organisation")</span>
                </div>
                @if (stateContainer.agentList.Count == 0 && stateContainer.levelList.Count == 0)
                {
                    <p class="sb-hint">
                        @L("NO_AGENTS_LEVELS_HINT", "No agents or levels yet.")
                        <button type="button" class="sb-link" @onclick="@(() => SetTab("model"))">@L("MANAGE_AGENTS_LEVELS", "Manage agents and levels")</button>
                    </p>
                }
                else
                {
                    <div class="sb-pair">
                        <MudSelect T="string" Value="@(stateContainer.selectedFunction!.AgentId)" ValueChanged="OnAgentChanged"
                                   Label="@L("AGENT", "Agent")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                   Clearable="true" Class="sb-field" tabindex="33">
                            @foreach (var agent in stateContainer.agentList)
                            {
                                <MudSelectItem T="string" Value="@agent.IDNr">@agent.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="string" Value="@(stateContainer.selectedFunction!.LevelId)" ValueChanged="OnLevelChanged"
                                   Label="@L("LEVEL", "Level")" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                                   Clearable="true" Class="sb-field" tabindex="34">
                            @foreach (var level in stateContainer.levelList.OrderBy(l => l.Hierarchy).ThenBy(l => l.Name))
                            {
                                <MudSelectItem T="string" Value="@level.IDNr">@level.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                }

                <div class="sb-head">
                    <span class="sb-title">@L("SCRIPT_AND_LOOK", "Script & appearance")</span>
                </div>
                <div class="sb-row">
                    @* Stash the model on pointer-down, then open the IDE. The click handler is explicit
                       so that browsers/embedded views that suppress window.open (target="_blank") still
                       navigate to the IDE in the current tab instead of silently doing nothing. *@
                    <a class="sb-btn sb-btn-tonal sb-grow" title="@L("SCRIPT_TOOLTIP", "Open the ST script editor for this function")" tabindex="27"
                       href="@ScriptEditorUrl"
                       @onpointerdown="PrepareScriptIDE"
                       @onclick="OpenScriptIDE"
                       @onclick:preventDefault>
                        <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" />
                        @(HasScript ? L("EDIT_SCRIPT", "Edit script") : L("ADD_SCRIPT", "Add script"))
                    </a>
                    <button type="button" class="sb-btn sb-btn-tonal sb-grow" title="@Loc["FN_COLOUR"]" tabindex="25" @onclick="ModalColor" @onkeyup="ModalKey">
                        <MudIcon Icon="@Icons.Material.Filled.Palette" Size="Size.Small" />@L("COLOUR_BUTTON", "Colour")
                    </button>
                </div>
            }
        }
        else if (stateContainer.inspectorTab == "equations")
        {
            @if (HasSelection)
            {
                <div class="insp-context">
                    <span class="sb-title">@L("EQUATIONS_OF", "Keys of")</span>
                    <strong>@stateContainer.selectedFunction!.IDName</strong>
                </div>
            }
            <FMIControl Mode="@stateContainer.activeMode" Part="keys" refreshParent="@(EventCallback.Factory.Create(this, updateAll))" />
        }
        else
        {
            <div class="sb-head"><span class="sb-title">@L("SIMULATION", "Simulation")</span></div>
            <FMIControl Mode="@stateContainer.activeMode" Part="model" refreshParent="@(EventCallback.Factory.Create(this, updateAll))" />

            <div class="sb-head"><span class="sb-title">@L("TEXT_SIZE", "Text size (whole model)")</span></div>
            <div class="sb-row sb-textsize-row">
                <span class="sb-stepper" title="@L("TEXT_SIZE_FN", "Function labels")">
                    <span class="sb-stepper-label">@L("FUNCTIONS_SHORT", "Functions")</span>
                    <button type="button" class="sb-step" title=@Loc["FN_FONT_DECREASE"] @onclick=zoomFs @onfocusin=zoomFin @onfocusout=zoomFout @onkeyup=NextFn>−</button>
                    <button type="button" class="sb-step" title=@Loc["FN_FONT_INCREASE"] @onclick=zoomFl @onfocusin=zoomFin @onfocusout=zoomFout @onkeyup=NextFn>+</button>
                </span>
                <span class="sb-stepper" title="@L("TEXT_SIZE_ASPECT", "Aspect labels")">
                    <span class="sb-stepper-label">@L("ASPECTS_SHORT", "Aspects")</span>
                    <button type="button" class="sb-step" title=@Loc["ASPECT_FONT_DECREASE"] @onclick=zoomAs @onfocusin=zoomAin @onfocusout=zoomAout @onkeyup=NextFn>−</button>
                    <button type="button" class="sb-step" title=@Loc["ASPECT_FONT_INCREASE"] @onclick=zoomAl @onfocusin=zoomAin @onfocusout=zoomAout @onkeyup=NextFn>+</button>
                </span>
            </div>

            <RightPanel Embedded="true" refreshParent="refreshParent" />
        }
    </div>
</aside>

@code {
    [Parameter]
    public EventCallback refreshParent { get; set; }
    [Parameter]
    public EventCallback newFunction { get; set; }
    [Parameter]
    public EventCallback<KeyboardEventArgs> nextFn { get; set; }

    private string setFocus = "";
    private string focusCheck = "";
    private string oldZoomText = "";

    private string ScriptEditorUrl => $"scripteditor/{stateContainer.selectedFn}";

    private (string Tab, string Label, string Icon)[] Tabs =>
    [
        ("function", L("FUNCTION", "Function"), Icons.Material.Outlined.Hexagon),
        ("equations", L("EQUATIONS", "Equations"), Icons.Material.Outlined.Functions),
        ("model", L("MODEL", "Model"), Icons.Material.Outlined.Tune),
    ];

    private void SetTab(string tab)
    {
        stateContainer.inspectorTab = tab;
        refreshParent.InvokeAsync();
    }

    private static readonly string[] AspectTypes = { "Output", "Input", "Precondition", "Resource", "Control", "Time" };
    private bool HasSelection => stateContainer.selectedFn != "-1" && stateContainer.selectedFunction is not null;
    private bool HasScript => HasSelection && stateContainer.fmiUsage().HasScript(stateContainer.selectedFn);

    // Localization helper: falls back to a default English string if the resx key is missing.
    private string L(string key, string fallback)
    {
        var value = Loc[key];
        return value.ResourceNotFound ? fallback : value.Value;
    }

    private List<Aspect> AspectsOf(string type) => type == "Output"
        ? stateContainer.outputsList.FindAll(x => x.Type == "Output" && x.FunctionIDNr == stateContainer.selectedFn)
        : stateContainer.aspectsList.FindAll(x => x.Type == type && x.FunctionIDNr == stateContainer.selectedFn);

    private string AspectLabel(string type) => Loc[type.ToUpperInvariant()];

    // One aspect type: coloured letter, name, optional activation profile, add button, then one row per aspect.
    private RenderFragment AspectGroup(string type) => __builder =>
    {
        var letter = type.Substring(0, 1);
        var aspects = AspectsOf(type);
        var tab = Array.IndexOf(AspectTypes, type) * 3 + 6;
        <div class="aspect-group">
            <div class="aspect-head">
                <span class="aspect-letter aspect-letter-@letter.ToLowerInvariant()">@letter</span>
                <span class="aspect-name">@AspectLabel(type)</span>
                @if (type != "Output" && type != "Time" && !disableAspectProfile())
                {
                    <button type="button" class="aspect-profile" title=@(type == "Input" ? profileITooltip() : profileTooltip())
                            tabindex="@(28 + tab)" @onclick="@(() => changeProfile(letter))">@ProfileText(letter)</button>
                }
                <button id="@($"new{letter}Button")" type="button" class="aspect-add" title="@($"{L("ADD", "Add")} {AspectLabel(type)}")"
                        tabindex="@tab" @onclick="@((e) => NewAspect(e, type))" @onkeyup=NextFn>
                    <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" />
                </button>
            </div>
            @if (type == "Output" && !disableFnProfile())
            {
                <label class="aspect-row aspect-entry" title=@profileFnTooltip()>
                    <span>@L("ENTRY_TIMING", "Entry timing")</span>
                    <input type="text" name="fnProfileInput" class="aspect-input aspect-entry-input" tabindex="27" value=@showFnProfile() @onchange="@((e) => changeFnProfile(e, "Fn"))" placeholder="0, N or p" />
                </label>
            }
            @foreach (var aspect in aspects)
            {
                <div class="aspect-row">@AspectInput(aspect, type, tab + 1)</div>
            }
        </div>
    };

    // The editable name of one aspect, with the dropdown of existing names of the same type.
    private RenderFragment AspectInput(Aspect aspect, string type, int tab) => __builder =>
    {
        <div class="autocomplete-wrapper">
            <input class="aspect-input @(aspect.Orphan=="true"?"aspect-orphan":"")"
                   type="text" name="@($"{type.ToLowerInvariant()}-{aspect.IDNr}")"
                   @ref="aspect.elementReference"
                   tabindex="@tab"
                   value="@aspect.IDName"
                   title="@(aspect.Orphan == "true" ? L("ORPHAN_HINT", "No matching coupling yet") : aspect.IDName)"
                   @oninput="@(e => HandleAspectInput(e, type, aspect.IDNr))"
                   @onkeydown="@(e => HandleAspectKeyDown(e, type, aspect.IDNr))"
                   @onfocus="@(e => OpenDropdown(type, aspect.IDNr))"
                   @onblur="@(async () => await HandleBlur(type, aspect.IDNr))"
                   @onchange="@(e => CommitAspect(e, type, aspect.IDNr))" />
            <button class="dropdown-btn" tabindex="-1"
                    @onclick="@(async () => await ButtonClick(type, aspect.IDNr, aspect.elementReference))"
                    @onmousedown:preventDefault @onmousedown:stopPropagation
                    type="button"><MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" /></button>
            @if (IsDropdownOpen(type, aspect.IDNr))
            {
                <ul class="suggestion-list" @onkeydown="@(e => SuggestionKeyDown(e, type, aspect.IDNr))">
                    @foreach (var item in GetFilteredExisting(type, aspectFilterText))
                    {
                        int idx = suggestionsActiveList.IndexOf(item);
                        <li class="suggestion-item @(suggestionsActiveIndex == idx ? "active" : "")"
                            @onclick="@(() => SelectSuggestion(type, aspect.IDNr, item))"
                            @onmouseover="@(() => suggestionsActiveIndex = idx)">@item</li>
                    }
                </ul>
            }
        </div>
    };

    private string ProfileText(string type)
    {
        var fn = stateContainer.selectedFunction;
        if (fn is null) return "";
        var profile = type switch
        {
            "I" => Function.ProfileToString(fn.PrInputs),
            "P" => Function.ProfileToString(fn.PrPreconditions),
            "R" => Function.ProfileToString(fn.PrResources),
            "C" => Function.ProfileToString(fn.PrControls),
            _ => ""
        };
        return profile switch
        {
            "All" => "∀ all",
            "Any" => "∃ any",
            "None" => "∅ none",
            _ => L("PROFILE_DEFAULT", "default")
        };
    }

    private void OnAgentChanged(string? agentId)
    {
        if (stateContainer.selectedFunction is null) return;
        if (string.IsNullOrEmpty(agentId)) stateContainer.ClearAgentFromFunction(stateContainer.selectedFunction);
        else stateContainer.AssignAgentToFunction(stateContainer.selectedFunction, agentId);
        refreshParent.InvokeAsync();
    }

    private void OnLevelChanged(string? levelId)
    {
        if (stateContainer.selectedFunction is null) return;
        if (string.IsNullOrEmpty(levelId)) stateContainer.ClearLevelFromFunction(stateContainer.selectedFunction);
        else stateContainer.AssignLevelToFunction(stateContainer.selectedFunction, levelId);
        refreshParent.InvokeAsync();
    }

    private void OpenAgentsLevelsPanel()
    {
        stateContainer.rightPanel = "agents-levels";
        refreshParent.InvokeAsync();
    }

    // Runs on pointer-down (before the IDE opens), stashing the current model in
    // localStorage for the IDE page to load.
    private async Task PrepareScriptIDE()
    {
        if (stateContainer.selectedFn == "-1"
            || stateContainer.projectData_Undo is not { Length: > 0 }
            || stateContainer.projectData_Undo[0] is null)
        {
            return;
        }
        await JSRuntime.InvokeVoidAsync("ScriptSync.prepare",
            stateContainer.projectData_Undo[0].OuterXml, stateContainer.selectedFn, stateContainer.fileName);
    }

    // Opens the Script IDE. Prefers a new tab, but if the environment blocks popups
    // (VS Code's embedded browser, PWAs, strict popup blockers) it navigates in place
    // so the button always has a visible effect.
    private async Task OpenScriptIDE()
    {
        if (stateContainer.selectedFn == "-1")
        {
            return;
        }
        await PrepareScriptIDE();

        var opened = false;
        try
        {
            opened = await JSRuntime.InvokeAsync<bool>("ScriptSync.open", ScriptEditorUrl);
        }
        catch (Exception)
        {
            // JS interop unavailable - fall through to in-place navigation.
        }

        if (!opened)
        {
            Nav.NavigateTo(ScriptEditorUrl);
        }
    }

    // Autocomplete state
    private string openDropdownType = "";
    private string openDropdownId = "";
    private string aspectFilterText = "";
    private List<string> suggestionsActiveList = new();
    private int suggestionsActiveIndex = -1;

    // Blur-Schutz für den Dreiecksknopf
    private readonly HashSet<string> pendingBlurIgnore = new();
    // Schutz vor Löschung eines leeren Aspekts, solange eine Neuanlage im Gange ist
    private readonly Dictionary<string, bool> pendingAspectCreation = new();

    private IEnumerable<string> GetExistingAspectNames(string type)
    {
        if (type == "Output")
            return stateContainer.outputsList
                .Where(o => !string.IsNullOrEmpty(o.IDName))
                .Select(o => o.IDName)
                .Distinct();
        else
            return stateContainer.aspectsList
                .Where(a => a.Type == type && !string.IsNullOrEmpty(a.IDName))
                .Select(a => a.IDName)
                .Distinct();
    }

    private List<string> GetFilteredExisting(string type, string filter)
    {
        var all = GetExistingAspectNames(type).ToList();
        if (string.IsNullOrWhiteSpace(filter))
            return all.OrderBy(s => s).ToList();
        return all.Where(s => s.StartsWith(filter, StringComparison.OrdinalIgnoreCase))
            .OrderBy(s => s).ToList();
    }

    private bool IsDropdownOpen(string type, string id) =>
        openDropdownType == type && openDropdownId == id;

    private void OpenDropdown(string type, string id)
    {
        openDropdownType = type;
        openDropdownId = id;
        UpdateSuggestions(type, id);
    }

    private void CloseDropdownDelayed()
    {
        _ = CloseAfterDelay();
    }

    private async Task CloseAfterDelay()
    {
        await Task.Delay(150);
        if (openDropdownType != "")
        {
            openDropdownType = "";
            openDropdownId = "";
            suggestionsActiveList.Clear();
            suggestionsActiveIndex = -1;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleDropdown(string type, string id)
    {
        if (IsDropdownOpen(type, id))
            openDropdownType = "";
        else
            OpenDropdown(type, id);
    }

    private void HandleAspectInput(ChangeEventArgs e, string type, string id)
    {
        aspectFilterText = e.Value?.ToString() ?? "";
        OpenDropdown(type, id);
        UpdateSuggestions(type, id);
    }

    private void HandleAspectKeyDown(KeyboardEventArgs e, string type, string id)
    {
        if (!IsDropdownOpen(type, id)) return;

        switch (e.Key)
        {
            case "ArrowDown":
                if (suggestionsActiveList.Count == 0) return;
                suggestionsActiveIndex = Math.Min(suggestionsActiveIndex + 1, suggestionsActiveList.Count - 1);
                break;
            case "ArrowUp":
                if (suggestionsActiveList.Count == 0) return;
                suggestionsActiveIndex = Math.Max(suggestionsActiveIndex - 1, 0);
                break;
            case "Enter":
                if (suggestionsActiveIndex >= 0 && suggestionsActiveIndex < suggestionsActiveList.Count)
                {
                    SelectSuggestionInternal(type, id, suggestionsActiveList[suggestionsActiveIndex]);
                }
                else if (suggestionsActiveList.Count == 1)
                {
                    SelectSuggestionInternal(type, id, suggestionsActiveList[0]);
                }
                else if (!string.IsNullOrWhiteSpace(aspectFilterText))
                {
                    AspectChangeCommitt(aspectFilterText, id, type);
                    openDropdownType = "";
                    openDropdownId = "";
                    suggestionsActiveList.Clear();
                    suggestionsActiveIndex = -1;
                    checkForBackground();
                    refreshParent.InvokeAsync();
                }
                break;
            case "Escape":
                openDropdownType = "";
                openDropdownId = "";
                suggestionsActiveList.Clear();
                suggestionsActiveIndex = -1;
                break;
        }
    }

    private void SuggestionKeyDown(KeyboardEventArgs e, string type, string id)
    {
        HandleAspectKeyDown(e, type, id);
    }

    private void SelectSuggestion(string type, string id, string item)
    {
        SelectSuggestionInternal(type, id, item);
    }

    private void SelectSuggestionInternal(string type, string id, string item)
    {
        aspectFilterText = item;
        AspectChangeCommitt(item, id, type);
        openDropdownType = "";
        openDropdownId = "";
        suggestionsActiveList.Clear();
        suggestionsActiveIndex = -1;
        refreshParent.InvokeAsync();
    }

    private void UpdateSuggestions(string type, string id)
    {
        suggestionsActiveList = GetFilteredExisting(type, aspectFilterText);
        suggestionsActiveIndex = suggestionsActiveList.Count > 0 ? 0 : -1;
        StateHasChanged();
    }

    private void CommitAspect(ChangeEventArgs e, string type, string id)
    {
        stateContainer.updateUndo();
        var value = e.Value?.ToString() ?? "";
        if (!string.IsNullOrWhiteSpace(value))
        {
            AspectChangeCommitt(value, id, type);
        }
        else
        {
            DeleteAspect(type, id);
        }
        checkForBackground();
        refreshParent.InvokeAsync();
    }

    private async Task ButtonClick(string type, string id, ElementReference inputRef)
    {
        pendingBlurIgnore.Add($"{type}|{id}");
        await inputRef.FocusAsync();
        if (IsDropdownOpen(type, id))
        {
            openDropdownType = "";
            openDropdownId = "";
        }
        else
        {
            OpenDropdown(type, id);
        }
        _ = Task.Run(async () =>
        {
            await Task.Delay(200);
            pendingBlurIgnore.Remove($"{type}|{id}");
            await InvokeAsync(StateHasChanged);
        });
        StateHasChanged();
    }

    private async Task HandleBlur(string type, string id)
    {
        if (pendingBlurIgnore.Contains($"{type}|{id}") || pendingAspectCreation.TryGetValue(type, out var val) && val)
        {
            return;
        }
        AspectBlank(type, id);
        CloseDropdownDelayed();
    }

    protected void updateAll()
    {
        refreshParent.InvokeAsync();
    } 
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            if (setFocus != "")
            {
                try
                {
                    if (setFocus == "Output")
                    {
                        await stateContainer.outputsList.FindLast(x => x.Type == setFocus && x.FunctionIDNr == stateContainer.selectedFn)!.elementReference.FocusAsync();
                    }
                    else
                    {
                        await stateContainer.aspectsList.FindLast(x => x.Type == setFocus && x.FunctionIDNr == stateContainer.selectedFn)!.elementReference.FocusAsync();
                    }
                }
                catch { }
                setFocus = "";
            }
        }
    }
    private void changeFnProfile(ChangeEventArgs e, string type)
    {
        if (stateContainer.selectedFunction is not null)
        {
            stateContainer.updateUndo();
            var tempFnProfile = e.Value?.ToString() ?? "";
            stateContainer.selectedFunction.profileFn = tempFnProfile;
            stateContainer.projectData_Undo[0].SelectSingleNode($"//FM/Functions/Function[IDNr={stateContainer.selectedFn}]/@profileFn")!.InnerText = tempFnProfile;
        }
    }
    private void changeProfile(string type)
    {
        if (stateContainer.selectedFunction is not null)
        {
            stateContainer.updateUndo();
            // T button stays rendered but does nothing
            if (type == "T") return;
            var getProfile = "";
            switch (type)
            {
                case "Fn": getProfile = stateContainer.selectedFunction.profileFn; break;
                case "I": getProfile = Function.ProfileToString(stateContainer.selectedFunction.PrInputs); break;
                case "P": getProfile = Function.ProfileToString(stateContainer.selectedFunction.PrPreconditions); break;
                case "R": getProfile = Function.ProfileToString(stateContainer.selectedFunction.PrResources); break;
                case "C": getProfile = Function.ProfileToString(stateContainer.selectedFunction.PrControls); break;
                default: getProfile = ""; break;
            }
            switch (getProfile)
            {
                case "All": getProfile = "Any"; break;
                case "Any": if (type == "I") { getProfile = ""; } else { getProfile = "None"; } break;
                case "None": getProfile = ""; break;
                case "": getProfile = "All"; break;
                default: getProfile = ""; break;
            }
            stateContainer.projectData_Undo[0].SelectSingleNode($"//FM/Functions/Function[IDNr=\"{stateContainer.selectedFn}\"]/@profile{type}")!.InnerText = getProfile;
            switch (type)
            {
                case "Fn": stateContainer.selectedFunction.profileFn = getProfile; break;
                case "I": stateContainer.selectedFunction.PrInputs = Function.ParseProfile(getProfile); break;
                case "P": stateContainer.selectedFunction.PrPreconditions = Function.ParseProfile(getProfile); break;
                case "R": stateContainer.selectedFunction.PrResources = Function.ParseProfile(getProfile); break;
                case "C": stateContainer.selectedFunction.PrControls = Function.ParseProfile(getProfile); break;
            }
        }
    }
    private string profileTooltip()
    {
        return Loc["FMI_PROFILE_SHORT"] + System.Environment.NewLine + Loc["FMI_ALL"] + System.Environment.NewLine + Loc["FMI_ANY"] + System.Environment.NewLine + Loc["FMI_NONE"];
    }
    private string profileITooltip()
    {
        return Loc["FMI_PROFILE_SHORT"] + System.Environment.NewLine + Loc["FMI_ALL"] + System.Environment.NewLine + Loc["FMI_ANY"];
    }
    private string profileFnTooltip()
    {
        return Loc["FMI_PROFILE_SHORT"] + System.Environment.NewLine + Loc["FMI_INITIAL_ONLY"] + System.Environment.NewLine + Loc["FMI_EVERY_NTH"] + System.Environment.NewLine + Loc["FMI_RANDOM"];
    }
    private bool disableFnProfile()
    {
        var returnFnDisabled = true;
        if (stateContainer.selectedFn != "-1" && stateContainer.selectedFunction is not null)
        {
            if (stateContainer.selectedFunction.fmiType == "Entry") returnFnDisabled = false;
        }
        return returnFnDisabled;
    }
    private bool disableAspectProfile()
    {
        var returnAspectDisabled = true;
        if (stateContainer.selectedFn != "-1" && stateContainer.selectedFunction is not null)
        {
            var checkType = stateContainer.selectedFunction.fmiType;
            if (checkType == "Exit" || checkType == "Passthrough" || checkType == "Foreground") returnAspectDisabled = false;
        }
        return returnAspectDisabled;
    }
