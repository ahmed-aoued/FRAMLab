        </div>
        @if (GetNodesT is not null && GetNodesT.Count > 1)
        {
            int ListCount = 0;
            @foreach (var aspect in GetNodesT)
            {
                if (ListCount > 0)
                {
                    <div class="d-flex aspect-list">
                        <div class="autocomplete-wrapper">
                            <input class="aspect-input @(aspect.Orphan=="true"?"aspect-orphan":"")"
                                   type="text" name="@($"time-{aspect.IDNr}")"
                                   @ref="aspect.elementReference"
                                   tabindex="22"
                                   value="@aspect.IDName"
                                   @oninput="@(e => HandleAspectInput(e, "Time", aspect.IDNr))"
                                   @onkeydown="@(e => HandleAspectKeyDown(e, "Time", aspect.IDNr))"
                                   @onfocus="@(e => OpenDropdown("Time", aspect.IDNr))"
                                   @onblur="@(async () => await HandleBlur("Time", aspect.IDNr))"
                                   @onchange="@(e => CommitAspect(e, "Time", aspect.IDNr))" />
                            <button class="dropdown-btn" tabindex="-1"
                                    @onclick="@(async () => await ButtonClick("Time", aspect.IDNr, aspect.elementReference))"
