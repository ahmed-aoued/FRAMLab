                    {
                        <small class="text-muted">Select a function to assign levels.</small>
                    }
                    else if (!string.IsNullOrEmpty(stateContainer.selectedFunction.LevelId))
                    {
                        var level = stateContainer.levelList.Find(l => l.IDNr == stateContainer.selectedFunction.LevelId);
                        <div class="assignment-display mb-1 d-flex align-center">
                            <span class="text-truncate flex-grow-1">@(level?.Name ?? $"Level {stateContainer.selectedFunction.LevelId}")</span>
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                                           title="Remove" OnClick=ClearLevel aria-label="Remove level" />
