    private void ChangeGroup(MouseEventArgs e, Function function)
    {
        if (function.IDNr == function.groupIDNr.Value && function.group is not null)
        {
            Function? getParent = null;
            stateContainer.updateUndo();
            var isActive = function.group.SelectSingleNode("@active");
            var setActive = "";
            if (isActive is not null)
            {
                if (isActive.Value == "true")
                {
                    setActive = "";
                    stateContainer.sFnFunctionType();
                }
                else
                {
                    setActive = "true";
                    stateContainer.projectData_Undo[0].SelectSingleNode($"//FM/Functions/Function[IDNr={stateContainer.selectedFn}]/FunctionType")!.InnerText = "0";
                    stateContainer.selectedFunction!.FunctionType = "0";
                }
                isActive.Value = setActive;
            }
            var children = new List<string>();
            children = ChangeGroupRegress(function.group);
            foreach (var coupling in stateContainer.couplingList.FindAll(x => x.outputFn == function.IDNr && children.Contains(x.toFn)))
            {
                if (setActive == "true")
                {
                    coupling.notGroup = function.IDNr;
                }
                else if (coupling.notGroup == function.IDNr)
                {
                    coupling.notGroup = "";
                }
            }
            foreach (var fnGID in children)
            {
                if (!stateContainer.selectedMulti.Contains(fnGID))
                {
                    stateContainer.selectedMulti.Add(fnGID);
                }
                var getFn = stateContainer.functionList.Find(x => x.IDNr == fnGID);
                if (getFn is not null)
                {
                    Console.WriteLine($"Function: {getFn.IDName} | {getFn.groupActive.Value} | {getFn.groupIDNr.Value}");
                    if (!(getFn.groupActive.Value == "true" && getFn.groupIDNr.Value != "" && getFn.groupIDNr.Value != function.IDNr && !children.Contains(getFn.groupIDNr.Value!)))
                    {
                        getParent = stateContainer.functionList.Find(x => x.IDNr == getFn.groupIDNr.Value);
                        if (setActive == "true")
                        {
                            if (getFn.groupActive.Value == "true" && getFn.groupIDNr.Value != "" && getFn.groupIDNr.Value != function.IDNr)
                            {
                                Console.WriteLine("TEST");
                            }
                            else
                            {
                                getFn.groupX.Value = (getFn.x - function.x).ToString("0.##", CultureInfo.InvariantCulture);
                                getFn.groupY.Value = (getFn.y - function.y).ToString("0.##", CultureInfo.InvariantCulture);
                                getFn.groupIDNr.Value = function.IDNr;
                                getFn.groupActive.Value = setActive;
                            }
                            getFn.x = function.x;
                            getFn.y = function.y;
                        }
                        else
                        {
                            double deltaX = 0;
                            double deltaY = 0;
                            if (getFn.groupActive.Value == "true" && getFn.groupIDNr.Value != "" && getFn.groupIDNr.Value != function.IDNr)
                            {
                                if (getParent is not null)
                                {
                                    deltaX = getParent.x - function.x;
                                    deltaY = getParent.y - function.y;
                                }
                            }
                            else
                            {
                                double.TryParse(getFn.groupX.Value, CultureInfo.InvariantCulture, out deltaX);
                                double.TryParse(getFn.groupY.Value, CultureInfo.InvariantCulture, out deltaY);
                                getFn.groupIDNr.Value = function.IDNr;
                                getFn.groupActive.Value = setActive;
                            }
                            getFn.x = function.x + deltaX;
                            getFn.y = function.y + deltaY;
