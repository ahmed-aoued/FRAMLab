                                if (coupling.toFn == getFn.groupIDNr.Value && getParent is not null && getParent.group is not null && getParent.group.SelectSingleNode("@active")!.Value == "true")
                                {
                                    Console.WriteLine($"{coupling.Name} | {coupling.notGroup} | {function.IDNr} | {getFn.groupIDNr.Value}");
                                    coupling.notGroup = getParent.IDNr;
                                }
                                else
                                {
                                    coupling.notGroup = "";
                                }
                            }
                        }
                    }
                }
            }
            refreshParent.InvokeAsync();
        }
    }
    private List<string> ChangeGroupRegress(XmlNode group)
    {
        var childrenIn = new List<string>();
        var childrenOut = new List<string>();
        childrenIn = group.SelectSingleNode("CHILD")!.InnerText.Split("|").ToList();
        childrenOut = group.SelectSingleNode("CHILD")!.InnerText.Split("|").ToList();
        foreach (var child in childrenIn)
        {
            var getRegress = stateContainer.fnGroups!.SelectSingleNode($"Group[FunctionIDNr={child}]");
            if (getRegress is not null)
            {
                childrenOut.AddRange(ChangeGroupRegress(getRegress));
            }
        } 
        return childrenOut;
    }
