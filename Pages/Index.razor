                stateContainer.initialDisplaySetup($"c_{i}4_value", stateContainer.projectData_Undo[0].SelectSingleNode($"//FM/Functions/@c_{i}4_value")?.Value ?? "#F00000");
                stateContainer.checkDisplayValues(i.ToString());
