  <Levels>
    <Level color="#E8DAEF">
      <IDNr>0</IDNr>
      <Name>Strategic</Name>
      <Hierarchy>2</Hierarchy>
    </Level>
    <Level color="#FCF3CF">
      <IDNr>1</IDNr>
      <Name>Tactical</Name>
      <Hierarchy>1</Hierarchy>
    </Level>
    <Level color="#D5F5E3">
      <IDNr>2</IDNr>
      <Name>Operational</Name>
      <Hierarchy>0</Hierarchy>
    </Level>
  </Levels>
  <ScriptGlobals>
    <var name="Coldest_surface" scope="Global" type="REAL" init="99" />
  </ScriptGlobals>
  <FMI version="1">
    <Variables>
      <Variable name="Ice_risk" type="number" scope="function" function="2" initial="0" description="0 = no risk ... 1 = black ice almost certain" />
      <Variable name="Salt_stock" type="number" scope="function" function="8" initial="120" persist="true" description="Tonnes of salt in the depot, carried between cycles" />
      <Variable name="Shift_count" type="number" scope="model" initial="0" persist="true" description="Night shifts counted by the shift clock" />
    </Variables>
    <Macros>
      <Macro name="clamp01" return="number" description="Limit a value to 0..1">
        <Param name="x" type="number" />
        <Body>x &lt; 0 ? 0 : (x &gt; 1 ? 1 : x)</Body>
      </Macro>
      <Macro name="iceRisk" return="number" description="Ice risk 0..1 from surface temperature, dew-point spread, precipitation and the freezing threshold">
        <Param name="surface" type="number" />
        <Param name="spread" type="number" />
        <Param name="precip" type="number" />
        <Param name="freeze" type="number" />
        <Body>clamp01(0.6 * clamp01((freeze - surface) / 4) + 0.3 * clamp01((1 - spread) / 3) + 0.1 * clamp01(precip))</Body>
      </Macro>
      <Macro name="saltTonnes" function="6" return="number" description="Salt needed for a distance in km (only visible to Load salt onto trucks)">
        <Param name="km" type="number" />
        <Body>round(km * Global_Salt_per_km, 2)</Body>
      </Macro>
    </Macros>
    <DataSources>
      <Source name="weather" kind="http" address="https://api.open-meteo.com/v1/forecast?latitude=48.55&amp;longitude=9.67&amp;current=temperature_2m,relative_humidity_2m,dew_point_2m,precipitation,wind_speed_10m&amp;daily=temperature_2m_min&amp;forecast_days=1&amp;timezone=Europe%2FBerlin" description="Open-Meteo current weather and tonight's minimum at the A8 Albaufstieg (no key needed)" />
      <Source name="forecast" kind="http" address="https://api.open-meteo.com/v1/forecast?latitude=48.55&amp;longitude=9.67&amp;hourly=temperature_2m,precipitation_probability&amp;forecast_days=1&amp;format=csv&amp;timezone=Europe%2FBerlin" format="csv" description="Open-Meteo hourly forecast for today as CSV (row = hour)" />
    </DataSources>
    <DataUses>
      <Use source="weather" function="1" timing="live" />
      <Use source="weather" function="9" timing="onExit" />
    </DataUses>
  </FMI>
</FM>