    <!-- Fn 0: Entry — detects hazard, agent=Operator, level=Strategic -->
    <Function fnStyle="0" isInput="true" orphans="0" profileFn="" profileI="" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="80" y="80" agentId="0" levelId="0">
      <IDNr>0</IDNr>
