    <!-- Fn 1: Core — all aspect types attached, custom color, metadata with equation -->
    <Function fnStyle="0" isInput="false" orphans="0" profileFn="" profileI="All" profileP="All" profileR="Any" profileC="All" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" style="custom" color="4481791" x="300" y="80" agentId="1" levelId="1">
      <IDNr>1</IDNr>
      <FunctionType>0</FunctionType>
      <IDName>Assess severity</IDName>
      <metadata>
        <Risk_Score active="true" equation="Probability*Impact">0</Risk_Score>
        <Impact active="false" equation="">5</Impact>
        <Probability active="false" equation="">0.8</Probability>
      </metadata>
      <Description>Evaluate severity using risk matrix.</Description>
    </Function>

    <!-- Fn 2: Decision — Any on Input, agent=SCADA -->
    <Function fnStyle="0" isInput="false" orphans="0" profileFn="" profileI="Any" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="520" y="80" agentId="2" levelId="1">
      <IDNr>2</IDNr>
      <FunctionType>0</FunctionType>
      <IDName>Decide response</IDName>
      <metadata>
        <Decision active="true" equation="Risk_Score>=4?1:0">0</Decision>
      </metadata>
      <Description>Automated decision on risk threshold.</Description>
    </Function>

