<?xml version="1.0" encoding="utf-8"?><FM Version="0,3,0,0"><Functions colour_10="-1" colour_11="0" colour_12="0.5" colour_13="1" colour_14="2" colour_20="-1" colour_21="0" colour_22="0.5" colour_23="1" colour_24="2" colour_30="-1" colour_31="0" colour_32="0.5" colour_33="1" colour_34="2" colour_40="-1" colour_41="0" colour_42="0.5" colour_43="1" colour_44="2" colour_50="-1" colour_51="0" colour_52="0.5" colour_53="1" colour_54="2" colour_60="-1" colour_61="0" colour_62="0.5" colour_63="1" colour_64="2" tracer_1="" tracer_2="" tracer_3="" tracer_4="" tracer_5="" tracer_6="" c_10_value="#40CFFF" c_12_value="#FFFF00" c_14_value="#F00000" c_20_value="#40CFFF" c_22_value="#FFFF00" c_24_value="#F00000" c_30_value="#40CFFF" c_32_value="#FFFF00" c_34_value="#F00000" c_40_value="#40CFFF" c_42_value="#FFFF00" c_44_value="#F00000" c_50_value="#40CFFF" c_52_value="#FFFF00" c_54_value="#F00000" c_60_value="#40CFFF" c_62_value="#FFFF00" c_64_value="#F00000" hideFMIhighlight="false" hideFMIdisplaytext="false" typeFMIdisplay="|Blend|Blend|Blend|Blend|Blend|Blend"><!-- Fire emergency response: an entry function detects a fire and passes it through assessment and alarming to crew dispatch. Every function runs a per-cycle ST script instead of a metadata equation. --><Function fnStyle="0" orphans="0" profileFn="" profileI="" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="200" y="550" agentId="0" levelId="2" isInput="false"><IDNr>0</IDNr><FunctionType>2</FunctionType><IDName>Detect fire</IDName><metadata><Fire_signal active="false" equation="">1</Fire_signal></metadata><Description>Fire detector raises the raw fire signal.</Description><script enabled="true" language="ST" version="1"><![CDATA[(* Detect fire: raise the raw fire signal (0..1). *)
Fire_signal := 1.0;]]></script><aspectTypes><aspect category="Output" label="Fire signal" type="REAL" /></aspectTypes></Function><Function fnStyle="0" orphans="0" profileFn="" profileI="All" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="480" y="330" agentId="1" levelId="1" isInput="true"><IDNr>1</IDNr><FunctionType>0</FunctionType><IDName>Assess severity</IDName><metadata><Severity_assessment active="false" equation="">0</Severity_assessment></metadata><Description>Operator scales the incoming fire signal into a severity score.</Description><script enabled="true" language="ST" version="1"><![CDATA[(* Assess severity: read the 'Fire signal' Input aspect, scale to 0..1. *)
IF Fire_signal > 0.0 THEN
    Severity_assessment := MIN(Fire_signal * 3.0, 1.0);
ELSE
    Severity_assessment := 0.0;
END_IF;]]></script><aspectTypes><aspect category="Input" label="Fire signal" type="REAL" /><aspect category="Output" label="Severity assessment" type="REAL" /></aspectTypes></Function><Function fnStyle="0" orphans="0" profileFn="" profileI="Any" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="760" y="330" agentId="2" levelId="1" isInput="true"><IDNr>2</IDNr><FunctionType>0</FunctionType><IDName>Alarm occupants</IDName><metadata><Alarm_status active="false" equation="">0</Alarm_status></metadata><Description>Raises the alarm when the severity score is high enough.</Description><script enabled="true" language="ST" version="1"><![CDATA[(* Alarm occupants when the 'Severity assessment' Input aspect is high. *)
IF Severity_assessment >= 0.5 THEN
    Alarm_status := 1.0;
ELSE
    Alarm_status := 0.0;
END_IF;]]></script><aspectTypes><aspect category="Input" label="Severity assessment" type="REAL" /><aspect category="Output" label="Alarm status" type="REAL" /></aspectTypes></Function><Function fnStyle="0" orphans="0" profileFn="" profileI="Any" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="760" y="110" agentId="3" levelId="2" isInput="true"><IDNr>3</IDNr><FunctionType>0</FunctionType><IDName>Dispatch crew</IDName><metadata><Dispatch_order active="false" equation="">0</Dispatch_order></metadata><Description>Dispatches the crew, counting how many dispatch orders were issued.</Description><script enabled="true" language="ST" version="1"><![CDATA[(* Dispatch crew: keep a Static counter of how often we dispatched. *)
Dispatch_count := Dispatch_count + 1;
Dispatch_order := Severity_assessment;]]></script><variables><var name="Dispatch_count" scope="Static" type="INT" init="0" /></variables><aspectTypes><aspect category="Input" label="Severity assessment" type="REAL" /><aspect category="Output" label="Dispatch order" type="REAL" /></aspectTypes></Function><Function fnStyle="0" orphans="0" profileFn="" profileI="Any" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="1040" y="330" agentId="4" levelId="2" isInput="true"><IDNr>4</IDNr><FunctionType>0</FunctionType><IDName>Report outcome</IDName><metadata></metadata><Description>Terminal function: records the alarm and the dispatched effort.</Description><script enabled="true" language="ST" version="1"><![CDATA[(* Report outcome: consume the terminal aspects so the model has no orphan outputs. *)
IF Alarm_status >= 0.5 THEN
    Reported_alarms := Reported_alarms + 1;
END_IF;
Reported_effort := Reported_effort + Dispatch_order;
Print('Reported alarms=', Reported_alarms, ' effort=', Reported_effort);]]></script><variables><var name="Reported_alarms" scope="Static" type="INT" init="0" /><var name="Reported_effort" scope="Static" type="REAL" init="0.0" /></variables><aspectTypes><aspect category="Input" label="Alarm status" type="REAL" /><aspect category="Input" label="Dispatch order" type="REAL" /></aspectTypes></Function></Functions><Inputs><Input orphan="false"><IDNr>0</IDNr><IDName>Fire signal</IDName><FunctionIDNr>1</FunctionIDNr></Input><Input orphan="false"><IDNr>1</IDNr><IDName>Severity assessment</IDName><FunctionIDNr>2</FunctionIDNr></Input><Input orphan="false"><IDNr>2</IDNr><IDName>Severity assessment</IDName><FunctionIDNr>3</FunctionIDNr></Input><Input orphan="false"><IDNr>3</IDNr><IDName>Alarm status</IDName><FunctionIDNr>4</FunctionIDNr></Input><Input orphan="false"><IDNr>4</IDNr><IDName>Dispatch order</IDName><FunctionIDNr>4</FunctionIDNr></Input></Inputs><Preconditions></Preconditions><Resources></Resources><Controls></Controls><Times></Times><Outputs><Output orphan="false"><IDNr>0</IDNr><IDName>Fire signal</IDName><FunctionIDNr>0</FunctionIDNr></Output><Output orphan="false"><IDNr>1</IDNr><IDName>Severity assessment</IDName><FunctionIDNr>1</FunctionIDNr></Output><Output orphan="false"><IDNr>2</IDNr><IDName>Alarm status</IDName><FunctionIDNr>2</FunctionIDNr></Output><Output orphan="true"><IDNr>3</IDNr><IDName>Dispatch order</IDName><FunctionIDNr>3</FunctionIDNr></Output></Outputs><Aspects scaleFunction="1" scaleAspect="1" scaleZoom="1.11" Enhanced="false" WebEnhanced="updated"><Aspect x="0" y="0" directionX="from" directionY="to" outputFn="0" toFn="1" notGroup=""><Name>0|Fire signal|1|I</Name><Curve>293.5|600|486|380|437.88|380|341.63|600|389.75|490</Curve><Curve2>M 486 380 Q 437.88 380 389.75 490 Q 341.63 600 293.5 600</Curve2></Aspect><Aspect x="0" y="0" directionX="from" directionY="to" outputFn="1" toFn="2" notGroup=""><Name>1|Severity assessment|2|I</Name><Curve>573.5|380|766|380|717.88|380|621.63|380|669.75|380</Curve><Curve2>M 766 380 Q 717.88 380 669.75 380 Q 621.63 380 573.5 380</Curve2></Aspect><Aspect x="0" y="0" directionX="from" directionY="to" outputFn="1" toFn="3" notGroup=""><Name>1|Severity assessment|3|I</Name><Curve>573.5|380|766|160|717.88|160|621.63|380|669.75|270</Curve><Curve2>M 766 160 Q 717.88 160 669.75 270 Q 621.63 380 573.5 380</Curve2></Aspect></Aspects><Groups></Groups><Agents><Agent><IDNr>0</IDNr><Name>Smoke detector</Name><AgentType>Technological</AgentType></Agent><Agent><IDNr>1</IDNr><Name>Incident controller</Name><AgentType>Human</AgentType></Agent><Agent><IDNr>2</IDNr><Name>Alarm system</Name><AgentType>Technological</AgentType></Agent><Agent><IDNr>3</IDNr><Name>Fire crew</Name><AgentType>Human</AgentType></Agent></Agents><Levels><Level color="#ff0000"><IDNr>0</IDNr><Name>Strategic</Name><Hierarchy>2</Hierarchy></Level><Level color="#ff00f7"><IDNr>1</IDNr><Name>Tactical</Name><Hierarchy>1</Hierarchy></Level><Level color="#00ff2a"><IDNr>2</IDNr><Name>Operational</Name><Hierarchy>0</Hierarchy></Level></Levels></FM>
