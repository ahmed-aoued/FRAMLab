<?xml version="1.0" encoding="utf-8"?><FM Version="0,3,0,0"><Functions colour_10="-1" colour_11="0" colour_12="0.5" colour_13="1" colour_14="2" colour_20="-1" colour_21="0" colour_22="0.5" colour_23="1" colour_24="2" colour_30="-1" colour_31="0" colour_32="0.5" colour_33="1" colour_34="2" colour_40="-1" colour_41="0" colour_42="0.5" colour_43="1" colour_44="2" colour_50="-1" colour_51="0" colour_52="0.5" colour_53="1" colour_54="2" colour_60="-1" colour_61="0" colour_62="0.5" colour_63="1" colour_64="2" tracer_1="Variability" tracer_2="Workload" tracer_3="Quality" tracer_4="" tracer_5="" tracer_6="" c_10_value="#40CFFF" c_12_value="#FFFF00" c_14_value="#F00000" c_20_value="#90D8A4" c_22_value="#FFD36E" c_24_value="#E45A44" c_30_value="#40CFFF" c_32_value="#FFFF00" c_34_value="#F00000" c_40_value="#40CFFF" c_42_value="#FFFF00" c_44_value="#F00000" c_50_value="#40CFFF" c_52_value="#FFFF00" c_54_value="#F00000" c_60_value="#40CFFF" c_62_value="#FFFF00" c_64_value="#F00000" hideFMIhighlight="false" hideFMIdisplaytext="false" typeFMIdisplay="|Blend|Blend|Blend|Blend|Blend|Blend"><!-- Fn 0: Entry — Customer order arrives --><Function fnStyle="0" orphans="0" profileFn="2" profileI="" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="80" y="300" agentId="0" levelId="0" isInput="false" K1="-88"><IDNr>0</IDNr><FunctionType>2</FunctionType><IDName>Place order</IDName><metadata><Activate active="false" equation="">Customer order</Activate><Order_Size active="true" equation="round(rnd(0.6,1.0),2)">0.80</Order_Size><Variability active="true" equation="round(1-Order_Size,2)">0.20</Variability></metadata><Description>Entry function. A customer places a burger order. Order size varies (single burger to large combo).</Description></Function><!-- Fn 1: Background — Bun inventory always available --><Function fnStyle="0" orphans="0" profileFn="" profileI="" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="80" y="520" agentId="1" levelId="0" isInput="false" K1="-83"><IDNr>1</IDNr><FunctionType>2</FunctionType><IDName>Check bun inventory</IDName><metadata><Activate active="false" equation="">Buns available</Activate><Bun_Count active="true" equation="round(rnd(6,24),0)">12</Bun_Count><Bun_Freshness active="true" equation="round(rnd(0.7,1.0),2)">0.85</Bun_Freshness><Variability active="true" equation="round(1-Bun_Freshness,2)">0.15</Variability></metadata><Description>Background resource. Buns are continuously stocked. Freshness varies throughout the day.</Description></Function><!-- Fn 2: Background — Patty stock --><Function fnStyle="0" orphans="0" profileFn="" profileI="" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="80" y="700" agentId="1" levelId="0" isInput="false" K1="0"><IDNr>2</IDNr><FunctionType>2</FunctionType><IDName>Check patty stock</IDName><metadata><Activate active="false" equation="">Patties available</Activate><Patty_Count active="true" equation="round(rnd(8,30),0)">18</Patty_Count><Patty_Quality active="true" equation="round(rnd(0.75,1.0),2)">0.90</Patty_Quality><Variability active="true" equation="round(1-Patty_Quality,2)">0.10</Variability></metadata><Description>Background resource. Frozen patties are pulled from the freezer. Quality depends on storage time.</Description></Function><!-- Fn 3: Foreground — Grill the patty --><Function fnStyle="0" orphans="0" profileFn="" profileI="All" profileP="All" profileR="Any" profileC="All" profileT="Any" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="350" y="200" agentId="2" levelId="0" isInput="true" K1="26.7" K3="-266"><IDNr>3</IDNr><FunctionType>0</FunctionType><IDName>Grill patty</IDName><metadata><Order_Received active="true" equation="I0_Order_Size">0</Order_Received><Patty_Available active="true" equation="R2_Patty_Quality">0</Patty_Available><Grill_Time active="true" equation="T7_Grill_Duration">0</Grill_Time><Grill_Rules active="true" equation="C8_Grill_Standard">0</Grill_Rules><Doneness active="true" equation="round(min(1,Patty_Available+Grill_Rules),2)">0</Doneness><Variability active="true" equation="round(max(0,1-Doneness+Order_Received*0.3),2)">0</Variability><Quality active="true" equation="round(Doneness*(1-Variability),2)">0</Quality></metadata><Description>Foreground function. Patties are grilled to order. Grill time, patty quality, and standards affect doneness.</Description></Function><!-- Fn 4: Foreground — Toast the bun --><Function fnStyle="0" orphans="0" profileFn="" profileI="All" profileP="" profileR="Any" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="350" y="400" agentId="2" levelId="0" isInput="true" K1="0.1"><IDNr>4</IDNr><FunctionType>0</FunctionType><IDName>Toast bun</IDName><metadata><Bun_Needed active="true" equation="I0_Order_Size">0</Bun_Needed><Bun_Ready active="true" equation="R1_Bun_Freshness">0</Bun_Ready><Toast_Quality active="true" equation="round(min(1,Bun_Ready+Bun_Needed*0.2),2)">0</Toast_Quality><Variability active="true" equation="round(max(0,0.1+(1-Toast_Quality)*0.5),2)">0</Variability></metadata><Description>Foreground function. Buns are toasted based on order demand. Freshness affects result.</Description></Function><!-- Fn 5: Foreground — Add toppings --><Function fnStyle="0" orphans="0" profileFn="" profileI="All" profileP="" profileR="Any" profileC="All" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="350" y="580" agentId="2" levelId="0" isInput="true" K1="0.08"><IDNr>5</IDNr><FunctionType>0</FunctionType><IDName>Add toppings</IDName><metadata><Topping_Needed active="true" equation="I0_Order_Size">0</Topping_Needed><Topping_Fresh active="true" equation="R9_Topping_Stock">0</Topping_Fresh><Topping_Spec active="true" equation="C10_Topping_Spec">0</Topping_Spec><Topping_Score active="true" equation="round(min(1,Topping_Fresh+Topping_Spec),2)">0</Topping_Score><Variability active="true" equation="round(max(0,0.08+(1-Topping_Score)*0.4),2)">0</Variability></metadata><Description>Foreground function. Lettuce, tomato, cheese, and sauce are added per order specification.</Description></Function><!-- Fn 6: Foreground — Assemble burger --><Function fnStyle="0" orphans="0" profileFn="" profileI="All" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="620" y="300" agentId="2" levelId="0" isInput="true" K1="44.55" K2="4455.15"><IDNr>6</IDNr><FunctionType>0</FunctionType><IDName>Assemble burger</IDName><metadata><Patty_Done active="true" equation="I3_Quality">0</Patty_Done><Bun_Done active="true" equation="I4_Toast_Quality">0</Bun_Done><Topping_Done active="true" equation="I5_Topping_Score">0</Topping_Done><Assembly_Quality active="true" equation="round((Patty_Done+Bun_Done+Topping_Done)/3,2)">0</Assembly_Quality><Variability active="true" equation="round(max(0,0.05+(1-Assembly_Quality)*0.5),2)">0</Variability><Workload active="true" equation="round(Variability+0.15,2)">0</Workload></metadata><Description>Foreground function. All components are assembled. Quality depends on each component's state.</Description></Function><!-- Fn 7: Background — Cooking timer / time pressure --><Function fnStyle="0" orphans="0" profileFn="3" profileI="" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="80" y="100" agentId="3" levelId="0" isInput="false" K1="-3"><IDNr>7</IDNr><FunctionType>2</FunctionType><IDName>Cooking timer</IDName><metadata><Activate active="false" equation="">Grill duration</Activate><Grill_Duration active="true" equation="round(rnd(0.4,1.0),2)">0.65</Grill_Duration><Time_Pressure active="true" equation="round(1-Grill_Duration,2)">0.35</Time_Pressure><Variability active="true" equation="round(Time_Pressure/2,2)">0.18</Variability></metadata><Description>Entry function for time. Grill duration creates time pressure on the cook.</Description></Function><!-- Fn 8: Background — Grill standards (control) --><Function fnStyle="0" orphans="0" profileFn="" profileI="" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="80" y="880" agentId="4" levelId="1" isInput="false" K1="0.08"><IDNr>8</IDNr><FunctionType>2</FunctionType><IDName>Grill standards</IDName><metadata><Activate active="false" equation="">Grill procedures</Activate><Grill_Standard active="true" equation="0.85">0.85</Grill_Standard><Variability active="true" equation="0.08">0.08</Variability></metadata><Description>Background control. Standard operating procedures for grill temperature and timing.</Description></Function><!-- Fn 9: Background — Topping inventory --><Function fnStyle="0" orphans="0" profileFn="" profileI="" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="80" y="1060" agentId="1" levelId="0" isInput="false" K1="-75"><IDNr>9</IDNr><FunctionType>2</FunctionType><IDName>Topping inventory</IDName><metadata><Activate active="false" equation="">Toppings available</Activate><Topping_Stock active="true" equation="round(rnd(0.6,1.0),2)">0.80</Topping_Stock><Variability active="true" equation="round(1-Topping_Stock,2)">0.20</Variability></metadata><Description>Background resource. Fresh toppings are replenished throughout the shift.</Description></Function><!-- Fn 10: Background — Topping specification (control) --><Function fnStyle="0" orphans="0" profileFn="" profileI="" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="350" y="760" agentId="4" levelId="1" isInput="false" K1="0.05"><IDNr>10</IDNr><FunctionType>2</FunctionType><IDName>Topping specification</IDName><metadata><Activate active="false" equation="">Topping rules</Activate><Topping_Spec active="true" equation="0.90">0.90</Topping_Spec><Variability active="true" equation="0.05">0.05</Variability></metadata><Description>Background control. Recipe card specifies exact topping amounts.</Description></Function><!-- Fn 11: Exit / Passthrough — Quality check --><Function fnStyle="0" orphans="0" profileFn="" profileI="All" profileP="" profileR="" profileC="All" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="900" y="200" agentId="5" levelId="1" isInput="true"><IDNr>11</IDNr><FunctionType>0</FunctionType><IDName>Quality check</IDName><metadata><Burger_Ready active="true" equation="I6_Assembly_Quality">0</Burger_Ready><Q_Standard active="true" equation="C12_Q_Threshold">0</Q_Standard><Passes_Inspection active="true" equation="Burger_Ready&gt;=Q_Standard?1:0">0</Passes_Inspection><Quality_Score active="true" equation="round(Burger_Ready,2)">0</Quality_Score><Variability active="true" equation="round(max(0,1-Quality_Score),2)">0</Variability><Activate active="true" equation="Passes_Inspection==1?&quot;Approved burger|Rejected burger&quot;:&quot;Approved burger&quot;">Approved burger</Activate></metadata><Description>Exit / Passthrough. Burger is checked against quality thresholds. Failing burgers get a rejection output.</Description></Function><!-- Fn 12: Background — Quality threshold (control) --><Function fnStyle="0" orphans="0" profileFn="" profileI="" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="900" y="400" agentId="4" levelId="1" isInput="false" K1="0.05"><IDNr>12</IDNr><FunctionType>2</FunctionType><IDName>Quality threshold</IDName><metadata><Activate active="false" equation="">Quality floor</Activate><Q_Threshold active="true" equation="0.70">0.70</Q_Threshold><Variability active="true" equation="0.05">0.05</Variability></metadata><Description>Background control. Minimum quality threshold for burger acceptance.</Description></Function><!-- Fn 13: Exit — Serve burger --><Function fnStyle="0" orphans="0" profileFn="" profileI="Any" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="1150" y="300" agentId="2" levelId="0" isInput="true"><IDNr>13</IDNr><FunctionType>0</FunctionType><IDName>Serve burger</IDName><metadata><Final_Burger active="true" equation="I11_Quality_Score">0</Final_Burger><Customer_Satisfaction active="true" equation="round(Final_Burger,2)">0</Customer_Satisfaction><Variability active="true" equation="round(1-Customer_Satisfaction,2)">0</Variability><Workload active="true" equation="round(Variability*0.7,2)">0</Workload></metadata><Description>Exit function. Burger handed to customer. Satisfaction depends on quality score.</Description></Function><!-- Fn 14: Exit — Handle rejection --><Function fnStyle="0" orphans="0" profileFn="" profileI="Any" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="1150" y="500" agentId="2" levelId="0" isInput="true"><IDNr>14</IDNr><FunctionType>0</FunctionType><IDName>Handle rejection</IDName><metadata><Rejected active="true" equation="I11_Quality_Score">0</Rejected><Remake_Needed active="true" equation="Rejected&gt;0?1:0">0</Remake_Needed><Variability active="true" equation="1.0">1.0</Variability><Workload active="true" equation="round(Variability,2)">0</Workload></metadata><Description>Exit function. When quality check fails, the burger is rejected and must be remade.</Description></Function><Function fnStyle="0" isInput="false" orphans="0" profileFn="" profileI="" profileP="" profileR="" profileC="" profileT="" groupType="" groupIDNr="" groupActive="" groupX="" groupY="" x="108" y="206"><IDNr>15</IDNr><FunctionType>2</FunctionType><IDName>Turn on Grill</IDName><metadata /><Description /></Function></Functions><Inputs><Input orphan="false"><IDNr>0</IDNr><IDName>Customer order</IDName><FunctionIDNr>3</FunctionIDNr></Input><Input orphan="false"><IDNr>1</IDNr><IDName>Customer order</IDName><FunctionIDN