></Groups><Agents><Agent><IDNr>0</IDNr><Name>Customer</Name><AgentType>Human</AgentType><Description>Places the burger order.</Description></Agent><Agent><IDNr>1</IDNr><Name>Inventory system</Name><AgentType>Organisational</AgentType><Description>Tracks stock of buns, patties, and toppings.</Description></Agent><Agent><IDNr>2</IDNr><Name>Cook</Name><AgentType>Human</AgentType><Description>Grills, toasts, assembles, and plates the burger.</Description></Agent><Agent><IDNr>3</IDNr><Name>Kitchen environment</Name><AgentType>Context</AgentType><Description>Imposes time pressure via cooking durations.</Description></Agent><Agent><IDNr>4</IDNr><Name>SOP / Recipe</Name><AgentType>Organisational</AgentType><Description>Standard operating procedures and specifications.</Description></Agent><Agent><IDNr>5</IDNr><Name>Shift manager</Name><AgentType>Human</AgentType><Description>Performs quality checks before serving.</Description></Agent></Agents><Levels><Level color="#C7E7FF" isActive="true"><IDNr>0</IDNr><Name>Line / Operational</Name><Description>Hands-on burger preparation.</Description><LevelType>Operational</LevelType><Hierarchy>0</Hierarchy><TimeScale>Minutes</TimeScale><DecisionScope>Individual order execution</DecisionScope></Level><Level color="#FFE0A8" isActive="true"><IDNr>1</IDNr><Name>Shift / Tactical</Name><Description>Quality control and procedural governance.</Description><LevelType>Tactical</LevelType><Hierarchy>1</Hierarchy><TimeScale>Shift</TimeScale><DecisionScope>Batch quality and standards compliance</DecisionScope></Level></Levels><FMI><Variables><Variable name="OrderSize" type="number" scope="cycle" initial="0.80" description="Normalised order size from customer" /><Variable name="PattyQuality" type="number" scope="function" function="3" initial="0.90" persist="true" description="Quality of patty being grilled" /><Variable name="BunFreshness" type="number" scope="function" function="4" initial="0.85" persist="true" description="Freshness of bun being toasted" /><Variable name="GrillTime" type="number" scope="cycle" initial="0.65" description="Normalised grill duration" /><Variable name="AssemblyQuality" type="number" scope="function" function="6" initial="0.0" description="Overall assembly quality score" /><Variable name="PassesInspection" type="bool" scope="function" function="11" initial="false" description="Whether burger passes quality check" /><Variable name="CustomerSatisfaction" type="number" scope="function" function="13" initial="0.0" description="Final customer satisfaction score" /><Variable name="Global_Workload" type="number" scope="model" initial="0.15" persist="true" description="Global kitchen workload tracker" /></Variables></FMI></FM>